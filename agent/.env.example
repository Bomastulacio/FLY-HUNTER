# Supabase Config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (Obtener gratis en https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Opciones del navegador (true para producción, false para ver el navegador en acción)
HEADLESS=false
