---
import { supabase } from '../lib/supabase';
---

<div class="search-widget-container card">
  <div class="widget-header">
    <div class="icon-container">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6L3 8l6.5 4.5L6 16l-3.2-1.3c-.4-.1-.8.2-1 .6L1 17l4.5 2.5L8 24l1.7-.8c.4-.2.7-.6.6-1L9 19l3.5-3.5 8.2 6.5c.4.2.8 0 .6-.5z" />
        <circle cx="12" cy="12" r="10" stroke-dasharray="4 4" stroke-opacity="0.5"/>
      </svg>
    </div>
    <div>
      <h2>Personalizá tu radar de vuelos</h2>
      <p>Elegí tu zona favorita y hasta 4 destinos específicos. Te avisamos cuando haya oportunidades de oro.</p>
    </div>
  </div>

  <form id="search-alert-form" class="widget-form">
    <!-- Row 1: Origen y Fechas -->
    <div class="form-group">
      <label>Origen</label>
      <div class="input-wrapper">
        <span class="input-icon">🛫</span>
        <select name="origen" required>
          <option value="EZE,AEP" selected>Buenos Aires (EZE/AEP)</option>
          <option value="COR">Córdoba (COR)</option>
        </select>
      </div>
    </div>
    <div class="form-group" style="grid-column: span 2;">
      <label>Rango de Fecha de Ida</label>
      <div class="dual-input">
        <div class="input-wrapper">
          <span class="input-prefix">Desde</span>
          <input type="date" name="fecha_ida_min" required />
        </div>
        <span class="separator">-</span>
        <div class="input-wrapper">
          <span class="input-prefix">Hasta</span>
          <input type="date" name="fecha_ida_max" required />
        </div>
      </div>
    </div>
    
    <div class="form-group" style="grid-column: span 2;">
      <label>Rango de Fecha de Vuelta</label>
      <div class="dual-input">
        <div class="input-wrapper">
          <span class="input-prefix">Desde</span>
          <input type="date" name="fecha_vuelta_min" required />
        </div>
        <span class="separator">-</span>
        <div class="input-wrapper">
          <span class="input-prefix">Hasta</span>
          <input type="date" name="fecha_vuelta_max" required />
        </div>
      </div>
    </div>

    <!-- Row 2: Zonas -->
    <div class="form-group full-width">
      <label>¿A qué zona del mundo querés viajar?</label>
      <div class="zones-grid" id="zones-container">
        <label class="zone-card active">
          <input type="radio" name="destino" value="Europa" checked>
          <span class="zone-icon">🏰</span>
          <span class="zone-name">Europa</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Norteamérica">
          <span class="zone-icon">🗽</span>
          <span class="zone-name">Norteamérica</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Latinoamérica">
          <span class="zone-icon">⛰️</span>
          <span class="zone-name">Latinoamérica</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Caribe">
          <span class="zone-icon">🏝️</span>
          <span class="zone-name">Caribe</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Asia">
          <span class="zone-icon">⛩️</span>
          <span class="zone-name">Asia</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Oceanía">
          <span class="zone-icon">🦘</span>
          <span class="zone-name">Oceanía</span>
        </label>
        <label class="zone-card">
          <input type="radio" name="destino" value="Cualquiera">
          <span class="zone-icon">🌍</span>
          <span class="zone-name">Cualquier parte</span>
        </label>
      </div>
    </div>

    <!-- Row 3: Destinos Específicos (Dinámico) -->
    <div class="form-group full-width" id="countries-section">
      <label>Destinos específicos (Elegí hasta 4 o dejalo vacío para buscar en toda la zona)</label>
      <div class="countries-grid" id="countries-container">
        <!-- Renderizado dinámico vía JS -->
      </div>
      <small class="hint mt-1" id="countries-counter">0/4 seleccionados</small>
    </div>

    <!-- Row 4: Presupuesto y Escalas -->
    <div class="form-group" style="grid-column: span 2;">
      <label>Presupuesto total (USD)</label>
      <div class="dual-input">
        <div class="input-wrapper">
          <span class="input-prefix">Mín</span>
          <input type="number" name="presupuesto_min" placeholder="800" value="800" />
        </div>
        <span class="separator">-</span>
        <div class="input-wrapper">
          <span class="input-prefix">Máx</span>
          <input type="number" name="presupuesto_max" placeholder="2400" value="2400" required />
        </div>
      </div>
    </div>
    <div class="form-group">
      <label>Escalas máximas</label>
      <div class="radio-pills">
        <label class="pill">
          <input type="radio" name="escalas_max" value="0">
          🚫 0
        </label>
        <label class="pill active">
          <input type="radio" name="escalas_max" value="1" checked>
          ✈️ 1
        </label>
        <label class="pill">
          <input type="radio" name="escalas_max" value="2">
          ⏱️ 2+
        </label>
      </div>
    </div>

    <!-- Row 5: Email Auth (Solo si no está logueado) -->
    <div class="form-group full-width" id="email-auth-section">
      <label>Email para recibir alertas y guardar búsqueda</label>
      <div class="input-wrapper">
        <span class="input-icon">✉️</span>
        <input type="email" name="email" id="user-email" placeholder="tucorreo@ejemplo.com" />
      </div>
      <small class="hint">🔒 Te enviaremos un Link Mágico para guardar tus preferencias de forma segura.</small>
    </div>

    <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      Activar Radar
    </button>
  </form>

  <div id="auth-message" class="auth-message hidden">
    ¡Link enviado! Revisa tu correo para confirmar y guardar tu alerta.
  </div>
</div>

<style>
  .search-widget-container {
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid var(--accent-color);
    box-shadow: 0 0 20px rgba(209, 255, 76, 0.05);
    margin-bottom: 3rem;
    padding: 2rem;
  }
  
  .widget-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .icon-container {
    width: 60px;
    height: 60px;
    background: rgba(209, 255, 76, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
  }
  
  .widget-header h2 {
    margin: 0 0 0.2rem 0;
    font-size: 1.6rem;
  }
  
  .widget-header p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  
  .widget-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .full-width {
    grid-column: span 2;
  }
  
  label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* ZONES GRID */
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.8rem;
  }

  .zone-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-md);
    padding: 1rem 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }

  .zone-card input {
    display: none;
  }

  .zone-card .zone-icon {
    font-size: 1.8rem;
  }

  .zone-card .zone-name {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .zone-card.active {
    background: rgba(209, 255, 76, 0.1);
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  /* COUNTRIES GRID */
  .countries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.6rem;
  }

  .country-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
    text-align: center;
    user-select: none;
  }

  .country-pill input {
    display: none;
  }

  .country-pill.selected {
    background: var(--accent-color);
    color: #000;
    border-color: var(--accent-color);
    font-weight: 600;
  }

  .country-pill.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm);
    transition: all 0.2s ease;
  }
  
  .input-wrapper:focus-within {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 1px var(--accent-color);
  }
  
  .input-icon, .input-prefix {
    padding-left: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  
  select, input[type="text"], input[type="email"], input[type="number"], input[type="date"] {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text-primary);
    padding: 0.8rem 1rem;
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
  }
  
  select option {
    background: var(--bg-base);
    color: var(--text-primary);
  }
  
  .dual-input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .separator {
    color: var(--text-secondary);
  }
  
  .radio-pills {
    display: flex;
    gap: 0.5rem;
    height: 100%;
  }
  
  .pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  
  .pill input {
    display: none;
  }
  
  .pill.active {
    background: rgba(209, 255, 76, 0.1);
    border-color: var(--accent-color);
    color: var(--accent-color);
  }
  
  .hint {
    color: var(--text-secondary);
    font-size: 0.75rem;
  }
  .mt-1 { margin-top: 0.25rem; }
  
  .submit-btn {
    grid-column: span 2;
    padding: 1.2rem;
    font-size: 1.1rem;
    display: flex;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  
  .hidden {
    display: none !important;
  }
  
  .auth-message {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(30, 215, 96, 0.1);
    border: 1px solid var(--success-color);
    color: var(--success-color);
    border-radius: var(--border-radius-sm);
    text-align: center;
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .widget-form {
      grid-template-columns: 1fr;
    }
    .full-width, .submit-btn, .form-group[style] {
      grid-column: span 1 !important;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  
  // MAPEO DE DESTINOS DINÁMICO
  const zoneCountries: Record<string, string[]> = {
    "Europa": ["España", "Francia", "Italia", "Reino Unido", "Alemania", "Portugal", "Países Bajos", "Suiza", "Grecia", "París"],
    "Norteamérica": ["Estados Unidos", "Canadá", "México", "Miami", "Nueva York"],
    "Latinoamérica": ["Brasil", "Chile", "Colombia", "Perú", "Uruguay", "Río de Janeiro"],
    "Caribe": ["República Dominicana", "Cancún", "Cuba", "Costa Rica", "Puerto Rico"],
    "Asia": ["Japón", "Tailandia", "Corea del Sur", "Emiratos Árabes", "Tokio"],
    "Oceanía": ["Australia", "Nueva Zelanda"],
    "Cualquiera": []
  };

  const countriesContainer = document.getElementById('countries-container');
  const countriesSection = document.getElementById('countries-section');
  const countriesCounter = document.getElementById('countries-counter');
  let selectedCountries: string[] = [];

  // Function to render countries based on zone
  function renderCountries(zone: string) {
    selectedCountries = [];
    if (!countriesContainer || !countriesSection || !countriesCounter) return;

    const countries = zoneCountries[zone] || [];
    if (countries.length === 0) {
      countriesSection.classList.add('hidden');
      return;
    }
    
    countriesSection.classList.remove('hidden');
    countriesCounter.innerText = `0/4 seleccionados`;
    
    countriesContainer.innerHTML = countries.map(country => `
      <label class="country-pill">
        <input type="checkbox" name="paises" value="${country}">
        ${country}
      </label>
    `).join('');

    // Add click listeners to new pills
    countriesContainer.querySelectorAll('.country-pill').forEach(pill => {
      pill.addEventListener('click', function(e) {
        e.preventDefault(); // Handle logic manually
        const el = this as HTMLElement;
        const input = el.querySelector('input') as HTMLInputElement;
        const value = input.value;
        
        if (selectedCountries.includes(value)) {
          // Deselect
          selectedCountries = selectedCountries.filter(c => c !== value);
          el.classList.remove('selected');
          input.checked = false;
        } else {
          // Select (only if < 4)
          if (selectedCountries.length < 4) {
            selectedCountries.push(value);
            el.classList.add('selected');
            input.checked = true;
          }
        }
        
        countriesCounter.innerText = `${selectedCountries.length}/4 seleccionados`;
        
        // Update disabled state
        countriesContainer.querySelectorAll('.country-pill').forEach(p => {
          const pEl = p as HTMLElement;
          const pVal = (p.querySelector('input') as HTMLInputElement).value;
          if (selectedCountries.length >= 4 && !selectedCountries.includes(pVal)) {
            pEl.classList.add('disabled');
          } else {
            pEl.classList.remove('disabled');
          }
        });
      });
    });
  }

  // Zone selection logic
  document.querySelectorAll('.zone-card').forEach(el => {
    el.addEventListener('click', function(this: HTMLElement) {
      const parent = this.parentElement;
      if (parent) {
        parent.querySelectorAll('.active').forEach(child => child.classList.remove('active'));
        this.classList.add('active');
        const input = this.querySelector('input') as HTMLInputElement;
        input.checked = true;
        renderCountries(input.value);
      }
    });
  });

  // Basic pills logic (Escalas)
  document.querySelectorAll('.pill').forEach(el => {
    el.addEventListener('click', function(this: HTMLElement) {
      const parent = this.parentElement;
      if (parent) {
        parent.querySelectorAll('.active').forEach(child => child.classList.remove('active'));
        this.classList.add('active');
        const input = this.querySelector('input');
        if (input) input.checked = true;
      }
    });
  });

  // Init Form (Check Auth)
  const form = document.getElementById('search-alert-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const authMessage = document.getElementById('auth-message');
  const emailAuthSection = document.getElementById('email-auth-section');
  const emailInput = document.getElementById('user-email') as HTMLInputElement;
  
  let currentUserId: string | null = null;
  let currentUserEmail: string | null = null;

  window.addEventListener('DOMContentLoaded', async () => {
    // Render initial zone
    renderCountries('Europa');

    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      currentUserId = session.user.id;
      currentUserEmail = session.user.email || null;
      if (emailAuthSection) emailAuthSection.classList.add('hidden');
      if (emailInput) {
        emailInput.value = session.user.email || '';
        emailInput.removeAttribute('required');
      }
    } else {
      if (emailInput) emailInput.setAttribute('required', 'true');
    }
  });

  // Handle Form Submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Procesando...';
    
    const formData = new FormData(form);
    
    // Fallback: If they didn't select any specific countries, put "Cualquiera" so the backend searches the whole zone
    let finalCountries = selectedCountries;
    if (finalCountries.length === 0) {
      finalCountries = ["Cualquiera"];
    }

    const payload = {
      origen: formData.get('origen'),
      destino: formData.get('destino'), // The Zone
      paises: finalCountries,           // Specific targets
      tipo_viaje: 'ida_vuelta',         // Hardcoded for now based on UI simplicity
      fecha_ida_min: formData.get('fecha_ida_min') || null,
      fecha_ida_max: formData.get('fecha_ida_max') || null,
      fecha_vuelta_min: formData.get('fecha_vuelta_min') || null,
      fecha_vuelta_max: formData.get('fecha_vuelta_max') || null,
      presupuesto_min: formData.get('presupuesto_min') ? Number(formData.get('presupuesto_min')) : null,
      presupuesto_max: formData.get('presupuesto_max') ? Number(formData.get('presupuesto_max')) : null,
      escalas_max: Number(formData.get('escalas_max'))
    };
    
    if (!currentUserId) {
      // User is not logged in -> Send Magic Link
      const email = formData.get('email') as string;
      const { error } = await supabase.auth.signInWithOtp({
        email: email,
        options: {
          emailRedirectTo: window.location.origin
        }
      });
      
      if (error) {
        alert('Error enviando enlace: ' + error.message);
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Activar Radar';
        return;
      }
      
      localStorage.setItem('pending_alert_save', JSON.stringify({...payload, email: email}));
      
      form.classList.add('hidden');
      if(authMessage) authMessage.classList.remove('hidden');
    } else {
      // User is logged in -> Save Alert directly
      const finalPayload = { ...payload, user_id: currentUserId, email: currentUserEmail };
      
      const { error } = await supabase
        .from('search_alerts')
        .upsert(finalPayload, { onConflict: 'user_id' }); 
        
      if (error) {
        alert('Error guardando alerta: ' + error.message);
      } else {
        alert('¡Radar activado con éxito!');
        window.location.reload();
      }
      
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Actualizar Radar';
    }
  });

  // Check if returning from Magic Link with pending data
  window.addEventListener('DOMContentLoaded', async () => {
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (event === 'SIGNED_IN' && session) {
        const pending = localStorage.getItem('pending_alert_save');
        if (pending) {
          const data = JSON.parse(pending);
          data.user_id = session.user.id;
          data.email = session.user.email;
          
          await supabase.from('search_alerts').upsert(data, { onConflict: 'user_id' });
          localStorage.removeItem('pending_alert_save');
          
          alert('¡Tu radar ha sido activado exitosamente!');
          window.location.reload();
        }
      }
    });
  });
</script>
