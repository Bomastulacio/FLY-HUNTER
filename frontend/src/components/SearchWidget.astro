      gap: 1rem;
    }
    .budget-inputs {
      flex-direction: column;
      align-items: stretch;
      max-width: 100%;
      gap: 0.8rem;
    }
    .budget-inputs .separator {
      display: none;
    }
    .budget-inputs .input-wrapper {
      width: 100%;
    }
    .dual-input {
      flex-direction: column;
      align-items: stretch;
      gap: 0.8rem;
    }
    .dual-input .separator {
      display: none;
    }
    .countries-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
