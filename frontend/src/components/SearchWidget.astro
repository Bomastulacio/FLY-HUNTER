  :global(.toast.show) {
    transform: translateX(0);
  }
  
  :global(.toast.error) {
    border-color: #ff5555;
  }
  :global(.toast.error .toast-icon) { color: #ff5555; font-weight: bold; }
  :global(.toast.success .toast-icon) { color: var(--accent-color); font-weight: bold; }
  
  @media (max-width: 1024px) {
    .search-widget-wrapper {
      flex-direction: column;
      width: 100%;
      box-sizing: border-box;
    }
    .main-content, .sidebar-content {
