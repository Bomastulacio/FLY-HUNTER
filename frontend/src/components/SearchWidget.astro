    }
    .submit-btn {
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { mountRadarPicker, preferredRadarId } from '../utils/radarPicker';
  
  // WIZARD LOGIC
  let currentStep = 1;
  const totalSteps = 3;
  const progressBar = document.getElementById('wizard-progress-fill');
  const stepText = document.getElementById('current-step-text');
  const stepTitle = document.getElementById('current-step-title');
  const titles = ["Origen y Fechas", "Presupuesto y Pasajeros", "Opciones Avanzadas"];
  
  function showStep(step: number) {
    document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
    document.getElementById('step-' + step)?.classList.remove('hidden');
    
    if (progressBar) progressBar.style.width = ((step / totalSteps) * 100) + '%';
    if (stepText) stepText.innerText = step.toString();
    if (stepTitle) stepTitle.innerText = titles[step - 1];
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      // Basic HTML5 validation before advancing
      const currentStepEl = document.getElementById('step-' + currentStep);
      const inputs = currentStepEl?.querySelectorAll('input[required], select[required]');
      let isValid = true;
      if (inputs) {
        for (let i = 0; i < inputs.length; i++) {
          const input = inputs[i] as HTMLInputElement;
          if (!input.checkValidity()) {
            input.reportValidity();
            isValid = false;
            break;
          }
        }
      }
      
      if (isValid && currentStep < totalSteps) {
        currentStep++;
        showStep(currentStep);
      }
    });
  });

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (currentStep > 1) {
        currentStep--;
        showStep(currentStep);
      }
    });
  });

  // TOAST LOGIC
  function showToast(message: string, type = 'success') {
    let container = document.getElementById('toast-container');
    if (!container) return;
    
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    
    const icon = type === 'success' ? '<i class="ph ph-check"></i>' : '<i class="ph ph-x"></i>';
    toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
    
    container.appendChild(toast);
    
    // Trigger reflow
    void toast.offsetWidth;
    toast.classList.add('show');
    
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  // COUNTDOWN LOGIC
  function updateCountdown() {
    const now = new Date();
    // Definimos la próxima actualización a las 09:00 o 21:00 hs (sistema de 12hs)
    let target = new Date(now);
    
    if (now.getHours() < 9) {
      target.setHours(9, 0, 0, 0);
    } else if (now.getHours() < 21) {
      target.setHours(21, 0, 0, 0);
    } else {
      target.setDate(target.getDate() + 1);
      target.setHours(9, 0, 0, 0);
    }
    
    const diff = target.getTime() - now.getTime();
    
    const h = Math.floor(diff / (1000 * 60 * 60));
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((diff % (1000 * 60)) / 1000);
    
    const hEl = document.getElementById('cd-hours');
    const mEl = document.getElementById('cd-minutes');
    const sEl = document.getElementById('cd-seconds');
    
    if (hEl) hEl.innerText = h.toString().padStart(2, '0');
    if (mEl) mEl.innerText = m.toString().padStart(2, '0');
    if (sEl) sEl.innerText = s.toString().padStart(2, '0');
  }
  
  setInterval(updateCountdown, 1000);
  updateCountdown();

  // LÓGICA DE EXCLUSIÓN DE AEROLÍNEAS
  const AVAILABLE_AIRLINES = [
    "Aerolíneas Argentinas", "Air Canada", "Air Europa", "Air France", 
    "American Airlines", "Avianca", "Azul Linhas Aéreas", "Boliviana de Aviación", 
    "British Airways", "Conviasa", "Copa Airlines", "Delta Air Lines", 
    "EasyJet", "Edelweiss Air", "Emirates", "Flybondi", "GOL", "ITA Airways", 
    "Iberia", "JetSMART", "KLM", "LATAM Airlines", "LEVEL", "Lufthansa", 
    "Plus Ultra Líneas Aéreas", "Qatar Airways", "Ryanair", 
    "SWISS International Air Lines", "Sky Airline", "Surinam Airways", 
    "TAP Air Portugal", "Turkish Airlines", "United Airlines", 
    "Virgin Atlantic", "Vueling", "World2Fly"
  ];
  
  const airlineInput = document.getElementById('airline-exclude-input') as HTMLInputElement;
  const airlineDropdown = document.getElementById('airline-dropdown');
  const excludedAirlinesContainer = document.getElementById('excluded-airlines-container');
  let excludedAirlines: string[] = [];

  function renderAirlineDropdown(filterText: string = '') {
    if (!airlineDropdown) return;
    
    const filtered = AVAILABLE_AIRLINES.filter(a => 
      a.toLowerCase().includes(filterText.toLowerCase()) && 
      !excludedAirlines.includes(a)
    );
    
    if (filtered.length === 0) {
      airlineDropdown.innerHTML = '<div class="autocomplete-item" style="color:var(--text-secondary);pointer-events:none;">No se encontraron resultados</div>';
    } else {
      airlineDropdown.innerHTML = filtered.map(a => 
        `<div class="autocomplete-item" data-value="${a}">${a}</div>`
      ).join('');
      
      airlineDropdown.querySelectorAll('.autocomplete-item').forEach(item => {
        item.addEventListener('click', (e) => {
          const val = (e.target as HTMLElement).getAttribute('data-value');
          if (val) addExcludedAirline(val);
          if (airlineInput) airlineInput.value = '';
          airlineDropdown.classList.add('hidden');
        });
      });
    }
  }

  function addExcludedAirline(airline: string) {
    if (!excludedAirlines.includes(airline)) {
      excludedAirlines.push(airline);
      renderExcludedPills();
    }
  }

  function renderExcludedPills() {
    if (!excludedAirlinesContainer) return;
    
    excludedAirlinesContainer.innerHTML = excludedAirlines.map(a => `
      <div class="excluded-pill" data-value="${a}">
        <span>${a}</span>
        <span class="remove-icon"><i class="ph ph-x"></i></span>
      </div>
    `).join('');
    
    excludedAirlinesContainer.querySelectorAll('.excluded-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const val = (e.currentTarget as HTMLElement).getAttribute('data-value');
        if (val) {
          excludedAirlines = excludedAirlines.filter(a => a !== val);
          renderExcludedPills();
        }
      });
    });
    updateSummary();
  }

  if (airlineInput && airlineDropdown) {
    airlineInput.addEventListener('focus', () => {
      renderAirlineDropdown(airlineInput.value);
      airlineDropdown.classList.remove('hidden');
    });
    
    airlineInput.addEventListener('input', (e) => {
      renderAirlineDropdown((e.target as HTMLInputElement).value);
    });
    
    document.addEventListener('click', (e) => {
      if (!airlineInput.contains(e.target as Node) && !airlineDropdown.contains(e.target as Node)) {
        airlineDropdown.classList.add('hidden');
      }
    });
  }

  // MAPEO DE DESTINOS DINÁMICO
  const zoneCountries: Record<string, string[]> = {
    "Europa": ["España", "Francia", "Italia", "Reino Unido", "Alemania", "Portugal", "Países Bajos", "Suiza", "Grecia", "París"],
    "Norteamérica": ["Estados Unidos", "Canadá", "México", "Miami", "Nueva York"],
    "Latinoamérica": ["Brasil", "Chile", "Colombia", "Perú", "Uruguay", "Río de Janeiro"],
    "Caribe": ["República Dominicana", "Cancún", "Cuba", "Costa Rica", "Puerto Rico"],
    "Asia": ["Japón", "Tailandia", "Corea del Sur", "Emiratos Árabes", "Tokio"],
    "Oceanía": ["Australia", "Nueva Zelanda"],
    "Cualquiera": []
  };

  const countriesContainer = document.getElementById('countries-container');
  const countriesSection = document.getElementById('countries-section');
  const countriesCounter = document.getElementById('countries-counter');
  let selectedCountries: string[] = [];

  function renderCountries(zone: string) {
    selectedCountries = [];
    if (!countriesContainer || !countriesSection || !countriesCounter) return;

    const countries = zoneCountries[zone] || [];
    if (countries.length === 0) {
      countriesSection.classList.add('hidden');
      updateSummary();
      return;
    }
    
    countriesSection.classList.remove('hidden');
    countriesCounter.innerText = `0/4 seleccionados`;
    
    countriesContainer.innerHTML = countries.map(country => `
      <label class="country-pill">
        <input type="checkbox" name="paises" value="${country}">
        ${country}
      </label>
    `).join('');

    countriesContainer.querySelectorAll('.country-pill').forEach(pill => {
      pill.addEventListener('click', function(e) {
        e.preventDefault(); 
        const el = this as HTMLElement;
        const input = el.querySelector('input') as HTMLInputElement;
        const value = input.value;
        
        if (selectedCountries.includes(value)) {
          selectedCountries = selectedCountries.filter(c => c !== value);
          el.classList.remove('selected');
          input.checked = false;
        } else {
          if (selectedCountries.length < 4) {
            selectedCountries.push(value);
            el.classList.add('selected');
            input.checked = true;
          }
        }
        
        countriesCounter.innerText = `${selectedCountries.length}/4 seleccionados`;
        updateSummary();
        
        countriesContainer.querySelectorAll('.country-pill').forEach(p => {
          const pEl = p as HTMLElement;
          const pVal = (p.querySelector('input') as HTMLInputElement).value;
          if (selectedCountries.length >= 4 && !selectedCountries.includes(pVal)) {
            pEl.classList.add('disabled');
          } else {
            pEl.classList.remove('disabled');
          }
        });
      });
    });
    updateSummary();
  }

  // Zone selection logic
  document.querySelectorAll('.zone-card').forEach(el => {
    el.addEventListener('click', function(this: HTMLElement) {
      const parent = this.parentElement;
      if (parent) {
        parent.querySelectorAll('.active').forEach(child => child.classList.remove('active'));
        this.classList.add('active');
        const input = this.querySelector('input') as HTMLInputElement;
        input.checked = true;
        renderCountries(input.value);
        updateSummary();
      }
    });
  });

  // Basic pills logic (Escalas, Pasajeros)
  document.querySelectorAll('.pill').forEach(el => {
    el.addEventListener('click', function(this: HTMLElement) {
      const parent = this.parentElement;
      if (parent) {
        parent.querySelectorAll('.active').forEach(child => child.classList.remove('active'));
        this.classList.add('active');
        const input = this.querySelector('input');
        if (input) input.checked = true;
        updateSummary();
      }
    });
  });

  // DUAL SLIDER LOGIC
  const sliderMin = document.getElementById('slider-min') as HTMLInputElement;
  const sliderMax = document.getElementById('slider-max') as HTMLInputElement;
  const inputMin = document.getElementById('budget-min-input') as HTMLInputElement;
  const inputMax = document.getElementById('budget-max-input') as HTMLInputElement;
  const rangeFill = document.getElementById('range-fill');

  function updateRangeFill() {
    let minVal = parseInt(sliderMin.value);
    let maxVal = parseInt(sliderMax.value);
    
    const percent1 = (minVal / parseInt(sliderMin.max)) * 100;
    const percent2 = (maxVal / parseInt(sliderMax.max)) * 100;
    
    if (rangeFill) {
      rangeFill.style.left = percent1 + '%';
      rangeFill.style.width = (percent2 - percent1) + '%';
    }
  }

  function handleSliderInput(e: Event) {
    let minVal = parseInt(sliderMin.value);
    let maxVal = parseInt(sliderMax.value);
    
    // Prevent crossover
    if (minVal >= maxVal - 100) {
      if (e.target === sliderMin) {
        sliderMin.value = (maxVal - 100).toString();
        minVal = parseInt(sliderMin.value);
      } else {
        sliderMax.value = (minVal + 100).toString();
        maxVal = parseInt(sliderMax.value);
      }
    }
    
    inputMin.value = minVal.toString();
    inputMax.value = maxVal.toString();
    updateRangeFill();
  }

  function handleNumberInput(e: Event) {
    let val = parseInt((e.target as HTMLInputElement).value) || 0;
    if (e.target === inputMin) {
      if (val >= parseInt(inputMax.value)) val = parseInt(inputMax.value) - 100;
      sliderMin.value = val.toString();
      inputMin.value = val.toString(); // enforce limits
    } else {
      if (val <= parseInt(inputMin.value)) val = parseInt(inputMin.value) + 100;
      sliderMax.value = val.toString();
      inputMax.value = val.toString();
    }
    updateRangeFill();
  }

  if (sliderMin && sliderMax && inputMin && inputMax) {
    sliderMin.addEventListener('input', handleSliderInput);
    sliderMax.addEventListener('input', handleSliderInput);
    inputMin.addEventListener('change', handleNumberInput);
    inputMax.addEventListener('change', handleNumberInput);
    updateRangeFill();
  }

  // SUMMARY LIVE PREVIEW IN WIZARD
  const form = document.getElementById('search-alert-form') as HTMLFormElement;
  function updateSummary() {
    if (!form) return;
    const originEl = form.querySelector('select[name="origen"]') as HTMLSelectElement;
    const idaMinEl = form.querySelector('input[name="fecha_ida_min"]') as HTMLInputElement;
    const idaMaxEl = form.querySelector('input[name="fecha_ida_max"]') as HTMLInputElement;
    const vueltaMinEl = form.querySelector('input[name="fecha_vuelta_min"]') as HTMLInputElement;
    const vueltaMaxEl = form.querySelector('input[name="fecha_vuelta_max"]') as HTMLInputElement;
    const zoneEl = form.querySelector('input[name="destino"]:checked') as HTMLInputElement;
    const budget = (form.querySelector('[name="presupuesto_max"]') as HTMLInputElement)?.value;
    const passengers = (form.querySelector('[name="pasajeros"]:checked') as HTMLInputElement)?.value || '1';
    const stops = (form.querySelector('[name="escalas_max"]:checked') as HTMLInputElement)?.value || '0';
    const quick = document.getElementById('summary-quick');
    if (quick) quick.textContent = `${zoneEl?.value || 'Elegí destino'} · ${passengers} adulto${passengers === '1' ? '' : 's'} · Hasta US$${new Intl.NumberFormat('es-AR').format(Number(budget) || 0)}`;
    const preferences = document.getElementById('summary-preferences');
    if (preferences) preferences.textContent = `${stops === '0' ? 'Directo' : `Hasta ${stops} escala${stops === '1' ? '' : 's'}`}${excludedAirlines.length ? ` · Sin ${excludedAirlines.join(', ')}` : ''}`;
    
    if (originEl) {
      const txt = originEl.options[originEl.selectedIndex]?.text || '';
      const sumOrigin = document.getElementById('summary-origin');
      if (sumOrigin) sumOrigin.textContent = txt;
    }
    
    const formatDate = (dStr: string) => {
      if (!dStr) return '';
      try {
        const parts = dStr.split('-');
        const d = new Date(parseInt(parts[0]), parseInt(parts[1])-1, parseInt(parts[2]));
        return new Intl.DateTimeFormat('es-AR', {day: 'numeric', month: 'short', year: 'numeric'}).format(d);
      } catch(e) { return dStr; }
    };
    
    const sumIda = document.getElementById('summary-ida');
    if (sumIda) {
      sumIda.textContent = (idaMinEl?.value && idaMaxEl?.value) ? `${formatDate(idaMinEl.value)} - ${formatDate(idaMaxEl.value)}` : '-';
    }
    
    const sumVuelta = document.getElementById('summary-vuelta');
    if (sumVuelta) {
      sumVuelta.textContent = (vueltaMinEl?.value && vueltaMaxEl?.value) ? `${formatDate(vueltaMinEl.value)} - ${formatDate(vueltaMaxEl.value)}` : '-';
    }
    
    if (zoneEl) {
      const sumZone = document.getElementById('summary-zone');
      if (sumZone) sumZone.textContent = zoneEl.value;
    }
    
    const sumDest = document.getElementById('summary-dest');
    if (sumDest) {
      sumDest.textContent = selectedCountries.length > 0 ? selectedCountries.join(', ') : 'Toda la zona';
    }
  }

  if (form) {
    form.addEventListener('input', updateSummary);
    form.addEventListener('change', updateSummary);
  }

  // DASHBOARD TOGGLE LOGIC
  const radarDashboard = document.getElementById('radar-dashboard');
  const wizardContainer = document.getElementById('wizard-view-container');

  function showDashboardView() {
    if (radarDashboard) radarDashboard.classList.remove('hidden');
    if (wizardContainer) wizardContainer.classList.add('hidden');
    const headerP = document.querySelector('.alertas-header-text p');
    if (headerP) headerP.textContent = 'Tus viajes, en orden. Ajustá solo lo que necesites.';
  }

  function showWizardView(step: number = 1) {
    if (radarDashboard) radarDashboard.classList.add('hidden');
    if (wizardContainer) wizardContainer.classList.remove('hidden');
    wizardContainer?.classList.toggle('is-editing', Boolean(currentEditingAlertId));
    if (currentEditingAlertId) {
      const wizardTitle = document.getElementById('wizard-title');
      const wizardSubtitle = document.getElementById('wizard-subtitle');
      if (wizardTitle) wizardTitle.textContent = `Editar ${titles[step - 1].toLowerCase()}`;
      if (wizardSubtitle) wizardSubtitle.textContent = 'Hacé el cambio y guardá este bloque.';
    } else {
      const wizardSubtitle = document.getElementById('wizard-subtitle');
      if (wizardSubtitle) wizardSubtitle.textContent = 'Elegí tu origen, fechas y destinos. Te avisamos cuando haya oportunidades de oro.';
    }
    const headerP = document.querySelector('.alertas-header-text p');
    if (headerP) headerP.textContent = 'Elegí dónde y cuándo querés viajar.';
    const cancelBtn = document.getElementById('btn-cancel-wizard');
    if (cancelBtn) cancelBtn.style.display = userAlerts.length > 0 ? 'inline-flex' : 'none';
    currentStep = step;
    showStep(step);
  }

  document.querySelectorAll('.edit-step-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const step = parseInt((btn as HTMLElement).dataset.step || '1');
      const currentAlert = userAlerts[activeAlertIndex];
      if (currentAlert) {
        currentEditingAlertId = currentAlert.id;
        populateFormWithAlert(currentAlert);
        submitBtn.innerHTML = 'Guardar Cambios';
        const wizardTitle = document.getElementById('wizard-title');
        if (wizardTitle) wizardTitle.textContent = 'Modificar búsqueda del radar';
      }
      showWizardView(step);
    });
  });

  document.querySelector('.advanced-toggle')?.addEventListener('click', event => {
    const button = event.currentTarget as HTMLButtonElement;
    const expanded = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(expanded));
    document.getElementById('adv-options-content')?.classList.toggle('hidden', !expanded);
  });

  // Init Form & Multi-Alerts State
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const authMessage = document.getElementById('auth-message');
  const emailAuthSection = document.getElementById('email-auth-section');
  const emailInput = document.getElementById('user-email') as HTMLInputElement;
  
  let currentUserId: string | null = null;
  let currentUserEmail: string | null = null;
  let userAlerts: any[] = [];
  let activeAlertIndex = 0;
  let currentEditingAlertId: string | null = null;

  // Renderizador de pestañas/píldoras de búsqueda en el dashboard
  function renderAlertPills() {
    const listEl = document.getElementById('radar-alerts-list');
    if (!listEl) return;
    
    mountRadarPicker(listEl, userAlerts, userAlerts[activeAlertIndex]?.id, currentUserId || '', id => {
      activeAlertIndex = userAlerts.findIndex(a => a.id === id);
      populateDashboardWithAlert(userAlerts[activeAlertIndex]);
    }, (id, newName) => {
      const target = userAlerts.find(a => a.id === id);
      if (target) target.nombre = newName;
      if (userAlerts[activeAlertIndex]?.id === id) {
        populateDashboardWithAlert(userAlerts[activeAlertIndex]);
      }
      showToast(`Radar renombrado a "${newName}"`, 'success');
    });
  }

  function populateDashboardWithAlert(alert: any) {
    if (!alert) return;
    currentEditingAlertId = alert.id;
    const flightsLink = document.getElementById('radar-view-flights') as HTMLAnchorElement | null;
    if (flightsLink) flightsLink.href = `/?radar=${encodeURIComponent(alert.id)}`;
    const menu = document.querySelector<HTMLDetailsElement>('.radar-overflow');
    if (menu) menu.open = false;

    const titleEl = document.getElementById('dash-radar-title');
    if (titleEl) titleEl.textContent = alert.nombre || `Radar ${alert.origen} → ${alert.destino}`;

    const dashOrigin = document.getElementById('dash-origen');
    if (dashOrigin) dashOrigin.textContent = alert.origen || 'EZE/AEP';

    const formatDate = (dStr: string) => {
      if (!dStr) return 'Flexible';
      try {
        const parts = dStr.split('-');
        const d = new Date(parseInt(parts[0]), parseInt(parts[1])-1, parseInt(parts[2]));
        return new Intl.DateTimeFormat('es-AR', {day: 'numeric', month: 'short'}).format(d);
      } catch(e) { return dStr; }
    };

    const dashIda = document.getElementById('dash-ida');
    if (dashIda) dashIda.textContent = (alert.fecha_ida_min && alert.fecha_ida_max) 
      ? `${formatDate(alert.fecha_ida_min)} al ${formatDate(alert.fecha_ida_max)}` 
      : (alert.fecha_ida_min ? formatDate(alert.fecha_ida_min) : 'Flexible');

    const dashVuelta = document.getElementById('dash-vuelta');
    if (dashVuelta) dashVuelta.textContent = (alert.fecha_vuelta_min && alert.fecha_vuelta_max) 
      ? `${formatDate(alert.fecha_vuelta_min)} al ${formatDate(alert.fecha_vuelta_max)}` 
      : (alert.fecha_vuelta_min ? formatDate(alert.fecha_vuelta_min) : 'Flexible');

    const dashZone = document.getElementById('dash-zona');
    if (dashZone) dashZone.textContent = alert.destino || 'Europa';

    const formatCurrency = (val: any) => {
      if (!val) return '0';
      return new Intl.NumberFormat('es-AR').format(Number(val));
    };

    const dashPresupuesto = document.getElementById('dash-presupuesto');
    if (dashPresupuesto) {
      const min = alert.presupuesto_min ? `US$${formatCurrency(alert.presupuesto_min)} - ` : '';
      dashPresupuesto.textContent = `${min}US$${formatCurrency(alert.presupuesto_max)}`;
    }

    const dashPax = document.getElementById('dash-pasajeros');
    if (dashPax) dashPax.textContent = String(alert.pasajeros || 1);

    const dashEscalas = document.getElementById('dash-escalas');
    if (dashEscalas) dashEscalas.textContent = alert.escalas_max === 0 ? 'Vuelo directo' : `Hasta ${alert.escalas_max}`;

    const dashPaises = document.getElementById('dash-paises');
    if (dashPaises) {
      dashPaises.textContent = (alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera'))
        ? alert.paises.join(', ')
        : 'Toda la zona';
    }

    const dashAirlines = document.getElementById('dash-aerolineas');
    if (dashAirlines) {
      dashAirlines.textContent = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0)
        ? alert.aerolineas_excluidas.join(', ')
        : 'Ninguna';
    }
  }

  function populateFormWithAlert(alertData: any) {
    if (!form || !alertData) return;
    
    // Nombre
    const nombreInp = form.querySelector('[name="nombre"]') as HTMLInputElement;
    if (nombreInp) nombreInp.value = alertData.nombre || '';

    // Origen
    const origen = form.querySelector('[name="origen"]') as HTMLSelectElement;
    if (origen) {
      const originValue = String(alertData.origen || 'EZE,AEP').split(',').map(code => code.trim()).join(',');
      // Preserve existing origins even when the current preset list is narrower.
      if (![...origen.options].some(option => option.value === originValue)) {
        const option = document.createElement('option');
        option.value = originValue;
        option.textContent = originValue;
        origen.append(option);
      }
      origen.value = originValue;
    }
    
    // Fechas
    if (alertData.fecha_ida_min) (form.querySelector('[name="fecha_ida_min"]') as HTMLInputElement).value = alertData.fecha_ida_min;
    if (alertData.fecha_ida_max) (form.querySelector('[name="fecha_ida_max"]') as HTMLInputElement).value = alertData.fecha_ida_max;
    if (alertData.fecha_vuelta_min) (form.querySelector('[name="fecha_vuelta_min"]') as HTMLInputElement).value = alertData.fecha_vuelta_min;
    if (alertData.fecha_vuelta_max) (form.querySelector('[name="fecha_vuelta_max"]') as HTMLInputElement).value = alertData.fecha_vuelta_max;
    
    // Zona
    const zoneInput = form.querySelector(`input[name="destino"][value="${alertData.destino}"]`) as HTMLInputElement;
    if (zoneInput) {
      zoneInput.checked = true;
      document.querySelectorAll('.zone-card').forEach(c => c.classList.remove('active'));
      zoneInput.parentElement?.classList.add('active');
      renderCountries(alertData.destino);
    }
    
    // Paises
    selectedCountries = [];
    if (alertData.paises && alertData.paises.length > 0 && !alertData.paises.includes('Cualquiera')) {
        selectedCountries = alertData.paises;
        const pills = document.querySelectorAll('.country-pill input');
        pills.forEach(p => {
          const pVal = (p as HTMLInputElement).value;
          if (selectedCountries.includes(pVal)) {
            (p as HTMLInputElement).checked = true;
            p.parentElement?.classList.add('selected');
          } else {
            (p as HTMLInputElement).checked = false;
            p.parentElement?.classList.remove('selected');
          }
        });
        const counter = document.getElementById('countries-counter');
        if (counter) counter.innerText = `${selectedCountries.length}/4 seleccionados`;
    }
    
    // Aerolíneas excluidas
    excludedAirlines = alertData.aerolineas_excluidas || [];
    renderExcludedPills();
    
    // Presupuesto
    if (alertData.presupuesto_min && inputMin && sliderMin) {
      inputMin.value = alertData.presupuesto_min;
      sliderMin.value = alertData.presupuesto_min;
    }
    if (alertData.presupuesto_max && inputMax && sliderMax) {
      inputMax.value = alertData.presupuesto_max;
      sliderMax.value = alertData.presupuesto_max;
    }
    updateRangeFill();
    
    // Escalas
    const escalas = form.querySelector(`input[name="escalas_max"][value="${alertData.escalas_max}"]`) as HTMLInputElement;
    if (escalas) {
      escalas.checked = true;
      document.querySelectorAll('input[name="escalas_max"]').forEach(c => c.parentElement?.classList.remove('active'));
      escalas.parentElement?.classList.add('active');
    }
    
    // Pasajeros
    const pasajeros = form.querySelector(`input[name="pasajeros"][value="${alertData.pasajeros || 1}"]`) as HTMLInputElement;
    if (pasajeros) {
      pasajeros.checked = true;
      document.querySelectorAll('input[name="pasajeros"]').forEach(inp => {
        (inp as HTMLInputElement).parentElement?.classList.remove('active');
      });
      pasajeros.parentElement?.classList.add('active');
    }

    updateSummary();
  }

  function resetFormToDefaults() {
    if (!form) return;
    form.reset();
    selectedCountries = [];
    excludedAirlines = [];
    renderExcludedPills();
    renderCountries('Europa');
    
    const zoneEuropa = form.querySelector('input[name="destino"][value="Europa"]') as HTMLInputElement;
    if (zoneEuropa) {
      zoneEuropa.checked = true;
      document.querySelectorAll('.zone-card').forEach(c => c.classList.remove('active'));
      zoneEuropa.parentElement?.classList.add('active');
    }
    
    if (inputMin && sliderMin) { inputMin.value = '800'; sliderMin.value = '800'; }
    if (inputMax && sliderMax) { inputMax.value = '2400'; sliderMax.value = '2400'; }
    updateRangeFill();
    
    const counter = document.getElementById('countries-counter');
    if (counter) counter.innerText = '0/4 seleccionados';

    updateSummary();
  }

  let requestedRadarId = new URLSearchParams(window.location.search).get('radar');
  async function loadUserAlerts() {
    if (!currentUserId) return;
    const { data: alertsList, error } = await supabase
      .from('search_alerts')
      .select('*')
      .eq('user_id', currentUserId)
      .order('creado_en', { ascending: false });

    if (!error && alertsList && alertsList.length > 0) {
      const previousId = currentEditingAlertId;
      userAlerts = alertsList;
      activeAlertIndex = Math.max(0, userAlerts.findIndex(a => a.id === (previousId || preferredRadarId(currentUserId))));
      if (requestedRadarId) {
        const requestedIndex = userAlerts.findIndex((alert: any) => alert.id === requestedRadarId);
        if (requestedIndex >= 0) activeAlertIndex = requestedIndex;
        requestedRadarId = null;
      }
      if (activeAlertIndex >= userAlerts.length) activeAlertIndex = 0;
      renderAlertPills();
      populateDashboardWithAlert(userAlerts[activeAlertIndex]);
      showDashboardView();
    } else {
      userAlerts = [];
      currentEditingAlertId = null;
      resetFormToDefaults();
      showWizardView(1);
    }
  }

  // Botón Nueva Búsqueda
  document.getElementById('btn-create-new-radar')?.addEventListener('click', () => {
    currentEditingAlertId = null;
    resetFormToDefaults();
    const wizardTitle = document.getElementById('wizard-title');
    if (wizardTitle) wizardTitle.textContent = 'Crear nueva búsqueda de vuelos';
    submitBtn.innerHTML = 'Activar Nueva Búsqueda';
    showWizardView(1);
  });

  // Botón Modificar Búsqueda Activa (desde cabecera)
  document.getElementById('btn-edit-active-radar')?.addEventListener('click', () => {
    const currentAlert = userAlerts[activeAlertIndex];
    if (currentAlert) {
      currentEditingAlertId = currentAlert.id;
      populateFormWithAlert(currentAlert);
      submitBtn.innerHTML = 'Guardar Cambios';
      const wizardTitle = document.getElementById('wizard-title');
      if (wizardTitle) wizardTitle.textContent = 'Modificar búsqueda del radar';
    }
    showWizardView(1);
  });

  // Botón Cancelar Wizard
  document.getElementById('btn-cancel-wizard')?.addEventListener('click', () => {
    if (userAlerts.length > 0) {
      showDashboardView();
    }
  });

  // Botón Renombrar Búsqueda Rápido
  document.getElementById('btn-quick-rename-radar')?.addEventListener('click', async () => {
    if (!userAlerts[activeAlertIndex]) return;
    const currentAlert = userAlerts[activeAlertIndex];
    const oldName = currentAlert.nombre || currentAlert.destino;
    const newName = prompt('Ingresá el nuevo nombre para este radar:', oldName);
    if (!newName || newName.trim() === '' || newName.trim() === oldName) return;

    const trimmed = newName.trim().slice(0, 45);
    currentAlert.nombre = trimmed;
    populateDashboardWithAlert(currentAlert);
    renderAlertPills();

    const { error } = await supabase
      .from('search_alerts')
      .update({ nombre: trimmed })
      .eq('id', currentAlert.id);

    if (!error) {
      showToast(`Radar renombrado a "${trimmed}"`, 'success');
    } else {
      showToast('Error al renombrar: ' + error.message, 'error');
    }
  });

  // Botón Eliminar Búsqueda
  document.getElementById('btn-delete-radar')?.addEventListener('click', async () => {
    if (!userAlerts[activeAlertIndex]) return;
    const alertToDelete = userAlerts[activeAlertIndex];
    const name = alertToDelete.nombre || `${alertToDelete.origen} → ${alertToDelete.destino}`;
    if (!confirm(`¿Estás seguro de que deseas eliminar la búsqueda "${name}" de tu radar?`)) return;

    const { error } = await supabase.from('search_alerts').delete().eq('id', alertToDelete.id);
    if (error) {
      showToast('Error al eliminar búsqueda: ' + error.message, 'error');
    } else {
      showToast('Búsqueda eliminada correctamente.', 'info');
      activeAlertIndex = 0;
      await loadUserAlerts();
    }
  });

  window.addEventListener('DOMContentLoaded', async () => {
    // Render initial zone
    renderCountries('Europa');

    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      currentUserId = session.user.id;
      currentUserEmail = session.user.email || null;
      if (emailAuthSection) emailAuthSection.classList.add('hidden');
      if (emailInput) {
        emailInput.value = session.user.email || '';
        emailInput.removeAttribute('required');
      }
      
      await loadUserAlerts();
    } else {
      if (emailInput) emailInput.setAttribute('required', 'true');
      showWizardView(1);
    }

    updateSummary();
  });

  // Handle Form Submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const activeSubmit = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    const pendingButton = activeSubmit || submitBtn;
    const pendingButtonHtml = pendingButton.innerHTML;
    pendingButton.disabled = true;
    pendingButton.innerHTML = '<i class="ph ph-spinner-gap" aria-hidden="true"></i> Guardando...';
    
    const formData = new FormData(form);
    
    let finalCountries = selectedCountries;
    if (finalCountries.length === 0) {
      finalCountries = ["Cualquiera"];
    }

    const payload = {
      nombre: formData.get('nombre') || null,
      origen: formData.get('origen'),
      destino: formData.get('destino'), 
      paises: finalCountries,           
      tipo_viaje: 'ida_vuelta',         
      fecha_ida_min: formData.get('fecha_ida_min') || null,
      fecha_ida_max: formData.get('fecha_ida_max') || null,
      fecha_vuelta_min: formData.get('fecha_vuelta_min') || null,
      fecha_vuelta_max: formData.get('fecha_vuelta_max') || null,
      aerolineas_excluidas: excludedAirlines,
      pasajeros: Number(formData.get('pasajeros') || 1),
      presupuesto_min: formData.get('presupuesto_min') ? Number(formData.get('presupuesto_min')) : null,
      presupuesto_max: formData.get('presupuesto_max') ? Number(formData.get('presupuesto_max')) : null,
      escalas_max: Number(formData.get('escalas_max')),
      activo: true
    };
    
    if (!currentUserId) {
      const email = formData.get('email') as string;
      const { error } = await supabase.auth.signInWithOtp({
        email: email,
        options: {
          emailRedirectTo: window.location.origin
        }
      });
      
      if (error) {
        showToast('Error enviando enlace: ' + error.message, 'error');
        pendingButton.disabled = false;
        pendingButton.innerHTML = pendingButtonHtml;
        return;
      }
      
      localStorage.setItem('pending_alert_save', JSON.stringify({...payload, email: email}));
      
      form.classList.add('hidden');
      if(authMessage) authMessage.classList.remove('hidden');
      pendingButton.disabled = false;
      pendingButton.innerHTML = pendingButtonHtml;
    } else {
      const finalPayload = { ...payload, user_id: currentUserId, email: currentUserEmail };
      let error = null;

      if (currentEditingAlertId) {
        // Actualizar búsqueda existente por ID
        const res = await supabase
          .from('search_alerts')
          .update(finalPayload)
          .eq('id', currentEditingAlertId);
        error = res.error;
      } else {
        // Insertar nueva búsqueda
        const res = await supabase
          .from('search_alerts')
          .insert(finalPayload);
        error = res.error;
      }
        
      if (error) {
        showToast('Error guardando alerta: ' + error.message, 'error');
        pendingButton.disabled = false;
        pendingButton.innerHTML = pendingButtonHtml;
      } else {
        showToast(currentEditingAlertId ? 'Radar actualizado.' : 'Nueva búsqueda activada.', 'success');
        await loadUserAlerts();
        pendingButton.disabled = false;
        pendingButton.innerHTML = pendingButtonHtml;
      }
    }
  });

  // Check if returning from Magic Link with pending data
  window.addEventListener('DOMContentLoaded', async () => {
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (event === 'SIGNED_IN' && session) {
        const pending = localStorage.getItem('pending_alert_save');
        if (pending) {
          const data = JSON.parse(pending);
          data.user_id = session.user.id;
          data.email = session.user.email;
          
          await supabase.from('search_alerts').insert(data);
          localStorage.removeItem('pending_alert_save');
          
          showToast('¡Tu radar ha sido activado exitosamente!', 'success');
          await loadUserAlerts();
        }
      }
    });
  });
</script>
