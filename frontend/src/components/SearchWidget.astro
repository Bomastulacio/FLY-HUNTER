---
import { supabase } from '../lib/supabase';
---

<div class="search-widget-wrapper">
  
  <div class="main-content card">
    <!-- DASHBOARD VIEW (Shown if active alert exists) -->
    <div id="radar-dashboard" class="hidden">
      <!-- Selector de Búsquedas / Alertas Múltiples -->
      <div class="radar-manager-bar" id="radar-manager-bar" style="margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;" id="radar-alerts-list">
          <!-- Renderizado dinámico de píldoras cuando hay 2+ búsquedas -->
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-left: auto;">
          <button type="button" id="btn-create-new-radar" class="btn btn-outline" style="padding: 0.45rem 0.95rem; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.45rem; border-color: rgba(159, 219, 22, 0.4); color: var(--accent-color);">
            <i class="ph ph-plus-circle"></i> Nuevo radar
          </button>
        </div>
      </div>

      <div class="radar-status-header">
        <div class="radar-status-copy">
          <span class="radar-schedule-label"><span></span> Radar activo</span>
          <h2 id="dash-radar-title" class="sr-only">Mi radar</h2>
          <p>Consultas a las 09:00 y 21:00 hs</p>
        </div>
        <div class="radar-status-actions">
          <a id="radar-view-flights" class="radar-view-flights" href="/">Ver vuelos <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <details class="radar-overflow">
            <summary aria-label="Más opciones del radar"><i class="ph ph-dots-three" aria-hidden="true"></i></summary>
            <div class="radar-overflow-menu">
              <button type="button" id="btn-quick-rename-radar"><i class="ph ph-tag" aria-hidden="true"></i> Renombrar radar</button>
              <button type="button" id="btn-edit-active-radar"><i class="ph ph-pencil-simple" aria-hidden="true"></i> Modificar radar</button>
              <button type="button" id="btn-delete-radar"><i class="ph ph-trash" aria-hidden="true"></i> Eliminar radar</button>
            </div>
          </details>
        </div>
      </div>

      <div class="radar-summary-card">
         <div class="summary-section">
            <div class="section-header">
              <h3><i class="ph ph-map-pin"></i> Destino y Fechas</h3>
              <button type="button" class="btn btn-icon edit-step-btn" data-step="1" aria-label="Editar destino y fechas"><i class="ph ph-pencil-simple"></i></button>
            </div>
            <div class="section-content">
              <div class="summary-row"><span>Origen</span> <strong id="dash-origen">EZE/AEP</strong></div>
              <div class="summary-row"><span>Ida</span> <strong id="dash-ida">-</strong></div>
              <div class="summary-row"><span>Vuelta</span> <strong id="dash-vuelta">-</strong></div>
              <div class="summary-row"><span>Zona</span> <strong id="dash-zona">Europa</strong></div>
            </div>
         </div>
         
         <div class="summary-section">
            <div class="section-header">
              <h3><i class="ph ph-wallet"></i> Presupuesto y Pasajeros</h3>
              <button type="button" class="btn btn-icon edit-step-btn" data-step="2" aria-label="Editar presupuesto y pasajeros"><i class="ph ph-pencil-simple"></i></button>
            </div>
            <div class="section-content">
              <div class="summary-row"><span>Presupuesto</span> <strong id="dash-presupuesto">US$800 - US$2.400</strong></div>
              <div class="summary-row"><span>Pasajeros</span> <strong id="dash-pasajeros">2</strong></div>
            </div>
         </div>

         <div class="summary-section">
            <div class="section-header">
              <h3><button class="advanced-toggle" type="button" aria-expanded="false" aria-controls="adv-options-content"><i class="ph ph-sliders" aria-hidden="true"></i> Opciones avanzadas <i class="ph ph-caret-down" aria-hidden="true"></i></button></h3>
              <button type="button" class="btn btn-icon edit-step-btn" data-step="3" aria-label="Editar opciones avanzadas"><i class="ph ph-pencil-simple"></i></button>
            </div>
            <div id="adv-options-content" class="section-content hidden">
              <div class="summary-row"><span>Destinos Específicos</span> <strong id="dash-paises">Toda la zona</strong></div>
              <div class="summary-row"><span>Escalas máx.</span> <strong id="dash-escalas">1</strong></div>
              <div class="summary-row"><span>Excluye</span> <strong id="dash-aerolineas">Ninguna</strong></div>
            </div>
         </div>
      </div>
    </div>

    <!-- WIZARD VIEW (Shown if creating or editing) -->
    <div id="wizard-view-container" class="hidden">
      <div class="widget-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
        <div style="display: flex; gap: 1rem; align-items: center;">
          <div style="flex-shrink: 0;">
            <img src="/favicon.svg" alt="FlyHunter" width="56" height="56" style="border-radius: 12px; box-shadow: 0 4px 20px rgba(159, 219, 22, 0.2);" />
          </div>
          <div>
            <h2 id="wizard-title">Personalizá tu radar de vuelos</h2>
            <p id="wizard-subtitle">Elegí tu origen, fechas y destinos. Te avisamos cuando haya oportunidades de oro.</p>
          </div>
        </div>
        <button type="button" id="btn-cancel-wizard" class="btn btn-outline" style="display: none; padding: 0.45rem 0.9rem; font-size: 0.85rem; align-items: center; gap: 0.4rem;">
          <i class="ph ph-arrow-left"></i> Volver
        </button>
        <button type="submit" form="search-alert-form" class="btn btn-primary quick-save quick-save-top">
          <i class="ph ph-check" aria-hidden="true"></i> Guardar
        </button>
      </div>

    <form id="search-alert-form" class="widget-form">
      <!-- WIZARD PROGRESS -->
      <div class="wizard-progress">
        <div class="progress-bar"><div class="progress-fill" id="wizard-progress-fill" style="width: 33%"></div></div>
        <div class="progress-text">Paso <span id="current-step-text">1</span> de 3: <span id="current-step-title">Origen y Fechas</span></div>
      </div>

      <details class="wizard-live-preview">
        <summary><span id="summary-quick">Tu búsqueda</span><i class="ph ph-caret-down" aria-hidden="true"></i></summary>
        <dl>
          <div><dt>Origen</dt><dd id="summary-origin"></dd></div>
          <div><dt>Zona</dt><dd id="summary-zone"></dd></div>
          <div><dt>Ida</dt><dd id="summary-ida"></dd></div>
          <div><dt>Vuelta</dt><dd id="summary-vuelta"></dd></div>
          <div><dt>Destinos</dt><dd id="summary-dest"></dd></div>
          <div><dt>Preferencias</dt><dd id="summary-preferences"></dd></div>
        </dl>
        <p>Vista previa · los cambios se aplican al guardar.</p>
      </details>

      <!-- STEP 1: Origen, Fechas, Zona -->
      <div class="wizard-step" id="step-1">
        <div class="form-group full-width">
          <label>Nombre de esta búsqueda (opcional)</label>
          <div class="input-wrapper">
            <span class="input-icon"><i class="ph ph-tag"></i></span>
            <input type="text" name="nombre" placeholder="Ej: Europa Vacaciones, Asia Trabajo, Miami..." maxlength="45" />
          </div>
        </div>

        <div class="form-group full-width">
          <label>Origen</label>
          <div class="input-wrapper">
            <span class="input-icon"><i class="ph ph-airplane-takeoff"></i></span>
            <select name="origen" required>
              <option value="EZE,AEP" selected>Buenos Aires (EZE/AEP)</option>
              <option value="COR">Córdoba (COR)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Rango de fecha de ida</label>
          <div class="dual-input">
            <div class="input-wrapper">
              <span class="input-prefix">Desde</span>
              <input type="date" name="fecha_ida_min" aria-label="Fecha de ida desde" required />
            </div>
            <span class="separator">-</span>
            <div class="input-wrapper">
              <span class="input-prefix">Hasta</span>
              <input type="date" name="fecha_ida_max" aria-label="Fecha de ida hasta" required />
            </div>
          </div>
          <small class="hint"><i class="ph ph-check" style="color: var(--success-color);"></i> Flexibilidad en la ida: Buscamos combinaciones ideales.</small>
        </div>
        
        <div class="form-group">
          <label>Rango de fecha de vuelta</label>
          <div class="dual-input">
            <div class="input-wrapper">
              <span class="input-prefix">Desde</span>
              <input type="date" name="fecha_vuelta_min" aria-label="Fecha de vuelta desde" required />
            </div>
            <span class="separator">-</span>
            <div class="input-wrapper">
              <span class="input-prefix">Hasta</span>
              <input type="date" name="fecha_vuelta_max" aria-label="Fecha de vuelta hasta" required />
            </div>
          </div>
          <small class="hint"><i class="ph ph-check" style="color: var(--success-color);"></i> Flexibilidad en la vuelta.</small>
        </div>

        <div class="form-group full-width">
          <label>¿A qué zona del mundo querés viajar?</label>
          <div class="zones-grid" id="zones-container">
            <label class="zone-card active">
              <input type="radio" name="destino" value="Europa" checked>
              <span class="zone-icon"><i class="ph ph-castle-turret"></i></span>
              <span class="zone-name">Europa</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Norteamérica">
              <span class="zone-icon"><i class="ph ph-buildings"></i></span>
              <span class="zone-name">Norteamérica</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Latinoamérica">
              <span class="zone-icon"><i class="ph ph-mountains"></i></span>
              <span class="zone-name">Latinoamérica</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Caribe">
              <span class="zone-icon"><i class="ph ph-palm-tree"></i></span>
              <span class="zone-name">Caribe</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Asia">
              <span class="zone-icon"><i class="ph ph-globe-hemisphere-east"></i></span>
              <span class="zone-name">Asia</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Oceanía">
              <span class="zone-icon"><i class="ph ph-compass"></i></span>
              <span class="zone-name">Oceanía</span>
            </label>
            <label class="zone-card">
              <input type="radio" name="destino" value="Cualquiera">
              <span class="zone-icon"><i class="ph ph-globe-hemisphere-west"></i></span>
              <span class="zone-name">Cualquier parte</span>
            </label>
          </div>
        </div>

        <div class="wizard-actions">
          <button type="button" class="btn btn-primary btn-next" data-step="1">
            Siguiente Paso <i class="ph ph-arrow-right" style="margin-left: 8px;"></i>
          </button>
        </div>
      </div>

      <!-- STEP 2: Presupuesto y Pasajeros -->
      <div class="wizard-step hidden" id="step-2">
        <div class="form-group full-width budget-section">
          <label>Presupuesto objetivo (USD)</label>
          <div class="budget-inputs">
            <div class="input-wrapper">
              <span class="input-prefix">Mín.</span>
              <input type="number" name="presupuesto_min" aria-label="Presupuesto mínimo en dólares" id="budget-min-input" value="800" />
            </div>
            <span class="separator">-</span>
            <div class="input-wrapper">
              <span class="input-prefix">Máx.</span>
              <input type="number" name="presupuesto_max" aria-label="Presupuesto máximo en dólares" id="budget-max-input" value="2400" required />
            </div>
          </div>
          
          <div class="range-slider">
            <span class="range-track"></span>
            <span class="range-fill" id="range-fill"></span>
            <input type="range" min="0" max="5000" value="800" id="slider-min">
            <input type="range" min="0" max="5000" value="2400" id="slider-max">
            <div class="slider-labels">
              <span>0</span>
              <span>5000+</span>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Pasajeros (Para el presupuesto)</label>
          <div class="radio-pills">
            <label class="pill active">
              <input type="radio" name="pasajeros" value="1" checked>
              <i class="ph ph-user"></i> 1
            </label>
            <label class="pill">
              <input type="radio" name="pasajeros" value="2">
              <i class="ph ph-users"></i> 2
            </label>
          </div>
        </div>

        <div class="wizard-actions dual">
          <button type="button" class="btn btn-outline btn-prev" data-step="2">
            <i class="ph ph-arrow-left" style="margin-right: 8px;"></i> Anterior
          </button>
          <button type="button" class="btn btn-primary btn-next" data-step="2">
            Opciones Avanzadas <i class="ph ph-arrow-right" style="margin-left: 8px;"></i>
          </button>
        </div>
      </div>

      <!-- STEP 3: Opciones Avanzadas -->
      <div class="wizard-step hidden" id="step-3">
        <div class="form-group full-width" id="countries-section">
          <label>Destinos específicos (hasta 4)</label>
          <small class="hint" style="margin-top:-0.3rem; margin-bottom:0.5rem; display:block;">Elegí destinos puntuales dentro de la zona seleccionada (opcional)</small>
          <div class="countries-grid" id="countries-container">
            <!-- Renderizado dinámico vía JS -->
          </div>
          <small class="hint mt-1" id="countries-counter">0/4 seleccionados</small>
        </div>

        <div class="form-group full-width" id="airlines-section">
          <label>Aerolíneas a excluir (Opcional)</label>
          <div class="input-wrapper autocomplete-wrapper">
            <span class="input-icon"><i class="ph ph-prohibit"></i></span>
            <input type="text" id="airline-exclude-input" placeholder="Ej. Iberia, Ryanair..." autocomplete="off" />
            <div class="autocomplete-dropdown hidden" id="airline-dropdown">
              <!-- Renderizado dinámico vía JS -->
            </div>
          </div>
          <div class="excluded-airlines-grid mt-1" id="excluded-airlines-container">
            <!-- Renderizado dinámico de pills -->
          </div>
        </div>

        <div class="form-group">
          <label>Escalas máximas</label>
          <div class="radio-pills">
            <label class="pill">
              <input type="radio" name="escalas_max" value="0">
              <i class="ph ph-prohibit"></i> 0
            </label>
            <label class="pill active">
              <input type="radio" name="escalas_max" value="1" checked>
              <i class="ph ph-airplane"></i> 1
            </label>
            <label class="pill">
              <input type="radio" name="escalas_max" value="2">
              <i class="ph ph-clock"></i> 2+
            </label>
          </div>
        </div>

        <div class="wizard-actions dual">
          <button type="button" class="btn btn-outline btn-prev" data-step="3">
            <i class="ph ph-arrow-left" style="margin-right: 8px;"></i> Anterior
          </button>
          <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
            Guardar Radar <i class="ph ph-check-circle" style="margin-left: 8px;"></i>
          </button>
        </div>
      </div>
    </form>
    </div> <!-- End Wizard View Container -->

    <div id="auth-message" class="auth-message hidden">
      ¡Link enviado! Revisa tu correo para confirmar y guardar tu alerta.
    </div>
  </div>

  <aside class="sidebar-content">
    <div class="promo-card card">
      <div class="promo-icon"><i class="ph-fill ph-sparkle"></i></div>
      <div class="promo-content">
        <h3>Buscamos por vos</h3>
        <p>Nuestro Agente Estratega monitorea precios y te alerta cuando encuentra oportunidades increíbles.</p>
        
        <div class="countdown-container mt-1">
          <span class="countdown-label">Próxima búsqueda en:</span>
          <div class="countdown-timer" id="next-search-timer">
            <div class="time-box"><span id="cd-hours">00</span><small>H</small></div>:
            <div class="time-box"><span id="cd-minutes">00</span><small>M</small></div>:
            <div class="time-box"><span id="cd-seconds">00</span><small>S</small></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="activity-log-card card" style="margin-top: 0; padding: 1.8rem; background: rgba(255,255,255,0.02);">
      <h3 style="font-size: 0.9rem; color: var(--text-secondary); margin-top:0; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 1px; display:flex; align-items:center; gap:0.5rem;"><i class="ph ph-list-dashes"></i> Bitácora del Agente</h3>
      <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.85rem; color: var(--text-primary); display: flex; flex-direction: column; gap: 1.2rem;">
        <li style="display: flex; gap: 0.8rem; align-items: flex-start;">
          <i class="ph-fill ph-check-circle" style="color: var(--success-color); font-size: 1.2rem; margin-top: 2px;"></i>
          <div><strong>Aprobación pendiente</strong><br><span style="color: var(--text-secondary); font-size: 0.75rem;">Anomalía en EZE-NRT detectada hace 14h.</span></div>
        </li>
        <li style="display: flex; gap: 0.8rem; align-items: flex-start;">
          <i class="ph-fill ph-x-circle" style="color: var(--danger-color); font-size: 1.2rem; margin-top: 2px;"></i>
          <div><strong>Oportunidad descartada</strong><br><span style="color: var(--text-secondary); font-size: 0.75rem;">EZE-MAD por US$ 600 tenía 3 escalas.</span></div>
        </li>
        <li style="display: flex; gap: 0.8rem; align-items: flex-start;">
          <i class="ph-fill ph-clock" style="color: var(--accent-color); font-size: 1.2rem; margin-top: 2px;"></i>
          <div><strong>Analizando posibles rutas...</strong><br><span style="color: var(--text-secondary); font-size: 0.75rem;">Calculando combinaciones de fechas.</span></div>
        </li>
      </ul>
    </div>
  </aside>

  <div id="toast-container" class="toast-container"></div>
</div>

<style>
  .search-widget-wrapper {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 3rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }
  
  .main-content {
    flex: 1.6;
    min-width: 0;
    box-sizing: border-box;
  }

  .sidebar-content {
    flex: 1.1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 2rem;
    box-sizing: border-box;
    min-width: 0;
  }

  .card {
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
    padding: 2.5rem;
    border-radius: 1.5rem;
  }

  .sidebar-content .card {
    padding: 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* SIDEBAR STYLES */
  .summary-title {
    display: flex;
    align-items: center;
    font-size: 1.1rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .summary-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .summary-item {
    display: grid;
    grid-template-columns: 24px 80px 1fr;
    align-items: center;
    font-size: 0.9rem;
  }

  .summary-item .icon {
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .summary-item .label {
    color: var(--text-secondary);
  }

  .summary-item .value {
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
  }

  .promo-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .promo-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .promo-content h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    color: var(--accent-color);
  }

  .promo-content p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* COUNTDOWN */
  .countdown-container {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  
  .countdown-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .countdown-timer {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-primary);
    font-weight: bold;
    font-size: 1.2rem;
  }
  
  .time-box {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    padding: 2px 6px;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  
  .time-box small {
    font-size: 0.65rem;
    color: var(--text-secondary);
    font-weight: normal;
  }

  /* FORM STYLES */
  .widget-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2.5rem;
  }
  
  .icon-container {
    width: 50px;
    height: 50px;
    background: rgba(209, 255, 76, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    flex-shrink: 0;
  }
  
  .widget-header h2 {
    margin: 0 0 0.3rem 0;
    font-size: 1.4rem;
  }
  
  .widget-header p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  
  .widget-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .wizard-step {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  
  .wizard-actions {
    grid-column: 1 / -1;
  }
  
  .radar-summary-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  
  @media (max-width: 900px) {
    .wizard-step {
      grid-template-columns: 1fr;
    }
    .search-widget-wrapper {
      flex-direction: column;
    }
  }
  
