                <span style="font-size: 1.5rem;">📡</span>
                <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Radar en espera</span>
              </div>
            )}
          </div>

          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">🇩🇪 Alemania</div>
            {germanyDeal ? (
              <>
                <div class="card-route">{germanyDeal.ida_origen_destino}</div>
                <div class="card-date">🗓 {formatDate(germanyDeal.ida_fecha)} al {formatDate(germanyDeal.vuelta_fecha)}</div>
                <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">{formatPrice(germanyDeal)}</div>
                {germanyDeal.link_reserva && <a href={germanyDeal.link_reserva} target="_blank" class="btn btn-primary" style="width: 100%; box-sizing: border-box;">Ver Vuelo</a>}
              </>
            ) : (
              <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; gap: 0.5rem; padding: 1rem 0;">
                <span style="font-size: 1.5rem;">📡</span>
                <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Radar en espera</span>
              </div>
            )}
          </div>
        </div>

        <!-- Lufthansa Card -->
        <div class="card lufthansa-card">
          <div class="card-header" style="color: #f9a01b; border-color: rgba(249, 160, 27, 0.3);">🦅 Lufthansa Tracking</div>
          {lufthansaDeal ? (
            <>
              <div class="card-route">{lufthansaDeal.ida_origen_destino} <span style="opacity: 0.5; margin: 0 4px;">✈</span> {lufthansaDeal.vuelta_origen_destino}</div>
              <div class="card-date">🗓 {formatDate(lufthansaDeal.ida_fecha)} al {formatDate(lufthansaDeal.vuelta_fecha)}</div>
              <div class="card-price">{formatPrice(lufthansaDeal)}</div>
              {lufthansaDeal.link_reserva && <a href={lufthansaDeal.link_reserva} target="_blank" class="btn btn-outline" style="align-self: flex-start; color: #f9a01b; border-color: rgba(249, 160, 27, 0.4);">Ver Vuelo</a>}
            </>
          ) : (
             <span style="color: var(--text-secondary); margin: auto; font-weight: 500;">Sin ofertas destacadas de Lufthansa</span>
          )}
        </div>

        <!-- Asia Section -->
        <div class="card asia-section">
          <div class="card-header">⛩️ Monitoreo Japón</div>
          <div style="display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 0.5rem; scroll-snap-type: x mandatory;">
             {asiaDeals.length > 0 ? asiaDeals.slice(0, 4).map(deal => (
               <div style="min-width: 220px; padding: 1.25rem; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; scroll-snap-align: start;">
                  <div class="card-route" style="font-size: 1.2rem;">{deal.ida_origen_destino}</div>
                  <div class="card-price" style="font-size: 1.8rem; margin: 0.2rem 0;">{formatPrice(deal)}</div>
                  <div class="card-date" style="margin-bottom: 1rem; font-size: 0.85rem;">🗓 {formatDate(deal.ida_fecha)} al {formatDate(deal.vuelta_fecha)}</div>
