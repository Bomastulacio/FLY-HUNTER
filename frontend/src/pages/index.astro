---
import { supabase } from '../lib/supabase';
import '../styles/global.css';
import '../styles/compact.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);

const { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .gte('created_at', yesterday.toISOString())
  .order('precio_total_usd', { ascending: true });

const { data: insightsData } = await supabase.from('route_insights').select('*');
const routeInsights = insightsData || [];

// Procesar datos para enviarlos completos al cliente
const allDeals = deals || [];
const approvedDeals = allDeals.filter(d => d.estado_aprobacion === 'aprobado' || (d.es_oportunidad_oro && !['pendiente', 'rechazado'].includes(d.estado_aprobacion)));
const pendingDeals = allDeals.filter(d => d.estado_aprobacion === 'pendiente' || (d.es_anomalia && d.estado_aprobacion !== 'rechazado' && d.estado_aprobacion !== 'aprobado'));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flight Hunter - Mi Radar</title>
    
    <!-- PWA Config -->
    <meta name="theme-color" content="#141419" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FlyHunter" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body class="compact-app">
    <!-- Auth Guard Loader -->
    <div id="auth-loader" style="position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem; animation: pulse 1.5s infinite;"><i class="ph ph-airplane-tilt"></i></div>
      <h3 style="color: var(--text-secondary); font-weight: normal;">Conectando al radar...</h3>
    </div>

    <!-- 3D Animated Background -->
    <div class="bg-3d-scene">
      <div class="radar-circles">
        <div class="circle c1"></div>
        <div class="circle c2"></div>
        <div class="circle c3"></div>
        <div class="circle c4"></div>
      </div>
      <div class="horizon-line"></div>
    </div>
    
    <main>
      <!-- Top Navigation -->
      <nav class="top-nav">
        <a href="/" class="top-nav-logo">
          <img src="/favicon.svg" alt="Fly Hunter Logo" width="32" height="32" style="border-radius: 8px;" />
          <span class="nav-logo-text">Flight Hunter</span>
        </a>
        <div class="top-nav-actions" id="desktop-user-actions">
          <a href="/alertas" class="btn btn-outline nav-alertas-btn desktop-only" title="Mis Alertas" aria-label="Mis Alertas">
            <i class="ph ph-sliders"></i>
            <span class="nav-alertas-text">Mis Alertas</span>
          </a>
          <a href="/login" id="nav-login-btn" class="btn btn-outline" style="display: none; padding: 0.4rem 1rem; margin-top: 0;"><i class="ph ph-key" style="margin-right: 0.5rem;"></i> Ingresar</a>
          
          <div id="user-profile-dropdown" class="profile-dropdown" style="display: none;">
            <button class="profile-btn" aria-label="Cuenta de usuario">
              <span class="avatar-badge" id="user-avatar-badge">U</span>
              <span class="user-email-label" id="user-email-display">usuario</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-content">
              <div id="dropdown-user-info" class="dropdown-user-header">usuario</div>
              <a href="/alertas"><i class="ph ph-sliders" style="margin-right: 0.5rem;"></i> Mis Alertas</a>
              <div class="dropdown-divider"></div>
              <a href="#" id="btn-logout" class="danger"><i class="ph ph-sign-out" style="margin-right: 0.5rem;"></i> Cerrar Sesión</a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Hero -->
      <header id="main-hero">
        <h1>Encontramos las mejores tarifas desde Buenos Aires.</h1>
        <p id="hero-subtitle">Configura tu radar para empezar a recibir alertas.</p>
      </header>

      <!-- Radar Tabs Nav (Selector de alertas múltiples) -->
      <div id="radar-tabs-nav" class="radar-tabs-nav" style="display: none;"></div>

      <!-- CONTENEDOR DINÁMICO DEL RADAR (Dashboard Responsive) -->
      <div id="dynamic-dashboard" class="dashboard-layout" style="display: none;">
        
        <aside class="dashboard-sidebar" aria-label="Tu búsqueda">
          <details class="radar-overview">
            <summary>
              <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
              <span class="radar-summary-copy" id="radar-summary-text">Cargando búsqueda...</span>
              <span class="radar-edit-label">Filtros <i class="ph ph-caret-down" aria-hidden="true"></i></span>
            </summary>
            <div class="radar-overview-content">
              <div class="desktop-radar-body" id="desktop-radar-details"></div>
              <a href="/alertas" class="radar-config-link" id="radar-config-link"><i class="ph ph-pencil-simple" aria-hidden="true"></i> Editar esta búsqueda</a>
            </div>
          </details>
          <div id="countdown-strip-container" class="countdown-strip">
            <span class="countdown-strip-label">Próxima búsqueda estimada · <strong id="cd-target-dest">Europa</strong></span>
            <span class="countdown-strip-timer"><i class="ph ph-clock" aria-hidden="true"></i> <span id="compact-cd-val">Calculando...</span></span>
          </div>
        </aside>
        <div class="feed-toolbar">
          <h1>Tus vuelos</h1>
          <div class="feed-filters" role="group" aria-label="Mostrar vuelos">
            <button type="button" data-feed-filter="all" aria-pressed="true">Todos</button>
            <button type="button" data-feed-filter="saved" aria-pressed="false"><i class="ph ph-bookmark-simple" aria-hidden="true"></i> Guardados</button>
          </div>
        </div>
        <p class="saved-note" id="saved-note" hidden>Guardados en este navegador. Se muestran las ofertas vigentes de esta búsqueda.</p>
        <!-- Feed Principal Columna Derecha (Desktop: ancho consistente; Mobile: debajo de sidebar) -->
        <section class="dashboard-feed" id="destinations-grid">
           <!-- Renderizado por JS: Card destacada + Destinos -->
        </section>

      </div>
      
      <!-- EMPTY STATE (Sin Alerta) -->
      <div id="empty-state" style="display: none; text-align: center; margin: 4rem 0;">
        <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--text-secondary);"><i class="ph ph-broadcast"></i></div>
        <h2>Todavía no tenés una búsqueda</h2>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">Elegí destino, fechas y presupuesto. Te mostramos las opciones que encontramos.</p>
        <a href="/alertas" class="btn btn-primary">Configurar mi búsqueda</a>
      </div>

    </main>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container" role="status" aria-live="polite" aria-atomic="false"></div>

    <!-- Pasar datos del servidor al cliente -->
    <script is:inline define:vars={{ allDeals, approvedDeals, pendingDeals, routeInsights }}>
      window.__SERVER_DATA__ = { allDeals, approvedDeals, pendingDeals, routeInsights };
    </script>

    <script>
      import { supabase } from '../lib/supabase';
      import { renderCompactFlight, escapeHtml, usd } from '../utils/compactFlights';

      const formatPrice = (deal: any) => {
        const price = deal.precio_original || deal.precio_total_usd;
        const currency = deal.moneda_original || 'USD';
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
      };

      const formatDate = (dateStr: string) => {
        if (!dateStr) return '';
        const [y, m, d] = dateStr.split('-');
        const date = new Date(Number(y), Number(m) - 1, Number(d));
        return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
      };

      // Mapeo básico de países a códigos IATA para filtrar los vuelos del servidor
      const countryCodes: Record<string, string[]> = {
        "España": ["MAD", "BCN", "AGP", "VLC"],
        "Francia": ["CDG", "ORY", "NCE", "MRS"],
        "Italia": ["FCO", "MXP", "LIN", "NAP"],
        "Reino Unido": ["LHR", "LGW", "MAN", "EDI"],
        "Alemania": ["FRA", "MUC", "BER", "DUS"],
        "Portugal": ["LIS", "OPO"],
        "Países Bajos": ["AMS"],
        "Suiza": ["ZRH", "GVA"],
        "Grecia": ["ATH", "JMK"],
        "París": ["CDG", "ORY"],
        "Estados Unidos": ["JFK", "MIA", "LAX", "ORD", "SFO"],
        "Canadá": ["YYZ", "YVR", "YUL"],
        "México": ["MEX", "CUN", "GDL"],
        "Miami": ["MIA", "FLL"],
        "Nueva York": ["JFK", "LGA", "EWR"],
        "Brasil": ["GRU", "GIG", "BSB", "REC"],
        "Chile": ["SCL"],
        "Colombia": ["BOG", "MDE", "CTG"],
        "Perú": ["LIM", "CUZ"],
        "Uruguay": ["MVD"],
        "Río de Janeiro": ["GIG", "SDU"],
        "República Dominicana": ["PUJ", "SDQ"],
        "Cancún": ["CUN"],
        "Cuba": ["HAV"],
        "Costa Rica": ["SJO"],
        "Puerto Rico": ["SJU"],
        "Japón": ["NRT", "HND", "KIX"],
        "Tokio": ["NRT", "HND"],
        "Tailandia": ["BKK", "HKT"],
        "Corea del Sur": ["ICN"],
        "Emiratos Árabes": ["DXB"],
        "Australia": ["SYD", "MEL", "BNE"],
        "Nueva Zelanda": ["AKL"],
      };

      const countryIsoCodes: Record<string, string> = {
        "España": "ES",
        "Francia": "FR",
        "Italia": "IT",
        "Reino Unido": "GB",
        "Alemania": "DE",
        "Portugal": "PT",
        "Países Bajos": "NL",
        "Suiza": "CH",
        "Grecia": "GR",
        "París": "FR",
        "Estados Unidos": "US",
        "Canadá": "CA",
        "México": "MX",
        "Miami": "US",
        "Nueva York": "US",
        "Brasil": "BR",
        "Chile": "CL",
        "Colombia": "CO",
        "Perú": "PE",
        "Uruguay": "UY",
        "Río de Janeiro": "BR",
        "República Dominicana": "DO",
        "Cancún": "MX",
        "Cuba": "CU",
        "Costa Rica": "CR",
        "Puerto Rico": "PR",
        "Japón": "JP",
        "Tokio": "JP",
        "Tailandia": "TH",
        "Corea del Sur": "KR",
        "Emiratos Árabes": "AE",
        "Australia": "AU",
        "Nueva Zelanda": "NZ"
      };

      // @ts-ignore
      const allDeals = window.__SERVER_DATA__.approvedDeals || [];
      let cdInterval: any;
      
      const renderDashboard = (alert: any) => {
        const dash = document.getElementById('dynamic-dashboard');
        if (dash) {
          dash.style.display = '';
          dash.classList.add('is-active');
        }
        
        
        const mainHero = document.getElementById('main-hero');
        if (mainHero) mainHero.style.display = 'none';

        const origRaw = alert.origen || "EZE";
        const orig = origRaw.split(',').map((s: string) => s.trim()).join(', ');
        const dest = alert.destino || "Europa";
        const fechasCompactas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
          ? `${formatDate(alert.fecha_ida_min)} - ${formatDate(alert.fecha_vuelta_max)}`
          : "";

        const exclCompactas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
          ? `sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
          : "";


        const summaryTextEl = document.getElementById('radar-summary-text');
        if (summaryTextEl) {
          summaryTextEl.innerHTML = `<strong>${escapeHtml(orig)} → ${escapeHtml(dest)}</strong><small>${escapeHtml(fechasCompactas || 'Fechas flexibles')} · Hasta ${usd(alert.presupuesto_max)}</small>`;
        }
        const configLink = document.getElementById('radar-config-link') as HTMLAnchorElement;
        if (configLink) configLink.href = `/alertas?radar=${encodeURIComponent(alert.id)}`;
        // Full preferences are available on demand, on every screen size.
        const desktopDetailsEl = document.getElementById('desktop-radar-details');
        if (desktopDetailsEl) {
          const fechasLargas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
            ? `${formatDate(alert.fecha_ida_min)} al ${formatDate(alert.fecha_vuelta_max)}`
            : "Fechas flexibles";
          const escalasLargas = alert.escalas_max === 0 ? "Vuelo directo" : `Hasta ${alert.escalas_max} escala${alert.escalas_max > 1 ? 's' : ''}`;
          const exclLargas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
            ? `Sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
            : "Todas las aerolíneas";
          const presupLargo = `Hasta ${usd(alert.presupuesto_max)}`;
          const pax = Number(alert.pasajeros) || 2;
          const paxText = pax === 1 ? "1 pasajero" : `${pax} pasajeros`;

          desktopDetailsEl.innerHTML = `
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-airplane-takeoff"></i> Ruta</div>
              <div class="radar-detail-value">${orig} → ${dest}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-calendar-blank"></i> Fechas</div>
              <div class="radar-detail-value">${fechasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-tag"></i> Presupuesto máx.</div>
              <div class="radar-detail-value highlight-price">${presupLargo}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-git-branch"></i> Escalas</div>
              <div class="radar-detail-value">${escalasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-prohibit"></i> Restricciones</div>
              <div class="radar-detail-value">${exclLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-users"></i> Pasajeros</div>
              <div class="radar-detail-value">${paxText}</div>
            </div>
          `;
        }

        // 3. Countdown logic para actualización del scraper
        if(cdInterval) clearInterval(cdInterval);
        
        const updateCountdown = () => {
          const now = new Date();
          let target = new Date(now);
          if (now.getHours() < 9) {
            target.setHours(9, 0, 0, 0);
          } else if (now.getHours() < 21) {
            target.setHours(21, 0, 0, 0);
          } else {
            target.setDate(target.getDate() + 1);
            target.setHours(9, 0, 0, 0);
          }
          const distance = target.getTime() - now.getTime();
          
          const timerVal = document.getElementById('compact-cd-val');
          if (!timerVal) return;
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

          
          timerVal.innerText = `${hours.toString().padStart(2, '0')}h ${mins.toString().padStart(2, '0')}m`;
        };
        cdInterval = setInterval(updateCountdown, 1000);

        // 4. Feed de Vuelos y Destinos
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        
        let html = '';

        const cdDest = document.getElementById('cd-target-dest');
        if (cdDest) cdDest.innerText = alert.destino;

        // Filtramos TODOS los vuelos para que solo queden los que cumplen con el presupuesto y escalas
        const affordableDeals = allDeals.filter((d: any) => 
          d.precio_total_usd <= alert.presupuesto_max && 
          d.cantidad_escalas <= alert.escalas_max
        );
        
        // Helper para renderizar la sección completa de Anomalías Pendientes
        const renderAnomaliesHTML = (currentAlert: any) => {
          // @ts-ignore
          const pending = (window.__SERVER_DATA__.pendingDeals || []).filter((d: any) => d.estado_aprobacion === 'pendiente');
          if (!pending || pending.length === 0) return '';

          let sectionHtml = `
            <details class="anomalies-section" id="anomalies-section">
              <summary class="compact-review-summary"><i class="ph ph-warning-circle" aria-hidden="true"></i> Para revisar <span id="anomalies-count">${pending.length}</span><i class="ph ph-caret-down" aria-hidden="true"></i></summary>
              <div class="anomalies-list">
          `;

          pending.forEach((pDeal: any) => {
            // Analizar regla rota
            let brokenRule = 'Desvío de parámetros estándar del radar';
            const maxStops = Number(currentAlert?.escalas_max ?? 1);
            const budgetMax = Number(currentAlert?.presupuesto_max ?? 2400);

            if (pDeal.cantidad_escalas > maxStops) {
              brokenRule = `${pDeal.cantidad_escalas} escalas (tu radar permite hasta ${maxStops} escala${maxStops === 1 ? '' : 's'})`;
            } else if (pDeal.precio_total_usd > budgetMax) {
              brokenRule = `Supera el presupuesto configurado de US$ ${budgetMax} (total: US$ ${pDeal.precio_total_usd})`;
            } else if (pDeal.ida_fecha && currentAlert?.fecha_ida_min && pDeal.ida_fecha < currentAlert.fecha_ida_min) {
              brokenRule = `Sale antes de tu fecha mínima programada (${formatDate(pDeal.ida_fecha)})`;
            } else if (pDeal.vuelta_fecha && currentAlert?.fecha_vuelta_max && pDeal.vuelta_fecha > currentAlert.fecha_vuelta_max) {
              brokenRule = `Regresa posterior a tu fecha máxima programada (${formatDate(pDeal.vuelta_fecha)})`;
            }

            // Criterio IA (por qué la marcó como interesante)
            let agentReason = `Oferta marcada para revisión por el radar. Verificá las condiciones antes de aprobarla.`;

            // Enlace de reserva / inspección
            const routeParts = (pDeal.ida_origen_destino || 'EZE-BCN').split('-');
            const origin = (routeParts[0] || 'EZE').trim().toUpperCase();
            const dest = (routeParts[1] || 'BCN').trim().toUpperCase();
            const passengers = Number(currentAlert?.pasajeros) || 2;
            const paxText = passengers === 1 ? '1 adult' : `${passengers} adults`;
            const inspectUrl = pDeal.link_reserva || `https://www.google.com/travel/flights?q=Flights%20to%20${dest}%20from%20${origin}%20on%20${pDeal.ida_fecha}%20through%20${pDeal.vuelta_fecha}%20for%20${encodeURIComponent(paxText)}&curr=USD&hl=es`;

            sectionHtml += `
              <div class="anomaly-card" id="anomaly-card-${pDeal.id}">
                <div class="anomaly-top-row">
                  <span class="anomaly-tag">
                    <i class="ph-fill ph-warning"></i>
                    <span>Anomalía en Radar</span>
                  </span>
                  <div class="anomaly-price-block">
                    <div class="anomaly-price-value">${formatPrice(pDeal)}</div>
                    <div class="anomaly-price-caption">Total para ${passengers} pasajero${passengers > 1 ? 's' : ''}</div>
                  </div>
                </div>

                <div class="anomaly-flight-info">
                  <div class="anomaly-route-title">
                    <span>${pDeal.ida_origen_destino}</span>
                    <i class="ph ph-airplane-tilt" style="opacity: 0.5; font-size: 1.1rem;"></i>
                    <span>${pDeal.vuelta_origen_destino || ''}</span>
                  </div>
                  <div class="anomaly-details-row">
                    <span><i class="ph ph-calendar-blank"></i> ${formatDate(pDeal.ida_fecha)} al ${formatDate(pDeal.vuelta_fecha)}</span>
                    <span><i class="ph ph-airplane"></i> ${pDeal.aerolinea || 'Aerolínea'}</span>
                    <span style="color: #f59e0b; font-weight: 600;"><i class="ph ph-git-branch"></i> ${pDeal.cantidad_escalas} escala${pDeal.cantidad_escalas === 1 ? '' : 's'}</span>
                  </div>
                </div>

                <div class="anomaly-insights-box">
                  <div class="insight-item">
                    <span class="insight-label broken"><i class="ph-fill ph-x-circle"></i> Regla que rompió:</span>
                    <span class="insight-text">${brokenRule}</span>
                  </div>
                  <div class="insight-item">
                    <span class="insight-label agent"><i class="ph-fill ph-sparkle"></i> Criterio de la IA:</span>
                    <span class="insight-text">${agentReason}</span>
                  </div>
                </div>

                <div class="anomaly-actions">
                  <a href="${inspectUrl}" target="_blank" rel="noopener noreferrer" class="btn-anomaly-inspect" title="Ver detalles y verificar fechas/escalas en vivo">
                    <i class="ph ph-arrow-square-out"></i> Inspeccionar
                  </a>
                  <div class="anomaly-actions-right">
                    <button type="button" class="btn-anomaly-discard" onclick="window.handleAnomalyAction('${pDeal.id}', 'rechazar', this)">
                      <i class="ph ph-trash"></i> Descartar
                    </button>
                    <button type="button" class="btn-anomaly-approve" onclick="window.handleAnomalyAction('${pDeal.id}', 'aprobar', this)">
                      <i class="ph-fill ph-check-circle"></i> Aprobar Oferta
                    </button>
                  </div>
                </div>
              </div>
            `;
          });

          sectionHtml += `
              </div>
            </details>
          `;

          return sectionHtml;
        };

        // 1. Sección de Anomalías Pendientes
        html += renderAnomaliesHTML(alert);

        const renderFlightCard = (deal: any, currentAlert: any, isMain = false, countryName = '') =>
          renderCompactFlight(deal, currentAlert, isMain, countryName, savedFlights.has(String(deal.id)));

        // 1. Tarjeta Principal (Vuelo más barato o destacado)
        const mainDeal = affordableDeals.length > 0 ? affordableDeals[0] : null;
        let mainDealCountry = '';
        if (mainDeal) {
          for (const [cName, codes] of Object.entries(countryCodes)) {
            if (codes.some(code => mainDeal.ida_origen_destino.includes(code))) {
              mainDealCountry = cName;
              break;
            }
          }
          html += renderFlightCard(mainDeal, alert, true, mainDealCountry);
        } else {
          html += `
            <div class="card main-deal" style="text-align: left; padding: 1.25rem;">
              <p style="color: var(--text-secondary); margin: 0; font-size: 1rem;">No encontramos vuelos que cumplan con tu presupuesto de ${usd(alert.presupuesto_max)} y filtros actuales.</p>
            </div>
          `;
        }

        // Otros destinos: separar los que tienen oferta de los que siguen buscando
        let countriesWithDeals: any[] = [];
        let countriesSearching: any[] = [];

        // Priorizamos los países que el usuario eligió explícitamente
        let explicitCountries = (alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera')) 
            ? [...alert.paises] 
            : ['España', 'Reino Unido', 'Francia', 'Alemania'];
            
        let countriesToRender = [...explicitCountries];
        
        Object.keys(countryCodes).forEach(country => {
            const hasDeal = affordableDeals.some((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
            if (hasDeal && !countriesToRender.includes(country)) {
                countriesToRender.push(country);
            }
        });

        countriesToRender.forEach((country: string) => {
          let destDeal = null;
          if (countryCodes[country]) {
            destDeal = affordableDeals.find((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
          }

          const isDuplicateOfMain = mainDeal && destDeal && (
            destDeal.id === mainDeal.id || 
            (destDeal.ida_origen_destino === mainDeal.ida_origen_destino && destDeal.ida_fecha === mainDeal.ida_fecha && destDeal.precio_total_usd === mainDeal.precio_total_usd)
          );

          if (isDuplicateOfMain) {
            return;
          }

          if (destDeal && !countriesWithDeals.some(item => item.deal.id === destDeal.id)) {
            countriesWithDeals.push({ country, deal: destDeal });
          } else if (!destDeal) {
            countriesSearching.push({ country });
          }
        });

        countriesWithDeals.sort((a, b) => a.deal.precio_total_usd - b.deal.precio_total_usd);

        // Países con ofertas encontradas (renderizados con el nuevo layout completo)
        if (countriesWithDeals.length > 0) {
          countriesWithDeals.forEach(({ country, deal }) => {
            html += renderFlightCard(deal, alert, false, country);
          });
        }

        if (countriesSearching.length > 0) {
          html += `<details class="compact-searching"><summary>${countriesSearching.length} destinos sin ofertas en tus filtros</summary><p>${countriesSearching.map(({ country }) => escapeHtml(country)).join(' · ')}. Volvemos a revisar en la próxima búsqueda.</p></details>`;
        }
        grid.innerHTML = html;
        applySavedFilter();
        updateCountdown();
      };

      const initDashboard = async () => {
        // Handle OAuth Redirect processing if needed
        if (window.location.hash.includes('access_token')) {
          supabase.auth.onAuthStateChange(async (event) => {
            if (event === 'SIGNED_IN') {
              window.location.hash = ''; // Limpiar la URL visualmente
              await loadUserData();
            }
          });
        } else {
          await loadUserData();
        }
      };

      const loadUserData = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        const loader = document.getElementById('auth-loader');
        if (loader) loader.style.display = 'none';

        if (session) {
          savedStorageKey = `fh_saved_flights_v1:${session.user.id}`;
          try {
            const stored = JSON.parse(localStorage.getItem(savedStorageKey) || '[]');
            savedFlights = new Set(Array.isArray(stored) ? stored.filter((id: unknown) => typeof id === 'string').slice(-500) : []);
          } catch { savedFlights = new Set(); }
          // Actualizar UI para usuario logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if (loginBtn) loginBtn.style.display = 'none';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if (profileDropdown) profileDropdown.style.display = 'inline-block';
          
          const emailDisplay = document.getElementById('user-email-display');
          const username = session.user.email?.split('@')[0] || 'Usuario';
          if (emailDisplay) emailDisplay.innerText = username;

          const avatarBadge = document.getElementById('user-avatar-badge');
          if (avatarBadge && session.user) {
            const metadata = session.user.user_metadata || {};
            const avatarUrl = metadata.avatar_url || metadata.picture;
            
            if (avatarUrl) {
              avatarBadge.innerText = ''; // Quitar inicial
              avatarBadge.style.backgroundImage = `url('${avatarUrl}')`;
              avatarBadge.style.backgroundSize = 'cover';
              avatarBadge.style.backgroundPosition = 'center';
              avatarBadge.style.color = 'transparent'; // Por si acaso
              avatarBadge.style.border = '1px solid rgba(255,255,255,0.2)';
            } else if (session.user.email) {
              avatarBadge.innerText = session.user.email.charAt(0).toUpperCase();
            }
          }

          const dropdownUserInfo = document.getElementById('dropdown-user-info');
          if (dropdownUserInfo && session.user.email) {
            dropdownUserInfo.innerText = session.user.email;
          }

          // Escuchar logout
          const logoutBtn = document.getElementById('btn-logout');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              await supabase.auth.signOut();
              window.location.reload();
            });
          }

          // Lógica del Dropdown para Mobile (click toggle)
          const profileBtn = profileDropdown?.querySelector('.profile-btn');
          if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              profileDropdown.classList.toggle('active');
            });
            document.addEventListener('click', (e) => {
              if (!profileDropdown.contains(e.target)) {
                profileDropdown.classList.remove('active');
              }
            });
          }

          // Traemos todas las alertas configuradas del usuario
          const { data: alertsList } = await supabase
            .from('search_alerts')
            .select('*')
            .eq('user_id', session.user.id)
            .order('creado_en', { ascending: false });
            
          if (alertsList && alertsList.length > 0) {
            userAlerts = alertsList;
            activeAlertIndex = 0;
            // @ts-ignore
            window.currentActiveAlert = userAlerts[0];
            renderRadarTabs(userAlerts);
            renderDashboard(userAlerts[0]);
          } else {
            // Logueado pero sin alertas
            const empty = document.getElementById('empty-state');
            if(empty) empty.style.display = 'block';
          }
        } else {
          // No logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if(loginBtn) loginBtn.style.display = 'inline-block';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if(profileDropdown) profileDropdown.style.display = 'none';
          
          const empty = document.getElementById('empty-state');
          if(empty) empty.style.display = 'block';
        }
      };

      // Toast Notifications Helper
      const showToast = (message: string, type = 'success') => {
        let container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        const icon = type === 'success' ? '<i class="ph ph-check"></i>' : '<i class="ph ph-x"></i>';
        toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
        container.appendChild(toast);
        void toast.offsetWidth;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 350);
        }, 4000);
      };

      // Bookmarks are scoped to the signed-in user and this browser.
      let savedFlights = new Set<string>();
      let savedStorageKey = '';
      let feedFilter = 'all';
      const applySavedFilter = () => {
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        grid.querySelector('.saved-empty')?.remove();
        let visible = 0;
        grid.querySelectorAll<HTMLElement>('.flight-item').forEach(card => {
          card.hidden = feedFilter === 'saved' && !savedFlights.has(card.dataset.flightId || '');
          if (!card.hidden) visible++;
        });
        grid.querySelectorAll<HTMLElement>(':scope > :not(.flight-item)').forEach(el => { el.hidden = feedFilter === 'saved'; });
        if (feedFilter === 'saved' && !visible) {
          const empty = document.createElement('p');
          empty.className = 'feed-empty saved-empty';
          empty.textContent = 'No tenés vuelos guardados vigentes en esta búsqueda. Tocá el marcador de una oferta para tenerla a mano.';
          grid.append(empty);
        }
        const note = document.getElementById('saved-note');
        if (note) note.hidden = feedFilter !== 'saved';
        document.querySelectorAll<HTMLButtonElement>('[data-feed-filter]').forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.feedFilter === feedFilter));
        });
      };
      document.querySelectorAll<HTMLButtonElement>('[data-feed-filter]').forEach(btn => {
        btn.addEventListener('click', () => { feedFilter = btn.dataset.feedFilter || 'all'; applySavedFilter(); });
      });
      document.getElementById('destinations-grid')?.addEventListener('click', event => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-save-id]');
        if (!button || !savedStorageKey) return;
        const id = button.dataset.saveId!;
        const next = new Set(savedFlights);
        const saving = !next.has(id);
        if (saving) next.add(id); else next.delete(id);
        try {
          localStorage.setItem(savedStorageKey, JSON.stringify([...next].slice(-500)));
          savedFlights = next;
          button.setAttribute('aria-pressed', String(saving));
          button.setAttribute('aria-label', saving ? 'Quitar de guardados' : 'Guardar vuelo');
          button.title = saving ? 'Quitar de guardados' : 'Guardar en este navegador';
          const icon = button.querySelector('i');
          if (icon) icon.className = saving ? 'ph-fill ph-bookmark-simple' : 'ph ph-bookmark-simple';
          showToast(saving ? 'Vuelo guardado en este navegador.' : 'Vuelo quitado de guardados.');
          applySavedFilter();
          if (feedFilter === 'saved' && !saving) document.querySelector<HTMLButtonElement>('[data-feed-filter="saved"]')?.focus();
        } catch {
          showToast('No pudimos guardar en este navegador. Revisá el almacenamiento disponible.', 'error');
        }
      });
      document.getElementById('destinations-grid')?.addEventListener('toggle', event => {
        const opened = event.target;
        if (!(opened instanceof HTMLDetailsElement) || !opened.classList.contains('flight-disclosure') || !opened.open) return;
        document.querySelectorAll<HTMLDetailsElement>('.flight-disclosure[open]').forEach(item => {
          if (item !== opened) item.open = false;
        });
      }, true);

      // Multi-Alerts Tabs Navigator
      let userAlerts: any[] = [];
      let activeAlertIndex = 0;

      const renderRadarTabs = (alerts: any[]) => {
        const tabsNav = document.getElementById('radar-tabs-nav');
        if (!tabsNav) return;

        if (!alerts || alerts.length === 0) {
          tabsNav.style.display = 'none';
          return;
        }

        tabsNav.style.display = 'flex';
        
        tabsNav.innerHTML = `<label class="radar-select-label">Tu búsqueda<select class="radar-select" aria-label="Elegir búsqueda"></select></label><a class="radar-manage" href="/alertas"><i class="ph ph-sliders" aria-hidden="true"></i> Mis Alertas</a>`;
        const select = tabsNav.querySelector('select')!;
        alerts.forEach((a, idx) => {
          const option = document.createElement('option');
          option.value = String(idx);
          option.textContent = a.nombre || `${a.origen || 'EZE'} → ${a.destino || 'Europa'}`;
          option.selected = idx === activeAlertIndex;
          select.append(option);
        });
        select.addEventListener('change', () => {
          activeAlertIndex = Number(select.value);
          // @ts-ignore
          window.currentActiveAlert = userAlerts[activeAlertIndex];
          renderDashboard(userAlerts[activeAlertIndex]);
        });
      };

      // Manejador de acciones para Anomalías (Aprobar / Descartar)
      // @ts-ignore
      window.handleAnomalyAction = async (dealId: string, action: 'aprobar' | 'rechazar', btn: HTMLElement) => {
        const card = document.getElementById(`anomaly-card-${dealId}`);
        const originalHtml = btn.innerHTML;
        btn.setAttribute('disabled', 'true');
        btn.innerHTML = `<i class="ph ph-spinner-gap" style="animation: spin 1s linear infinite;"></i> Procesando...`;

        try {
          const { data: { session } } = await supabase.auth.getSession();
          const headers: Record<string, string> = { 'Content-Type': 'application/json' };
          if (session?.access_token) {
            headers['Authorization'] = `Bearer ${session.access_token}`;
          }

          const res = await fetch('/api/anomaly-action', {
            method: 'POST',
            headers,
            body: JSON.stringify({ deal_id: dealId, action })
          });
          const result = await res.json();

          if (result.success) {
            showToast(result.message, 'success');
            if (card) {
              card.classList.add('anomaly-dismissing');
              setTimeout(() => {
                card.remove();
                const countEl = document.getElementById('anomalies-count');
                const sectionEl = document.getElementById('anomalies-section');
                const remaining = document.querySelectorAll('.anomaly-card');
                if (countEl) countEl.innerText = `${remaining.length}`;
                if (remaining.length === 0 && sectionEl) {
                  sectionEl.style.display = 'none';
                }
              }, 450);
            }

            // Actualizar el estado de deals en memoria sin recargar la página
            // @ts-ignore
            const pendingList = window.__SERVER_DATA__.pendingDeals || [];
            const idx = pendingList.findIndex((d: any) => d.id === dealId);
            if (idx !== -1) {
              const deal = pendingList.splice(idx, 1)[0];
              if (action === 'aprobar') {
                deal.estado_aprobacion = 'aprobado';
                // @ts-ignore
                if (!window.__SERVER_DATA__.approvedDeals) window.__SERVER_DATA__.approvedDeals = [];
                // @ts-ignore
                window.__SERVER_DATA__.approvedDeals.push(deal);
                // Re-render feed con el deal recién aprobado para el usuario
                // @ts-ignore
                if (window.currentActiveAlert) {
                  // @ts-ignore
                  setTimeout(() => renderDashboard(window.currentActiveAlert), 500);
                }
              }
            }
          } else {
            showToast('Error: ' + (result.error || 'No se pudo procesar'), 'error');
            btn.removeAttribute('disabled');
            btn.innerHTML = originalHtml;
          }
        } catch (err: any) {
          showToast('Error de comunicación con el servidor', 'error');
          btn.removeAttribute('disabled');
          btn.innerHTML = originalHtml;
        }
      };

      // Iniciar cuando el DOM esté listo
      window.addEventListener('DOMContentLoaded', initDashboard);
    </script>
  </body>
</html>
