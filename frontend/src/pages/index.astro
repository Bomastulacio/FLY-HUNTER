            <span id="cd-hours" style="font-size: 2.5rem; color: var(--text-primary); text-shadow: 0 0 15px var(--accent-glow);">00</span>
            <span style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px;">Horas</span>
          </div>
