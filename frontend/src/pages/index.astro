            <h3 id="pulse-activity-title" style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.65rem 0; color: #fff;">Revisando combinaciones</h3>

            <ol class="fh-stages" aria-label="Etapas de la búsqueda">
