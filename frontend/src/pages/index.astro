---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

// Obtener datos de Supabase
const { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .order('precio_total_usd', { ascending: true });

// Procesar datos para el grid
const allDeals = deals || [];
const approvedDeals = allDeals.filter(d => d.estado_aprobacion === 'aprobado' || d.es_oportunidad_oro);
const pendingAnomalies = allDeals.filter(d => d.estado_aprobacion === 'pendiente');

const mainDeal = approvedDeals.length > 0 ? approvedDeals[0] : null;

// Encontrar mejores por destino
const getBestForDest = (dest: string) => approvedDeals.find(d => d.ida_origen_destino.includes(dest));
const spainDeal = getBestForDest('MAD');
const franceDeal = getBestForDest('PAR');
const ukDeal = getBestForDest('LON');
const lufthansaDeal = approvedDeals.find(d => d.aerolinea.toLowerCase().includes('lufthansa'));

// Asia
const asiaDeals = approvedDeals.filter(d => d.ida_origen_destino.includes('NRT') || d.ida_origen_destino.includes('KIX'));

// Formateador de moneda
const formatPrice = (deal: any) => {
  const price = deal.precio_original || deal.precio_total_usd;
  const currency = deal.moneda_original || 'USD';
  return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
};

// Formateador de fechas (ej: "2027-04-19" -> "19 abr")
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const [y, m, d] = dateStr.split('-');
  const date = new Date(Number(y), Number(m) - 1, Number(d));
  return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Flight Hunter - Ofertas de Vuelos</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Flight Hunter</h1>
        <p>Buscando las mejores tarifas desde Buenos Aires.</p>
      </header>

      <!-- Pendientes de Aprobación -->
      {pendingAnomalies.length > 0 && (
        <div class="anomalies-section card" style="margin-bottom: 2rem;">
          <div class="card-header" style="color: var(--danger-color); border-color: rgba(255, 76, 76, 0.3);">❓ Anomalías Pendientes</div>
          {pendingAnomalies.map(anomalia => (
            <div class="anomaly-item">
              <div>
                <strong style="font-size: 1.1rem; letter-spacing: -0.02em;">{anomalia.ida_origen_destino} a {anomalia.vuelta_origen_destino}</strong>
                <span style="color: var(--accent-color); font-weight: bold; font-size: 1.1rem; margin-left: 1rem; text-shadow: 0 0 10px var(--accent-glow);">{formatPrice(anomalia)}</span>
                <span style="font-size: 0.8rem; color: var(--text-secondary); margin-left: 0.5rem;">(~${anomalia.precio_total_usd} USD)</span>
                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;">Fechas: {formatDate(anomalia.ida_fecha)} al {formatDate(anomalia.vuelta_fecha)}</div>
              </div>
              <div class="anomaly-actions">
                <button class="btn btn-approve" data-id={anomalia.id} data-action="aprobado">Aprobar</button>
                <button class="btn btn-reject" data-id={anomalia.id} data-action="rechazado">Rechazar</button>
              </div>
            </div>
          ))}
        </div>
      )}

      <div class="bento-grid">
        <!-- Deal Principal -->
        <div class="card main-deal">
          <div class="card-header">🔥 Vuelo Más Barato Absoluto</div>
          {mainDeal ? (
            <>
              <div class="card-route">{mainDeal.ida_origen_destino} <span style="opacity: 0.5; margin: 0 4px;">✈</span> {mainDeal.vuelta_origen_destino}</div>
              <div class="card-date">🗓 {formatDate(mainDeal.ida_fecha)} al {formatDate(mainDeal.vuelta_fecha)}</div>
              <div style="color: var(--text-secondary); margin-top: 0.5rem; font-weight: 500;">{mainDeal.aerolinea} • {mainDeal.cantidad_escalas} escalas</div>
              <div class="card-price">{formatPrice(mainDeal)}</div>
              <div style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 500;">(Aprox. ${mainDeal.precio_total_usd} USD)</div>
              {mainDeal.link_reserva && <a href={mainDeal.link_reserva} target="_blank" class="btn btn-primary" style="align-self: flex-start; margin-top: 1.5rem;">Reserva en Google Flights</a>}
            </>
          ) : (
            <div style="margin: auto; color: var(--text-secondary); font-weight: 500;">No hay ofertas disponibles</div>
          )}
        </div>

        <!-- Destinos Europa -->
        <div class="europe-destinations">
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">🇪🇸 España</div>
            {spainDeal ? (
              <>
                <div class="card-route">{spainDeal.ida_origen_destino}</div>
                <div class="card-date">🗓 {formatDate(spainDeal.ida_fecha)}</div>
                <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">{formatPrice(spainDeal)}</div>
                {spainDeal.link_reserva && <a href={spainDeal.link_reserva} target="_blank" class="btn btn-primary" style="width: 100%; box-sizing: border-box;">Ver Vuelo</a>}
              </>
            ) : (
              <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; gap: 0.5rem; padding: 1rem 0;">
                <span style="font-size: 1.5rem;">📡</span>
                <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Radar en espera</span>
              </div>
            )}
          </div>
          
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">🇫🇷 Francia</div>
            {franceDeal ? (
              <>
                <div class="card-route">{franceDeal.ida_origen_destino}</div>
                <div class="card-date">🗓 {formatDate(franceDeal.ida_fecha)}</div>
                <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">{formatPrice(franceDeal)}</div>
                {franceDeal.link_reserva && <a href={franceDeal.link_reserva} target="_blank" class="btn btn-primary" style="width: 100%; box-sizing: border-box;">Ver Vuelo</a>}
              </>
            ) : (
              <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; gap: 0.5rem; padding: 1rem 0;">
                <span style="font-size: 1.5rem;">📡</span>
                <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Radar en espera</span>
              </div>
            )}
          </div>
          
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">🇬🇧 Reino Unido</div>
            {ukDeal ? (
              <>
                <div class="card-route">{ukDeal.ida_origen_destino}</div>
                <div class="card-date">🗓 {formatDate(ukDeal.ida_fecha)}</div>
                <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">{formatPrice(ukDeal)}</div>
                {ukDeal.link_reserva && <a href={ukDeal.link_reserva} target="_blank" class="btn btn-primary" style="width: 100%; box-sizing: border-box;">Ver Vuelo</a>}
              </>
            ) : (
              <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; gap: 0.5rem; padding: 1rem 0;">
                <span style="font-size: 1.5rem;">📡</span>
                <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Radar en espera</span>
              </div>
            )}
          </div>
        </div>

        <!-- Lufthansa Card -->
        <div class="card lufthansa-card">
          <div class="card-header" style="color: #f9a01b; border-color: rgba(249, 160, 27, 0.3);">🦅 Lufthansa Tracking</div>
          {lufthansaDeal ? (
            <>
              <div class="card-route">{lufthansaDeal.ida_origen_destino} <span style="opacity: 0.5; margin: 0 4px;">✈</span> {lufthansaDeal.vuelta_origen_destino}</div>
              <div class="card-date">🗓 {formatDate(lufthansaDeal.ida_fecha)}</div>
              <div class="card-price">{formatPrice(lufthansaDeal)}</div>
              {lufthansaDeal.link_reserva && <a href={lufthansaDeal.link_reserva} target="_blank" class="btn btn-outline" style="align-self: flex-start; color: #f9a01b; border-color: rgba(249, 160, 27, 0.4);">Ver Vuelo</a>}
            </>
          ) : (
             <span style="color: var(--text-secondary); margin: auto; font-weight: 500;">Sin ofertas destacadas de Lufthansa</span>
          )}
        </div>

        <!-- Asia Section -->
        <div class="card asia-section">
          <div class="card-header">⛩️ Monitoreo Japón</div>
          <div style="display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 0.5rem; scroll-snap-type: x mandatory;">
             {asiaDeals.length > 0 ? asiaDeals.slice(0, 4).map(deal => (
               <div style="min-width: 220px; padding: 1.25rem; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; scroll-snap-align: start;">
                  <div class="card-route" style="font-size: 1.2rem;">{deal.ida_origen_destino}</div>
                  <div class="card-price" style="font-size: 1.8rem; margin: 0.2rem 0;">{formatPrice(deal)}</div>
                  <div class="card-date" style="margin-bottom: 1rem; font-size: 0.85rem;">🗓 {formatDate(deal.ida_fecha)}</div>
                  {deal.link_reserva && <a href={deal.link_reserva} target="_blank" class="btn btn-primary" style="margin-top: auto; align-self: flex-start; padding: 0.4rem 1rem;">Ver Vuelo</a>}
               </div>
             )) : (
                <span style="color: var(--text-secondary); font-weight: 500;">No hay ofertas a Asia bajo presupuesto.</span>
             )}
          </div>
        </div>
      </div>
    </main>

    <script>
      // Lógica de cliente para botones
      document.querySelectorAll('.btn-approve, .btn-reject').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.id;
          const action = target.dataset.action;
          
          target.innerText = 'Procesando...';
          target.disabled = true;

          try {
            const res = await fetch('/api/aprobar-anomalia', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, action })
            });
            
            if(res.ok) {
              window.location.reload();
            } else {
              alert("Error al procesar la solicitud");
              target.disabled = false;
              target.innerText = action === 'aprobado' ? 'Aprobar' : 'Rechazar';
            }
          } catch(err) {
            alert("Error de conexión");
            target.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
