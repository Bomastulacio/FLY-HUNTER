---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);

const { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .gte('created_at', yesterday.toISOString())
  .order('precio_total_usd', { ascending: true });

const { data: insightsData } = await supabase.from('route_insights').select('*');
const routeInsights = insightsData || [];

// Procesar datos para enviarlos completos al cliente
const allDeals = deals || [];
const approvedDeals = allDeals.filter(d => d.estado_aprobacion === 'aprobado' || d.es_oportunidad_oro);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Flight Hunter - Mi Radar</title>
    
    <!-- PWA Config -->
    <meta name="theme-color" content="#141419" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FlyHunter" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body>
    <!-- Auth Guard Loader -->
    <div id="auth-loader" style="position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem; animation: pulse 1.5s infinite;"><i class="ph ph-airplane-tilt"></i></div>
      <h3 style="color: var(--text-secondary); font-weight: normal;">Conectando al radar...</h3>
    </div>

    <!-- 3D Animated Background -->
    <div class="bg-3d-scene">
      <div class="radar-circles">
        <div class="circle c1"></div>
        <div class="circle c2"></div>
        <div class="circle c3"></div>
        <div class="circle c4"></div>
      </div>
      <div class="horizon-line"></div>
      
      <div class="floating-elements">
        <div class="plane plane-1">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="1.5"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6L3 8l6.5 4.5L6 16l-3.2-1.3c-.4-.1-.8.2-1 .6L1 17l4.5 2.5L8 24l1.7-.8c.4-.2.7-.6.6-1L9 19l3.5-3.5 8.2 6.5c.4.2.8 0 .6-.5z"/></svg>
        </div>
        <div class="plane plane-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="1.5"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6L3 8l6.5 4.5L6 16l-3.2-1.3c-.4-.1-.8.2-1 .6L1 17l4.5 2.5L8 24l1.7-.8c.4-.2.7-.6.6-1L9 19l3.5-3.5 8.2 6.5c.4.2.8 0 .6-.5z"/></svg>
        </div>
        <div class="cube cube-1"></div>
      </div>
    </div>
    
    <main>
      <!-- Top Navigation (Desktop) -->
      <nav class="top-nav">
        <a href="/" class="top-nav-logo">
          <img src="/favicon.svg" alt="Fly Hunter Logo" width="32" height="32" style="border-radius: 8px;" />
          Flight Hunter
        </a>
        <div class="top-nav-actions" id="desktop-user-actions">
          <a href="/login" id="nav-login-btn" class="btn btn-outline" style="display: none; padding: 0.4rem 1rem;"><i class="ph ph-key" style="margin-right: 0.5rem;"></i> Ingresar</a>
          
          <div id="user-profile-dropdown" class="profile-dropdown" style="display: none;">
            <div class="profile-btn">
              <span id="user-email-display">usuario</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="dropdown-content">
              <div style="padding: 0.5rem 1rem; color: var(--text-secondary); font-size: 0.8rem; text-align: center;">Opciones</div>
              <div class="dropdown-divider"></div>
              <a href="#" id="btn-logout" class="danger"><i class="ph ph-sign-out" style="margin-right: 0.5rem;"></i> Cerrar Sesión</a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Hero & Radar Config -->
      <header id="main-hero">
        <h1>Encontramos las mejores tarifas desde Buenos Aires.</h1>
        <p id="hero-subtitle">Configura tu radar para empezar a recibir alertas.</p>
      </header>

      <div id="radar-config-container" class="radar-config-panel" style="display: none;">
        <div class="radar-field">
          <label>Origen</label>
          <div class="radar-field-value">Buenos Aires (EZE)</div>
        </div>
        <div class="radar-field">
          <label>Destino</label>
          <div class="radar-field-value" id="radar-val-destino">Europa</div>
        </div>
        <div class="radar-field">
          <label>Fechas de viaje</label>
          <div class="radar-field-value" id="radar-val-fechas">--</div>
        </div>
        <div class="radar-field">
          <label>Escalas máximas</label>
          <div class="radar-field-value" id="radar-val-escalas">--</div>
        </div>
        <div class="radar-field">
          <label>Presupuesto</label>
          <div class="radar-field-value" id="radar-val-presupuesto">--</div>
        </div>
        <a href="/alertas" class="btn btn-primary" style="padding: 0.8rem 2rem; margin: 0;">Editar Radar</a>
      </div>

      <!-- CONTENEDOR DINÁMICO DEL RADAR -->
      <div id="dynamic-dashboard" style="display: none;">
        <div class="bento-grid" id="destinations-grid">
           <!-- Renderizado por JS -->
        </div>
      </div>
      
      <!-- EMPTY STATE (Sin Alerta) -->
      <div id="empty-state" style="display: none; text-align: center; margin: 4rem 0;">
        <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--text-secondary);"><i class="ph ph-broadcast"></i></div>
        <h2>Aún no tienes un radar activo</h2>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">Configura tus preferencias para que nuestra IA busque los mejores vuelos por vos.</p>
      </div>

    </main>



    <!-- Pasar datos del servidor al cliente -->
    <script is:inline define:vars={{ approvedDeals }}>
      window.__SERVER_DATA__ = { approvedDeals };
    </script>

    <script>
      import { supabase } from '../lib/supabase';

      const formatPrice = (deal: any) => {
        const price = deal.precio_original || deal.precio_total_usd;
        const currency = deal.moneda_original || 'USD';
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
      };

      const formatDate = (dateStr: string) => {
        if (!dateStr) return '';
        const [y, m, d] = dateStr.split('-');
        const date = new Date(Number(y), Number(m) - 1, Number(d));
        return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
      };

      // Mapeo básico de países a códigos IATA para filtrar los vuelos del servidor
      const countryCodes: Record<string, string[]> = {
        "España": ["MAD", "BCN", "AGP", "VLC"],
        "Francia": ["CDG", "ORY", "NCE", "MRS"],
        "Italia": ["FCO", "MXP", "LIN", "NAP"],
        "Reino Unido": ["LHR", "LGW", "MAN", "EDI"],
        "Alemania": ["FRA", "MUC", "BER", "DUS"],
        "Portugal": ["LIS", "OPO"],
        "Países Bajos": ["AMS"],
        "Suiza": ["ZRH", "GVA"],
        "Grecia": ["ATH", "JMK"],
        "París": ["CDG", "ORY"],
        "Estados Unidos": ["JFK", "MIA", "LAX", "ORD", "SFO"],
        "Canadá": ["YYZ", "YVR", "YUL"],
        "México": ["MEX", "CUN", "GDL"],
        "Miami": ["MIA", "FLL"],
        "Nueva York": ["JFK", "LGA", "EWR"],
        "Brasil": ["GRU", "GIG", "BSB", "REC"],
        "Chile": ["SCL"],
        "Colombia": ["BOG", "MDE", "CTG"],
        "Perú": ["LIM", "CUZ"],
        "Uruguay": ["MVD"],
        "Río de Janeiro": ["GIG", "SDU"],
        "República Dominicana": ["PUJ", "SDQ"],
        "Cancún": ["CUN"],
        "Cuba": ["HAV"],
        "Costa Rica": ["SJO"],
        "Puerto Rico": ["SJU"],
        "Japón": ["NRT", "HND", "KIX"],
        "Tokio": ["NRT", "HND"],
        "Tailandia": ["BKK", "HKT"],
        "Corea del Sur": ["ICN"],
        "Emiratos Árabes": ["DXB"],
        "Australia": ["SYD", "MEL", "BNE"],
        "Nueva Zelanda": ["AKL"],
      };

      // @ts-ignore
      const allDeals = window.__SERVER_DATA__.approvedDeals || [];
      let cdInterval: any;
      
      const renderDashboard = (alert: any) => {
        const dash = document.getElementById('dynamic-dashboard');
        if(dash) dash.style.display = 'block';
        
        // Setup Radar Config Panel
        const configPanel = document.getElementById('radar-config-container');
        if (configPanel) configPanel.style.display = 'flex';
        
        const mainHero = document.getElementById('main-hero');
        if (mainHero) mainHero.style.display = 'none'; // Hide entirely if logged in

        const elDest = document.getElementById('radar-val-destino');
        if (elDest) elDest.innerText = alert.destino;
        const elFechas = document.getElementById('radar-val-fechas');
        if (elFechas) elFechas.innerText = `${formatDate(alert.fecha_ida_min)} - ${formatDate(alert.fecha_vuelta_max)}`;
        const elEscalas = document.getElementById('radar-val-escalas');
        if (elEscalas) elEscalas.innerText = `Máx. ${alert.escalas_max}`;
        const elPresupuesto = document.getElementById('radar-val-presupuesto');
        if (elPresupuesto) elPresupuesto.innerText = `US$ ${alert.presupuesto_max}`;

        // 2. Countdown logic para actualización del scraper
        if(cdInterval) clearInterval(cdInterval);
        
        const updateCountdown = () => {
          const now = new Date();
          let target = new Date(now);
          if (now.getHours() < 9) {
            target.setHours(9, 0, 0, 0);
          } else if (now.getHours() < 21) {
            target.setHours(21, 0, 0, 0);
          } else {
            target.setDate(target.getDate() + 1);
            target.setHours(9, 0, 0, 0);
          }
          const distance = target.getTime() - now.getTime();
          
          const countdownEl = document.getElementById('countdown-inner');
          if (!countdownEl) return;
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((distance % (1000 * 60)) / 1000);
          
          const hEl = document.getElementById('cd-hours');
          const mEl = document.getElementById('cd-minutes');
          const sEl = document.getElementById('cd-seconds');
          
          if(hEl) hEl.innerText = hours.toString().padStart(2, '0');
          if(mEl) mEl.innerText = mins.toString().padStart(2, '0');
          if(sEl) sEl.innerText = secs.toString().padStart(2, '0');
        };
        cdInterval = setInterval(updateCountdown, 1000);

        // 3. Destinations Grid
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        
        let html = '';
        
        // Filtramos TODOS los vuelos para que solo queden los que cumplen con el presupuesto y escalas
        const affordableDeals = allDeals.filter((d: any) => 
          d.precio_total_usd <= alert.presupuesto_max && 
          d.cantidad_escalas <= alert.escalas_max
        );
        
        // 1. Tarjeta Principal (El Vuelo Absoluto más barato que cumpla las reglas, de cualquier destino)
        // AL RENDERIZARLA PRIMERO Y CON SPAN 2 / ROW SPAN 2, QUEDA A LA IZQUIERDA.
        const mainDeal = affordableDeals.length > 0 ? affordableDeals[0] : null;
        
        html += `
          <div class="card main-deal">
            <div class="card-header"><i class="ph-fill ph-fire" style="color: #ffaa00; margin-right: 4px;"></i> Vuelo Más Barato (Tu Presupuesto)</div>
            ${mainDeal ? `
              <div class="card-route">${mainDeal.ida_origen_destino} <i class="ph ph-airplane-tilt" style="opacity: 0.5; margin: 0 4px;"></i> ${mainDeal.vuelta_origen_destino}</div>
              <div class="card-date"><i class="ph ph-calendar-blank"></i> ${formatDate(mainDeal.ida_fecha)} al ${formatDate(mainDeal.vuelta_fecha)}</div>
              <div style="color: var(--text-secondary); margin-top: 0.5rem; font-weight: 500;">${mainDeal.aerolinea} • ${mainDeal.cantidad_escalas} escalas</div>
              <div class="card-price">${formatPrice(mainDeal)}</div>
              ${mainDeal.link_reserva ? `<a href="${mainDeal.link_reserva}" target="_blank" class="btn btn-primary" style="align-self: flex-start; margin-top: 1.5rem;">Reserva en Google Flights</a>` : ''}
            ` : `
              <div style="margin: auto; color: var(--text-secondary); font-weight: 500;">No hay vuelos dentro de tu presupuesto y reglas.</div>
            `}
          </div>
        `;
        
        // 2. Countdown block (Ocupa la parte superior derecha)
        html += `
          <div class="card countdown-card" style="grid-column: span 2; display: flex; flex-direction: row; justify-content: space-between; align-items: center; border-color: rgba(255,255,255,0.1);">
            <div>
              <h2 style="margin: 0 0 0.5rem 0; font-size: 1.5rem; display:flex; align-items:center; gap: 0.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.92-10.27l-3.26 3.26"/></svg>
                Próximo Rastreo
              </h2>
              <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Buscando nuevas oportunidades para: ${alert.destino}</p>
            </div>
            <div id="countdown-inner" style="display: flex; justify-content: center; gap: 1rem; font-size: 1.5rem; font-weight: bold;">
              <div style="display: flex; flex-direction: column; align-items: center;">
                <span id="cd-hours" style="font-size: 2rem; color: var(--text-primary);">00</span>
                <span style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase;">Hs</span>
              </div>
              <div style="display: flex; flex-direction: column; align-items: center;">
                <span id="cd-minutes" style="font-size: 2rem; color: var(--text-primary);">00</span>
                <span style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase;">Min</span>
              </div>
              <div style="display: flex; flex-direction: column; align-items: center;">
                <span id="cd-seconds" style="font-size: 2rem; color: var(--text-primary);">00</span>
                <span style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase;">Seg</span>
              </div>
            </div>
          </div>
        `;

        // Priorizamos los países que el usuario eligió explícitamente.
        // Si no eligió ninguno (ej. seleccionó toda "Europa"), mostramos los 4 hubs principales por defecto.
        let explicitCountries = (alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera')) 
            ? [...alert.paises] 
            : ['España', 'Reino Unido', 'Francia', 'Alemania'];
            
        let countriesToRender = [...explicitCountries];
        
        // ¡Magia! Agregamos dinámicamente cualquier OTRO país que tenga una oferta válida en la BD
        Object.keys(countryCodes).forEach(country => {
            const hasDeal = affordableDeals.some((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
            if (hasDeal && !countriesToRender.includes(country)) {
                countriesToRender.push(country);
            }
        });
            
        if (countriesToRender.length > 0) {
          let cardsHtml = '<div class="europe-destinations">';
          
          countriesToRender.forEach((country: string) => {
            let destDeal = null;
            // Busca si hay ofertas para los aeropuertos de ese país
            if (countryCodes[country]) {
               destDeal = affordableDeals.find((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
            }
            
            cardsHtml += `
              <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
                <div class="card-header"><i class="ph ph-map-pin"></i> ${country}</div>
                ${destDeal ? `
                  <div class="card-route">${destDeal.ida_origen_destino}</div>
                  <div class="card-date"><i class="ph ph-calendar-blank"></i> ${formatDate(destDeal.ida_fecha)} al ${formatDate(destDeal.vuelta_fecha)}</div>
                  <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">${formatPrice(destDeal)}</div>
                  ${destDeal.link_reserva ? `<a href="${destDeal.link_reserva}" target="_blank" class="btn btn-primary" style="width: 100%; box-sizing: border-box;">Ver Vuelo</a>` : ''}
                ` : `
                  <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; gap: 0.5rem; padding: 1rem 0;">
                    <i class="ph ph-broadcast" style="font-size: 1.5rem;"></i>
                    <span style="font-size: 0.85rem; font-weight: 500; text-align: center;">Buscando ofertas...</span>
                  </div>
                `}
              </div>
            `;
          });
          
          cardsHtml += '</div>';
          html += cardsHtml;
        }

        grid.innerHTML = html;
        updateCountdown(); // Call immediately to avoid initial flash
      };

      const initDashboard = async () => {
        // Handle OAuth Redirect processing if needed
        if (window.location.hash.includes('access_token')) {
          supabase.auth.onAuthStateChange(async (event) => {
            if (event === 'SIGNED_IN') {
              window.location.hash = ''; // Limpiar la URL visualmente
              await loadUserData();
            }
          });
        } else {
          await loadUserData();
        }
      };

      const loadUserData = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        const loader = document.getElementById('auth-loader');
        if (loader) loader.style.display = 'none';

        if (session) {
          // Actualizar UI para usuario logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if (loginBtn) loginBtn.style.display = 'none';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if (profileDropdown) profileDropdown.style.display = 'inline-block';
          
          const emailDisplay = document.getElementById('user-email-display');
          if (emailDisplay) emailDisplay.innerText = session.user.email?.split('@')[0] || 'Usuario';

          const mobileProfile = document.getElementById('mobile-nav-profile');
          if (mobileProfile) {
            mobileProfile.href = "/alertas"; // En mobile, cuenta los lleva a config por ahora
          }

          // Escuchar logout
          const logoutBtn = document.getElementById('btn-logout');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              await supabase.auth.signOut();
              window.location.reload();
            });
          }

          // Traemos sus alertas
          const { data: alertData } = await supabase
            .from('search_alerts')
            .select('*')
            .eq('user_id', session.user.id)
            .single();
            
          if (alertData) {
            renderDashboard(alertData);
          } else {
            // Logueado pero sin alertas
            const empty = document.getElementById('empty-state');
            if(empty) empty.style.display = 'block';
          }
        } else {
          // No logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if(loginBtn) loginBtn.style.display = 'inline-block';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if(profileDropdown) profileDropdown.style.display = 'none';
          
          const empty = document.getElementById('empty-state');
          if(empty) empty.style.display = 'block';
        }
      };

      // Iniciar cuando el DOM esté listo
      window.addEventListener('DOMContentLoaded', initDashboard);

    </script>
  </body>
</html>
