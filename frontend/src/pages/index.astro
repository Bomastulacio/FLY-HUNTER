        <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.8rem;">
          📊 Inteligencia Artificial & Tendencias
        </h2>
        <div class="bento-grid" style="grid-auto-rows: auto; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
          {routeInsights.map((insight: any) => (
            <div class="card" style="padding: 1.25rem;">
              <div class="card-header" style="margin-bottom: 1rem; background: rgba(255,255,255,0.1);">{insight.ruta}</div>
              <div style="display: flex; flex-direction: column; gap: 0.8rem; font-size: 0.95rem;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem;">
                  <span style="color: var(--text-secondary);">Piso Promedio (7d)</span>
                  <strong>US$ {Math.round(insight.precio_promedio_7d)}</strong>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem;">
                  <span style="color: var(--text-secondary);">Mínimo Histórico</span>
                  <strong style="color: var(--success-color);">US$ {Math.round(insight.minimo_historico)}</strong>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
                  <span style="color: var(--text-secondary);">Tendencia Mínimo</span>
                  {insight.tendencia < -0.1 ? (
                    <span style="color: var(--success-color); font-weight: bold; display: flex; align-items: center; gap: 0.2rem;">📉 Bajando</span>
                  ) : insight.tendencia > 0.1 ? (
                    <span style="color: var(--danger-color); font-weight: bold; display: flex; align-items: center; gap: 0.2rem;">📈 Subiendo</span>
                  ) : (
                    <span style="color: #f9a01b; font-weight: bold; display: flex; align-items: center; gap: 0.2rem;">➖ Estable</span>
                  )}
                </div>
              </div>
            </div>
          ))}
          {routeInsights.length === 0 && (
            <div style="grid-column: 1 / -1; padding: 2rem; text-align: center; color: var(--text-secondary); background: var(--card-bg); border-radius: var(--border-radius-md); border: 1px dashed var(--card-border);">
              📡 El Agente Científico de Datos está procesando el historial de precios...
            </div>
          )}
        </div>
      </div>
    </main>

    <script>
      // Countdown Logic
      const targetDate = new Date('2027-04-16T00:00:00').getTime();
      
      const updateCountdown = () => {
        const now = new Date().getTime();
        const distance = targetDate - now;
        
        const countdownEl = document.getElementById('countdown');
        if (!countdownEl) return;

        if (distance < 0) {
          countdownEl.innerHTML = "<span style='font-size: 2rem; color: var(--accent-color);'>¡Feliz viaje! ✈️</span>";
          return;
        }
        
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
        
        const daysEl = document.getElementById('cd-days');
        const hoursEl = document.getElementById('cd-hours');
        const minsEl = document.getElementById('cd-minutes');
        const secsEl = document.getElementById('cd-seconds');
        
        if(daysEl) daysEl.innerText = days.toString().padStart(2, '0');
        if(hoursEl) hoursEl.innerText = hours.toString().padStart(2, '0');
        if(minsEl) minsEl.innerText = minutes.toString().padStart(2, '0');
        if(secsEl) secsEl.innerText = seconds.toString().padStart(2, '0');
      };
      
      updateCountdown();
      setInterval(updateCountdown, 1000); // Actualizar cada segundo

      // Lógica de cliente para botones
      document.querySelectorAll('.btn-approve, .btn-reject').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.id;
          const action = target.dataset.action;
          
          target.innerText = 'Procesando...';
          target.disabled = true;

          const token = window.prompt("Ingresa el Token de Administrador para confirmar:");
          if (!token) {
             target.innerText = action === 'aprobado' ? 'Aprobar' : 'Rechazar';
             target.disabled = false;
             return;
          }

          try {
            const res = await fetch('/api/aprobar-anomalia', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, action, token })
            });
            
            if(res.ok) {
              window.location.reload();
            } else {
              alert("Error al procesar la solicitud");
              target.disabled = false;
              target.innerText = action === 'aprobado' ? 'Aprobar' : 'Rechazar';
            }
          } catch(err) {
            alert("Error de conexión");
            target.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
