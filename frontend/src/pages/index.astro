---
import { supabase } from '../lib/supabase';
import { latestQuotes, feedCandidate } from '../utils/latestQuotes';
import '../styles/global.css';
import '../styles/compact.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);

let { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .gte('created_at', yesterday.toISOString())
  .order('created_at', { ascending: false }).limit(500);

// Fallback: si no hubo corridas en las últimas 24h, consultar las observaciones recientes verificadas (hasta 7 días)
if (!deals || deals.length === 0) {
  const lastWeek = new Date();
  lastWeek.setDate(lastWeek.getDate() - 7);
  const fallback = await supabase
    .from('flight_deals')
    .select('*')
    .gte('created_at', lastWeek.toISOString())
    .order('created_at', { ascending: false }).limit(500);
  deals = fallback.data || [];
}

const { data: insightsData } = await supabase.from('route_insights').select('*');
const routeInsights = insightsData || [];

// Procesar datos para enviarlos completos al cliente
const allDeals = latestQuotes(deals || []);
const approvedDeals = allDeals.filter(feedCandidate);
const pendingDeals = allDeals.filter(d => d.estado_aprobacion === 'pendiente' || (d.es_anomalia && d.estado_aprobacion !== 'rechazado' && d.estado_aprobacion !== 'aprobado'));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Flight Hunter - Mi Radar</title>
    
    <!-- PWA Config -->
    <meta name="theme-color" content="#101310" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FlyHunter" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body class="compact-app">
    <!-- Auth Guard Loader -->
    <div id="auth-loader" style="position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem; animation: pulse 1.5s infinite;"><i class="ph ph-airplane-tilt"></i></div>
      <h3 style="color: var(--text-secondary); font-weight: normal;">Conectando al radar...</h3>
    </div>

    <!-- 3D Animated Background -->
    <div class="bg-3d-scene">
      <div class="radar-circles">
        <div class="circle c1"></div>
        <div class="circle c2"></div>
        <div class="circle c3"></div>
        <div class="circle c4"></div>
      </div>
      <div class="horizon-line"></div>
    </div>
    
    <main>
      <!-- Top Navigation -->
      <nav class="top-nav">
        <a href="/" class="top-nav-logo">
          <img src="/favicon.svg" alt="Fly Hunter Logo" width="32" height="32" style="border-radius: 8px;" />
          <span class="nav-logo-text">Flight Hunter</span>
        </a>
        <div class="top-nav-actions" id="desktop-user-actions">
          <a href="/alertas" class="btn btn-outline nav-alertas-btn desktop-only" title="Mis Alertas" aria-label="Mis Alertas">
            <i class="ph ph-sliders"></i>
            <span class="nav-alertas-text">Mis Alertas</span>
          </a>
          <a href="/login" id="nav-login-btn" class="btn btn-outline" style="display: none; padding: 0.4rem 1rem; margin-top: 0;"><i class="ph ph-key" style="margin-right: 0.5rem;"></i> Ingresar</a>
          
          <div id="user-profile-dropdown" class="profile-dropdown" style="display: none;">
            <button class="profile-btn" aria-label="Cuenta de usuario">
              <span class="avatar-badge" id="user-avatar-badge">U</span>
              <span class="user-email-label" id="user-email-display">usuario</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-content">
              <div id="dropdown-user-info" class="dropdown-user-header">usuario</div>
              <a href="/alertas"><i class="ph ph-sliders" style="margin-right: 0.5rem;"></i> Mis Alertas</a>
              <div class="dropdown-divider"></div>
              <a href="#" id="btn-logout" class="danger"><i class="ph ph-sign-out" style="margin-right: 0.5rem;"></i> Cerrar Sesión</a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Hero -->
      <header id="main-hero">
        <span class="hero-eyebrow">UN VIAJE POR DELANTE</span>
        <h1>Tu próximo viaje, <span>sin buscar todos los días.</span></h1>
        <p id="hero-subtitle">Configura tu radar para empezar a recibir alertas.</p>
      </header>

      <!-- Radar Tabs Nav (Selector de alertas múltiples) -->
      <div id="radar-tabs-nav" class="radar-tabs-nav" style="display: none;"></div>

      <!-- CONTENEDOR DINÁMICO DEL RADAR (Dashboard Responsive) -->
      <div id="dynamic-dashboard" class="dashboard-layout" style="display: none;">
        
        <aside class="dashboard-sidebar" aria-label="Tu búsqueda">
          <details class="radar-overview">
            <summary>
              <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
              <span class="radar-summary-copy" id="radar-summary-text">Cargando búsqueda...</span>
              <span class="radar-edit-label">Filtros <i class="ph ph-caret-down" aria-hidden="true"></i></span>
            </summary>
            <div class="radar-overview-content">
              <div class="desktop-radar-body" id="desktop-radar-details"></div>
              <a href="/alertas" class="radar-config-link" id="radar-config-link"><i class="ph ph-pencil-simple" aria-hidden="true"></i> Editar esta búsqueda</a>
            </div>
          </details>
          <div id="countdown-strip-container" class="countdown-strip">
            <span class="countdown-strip-label">Próxima búsqueda estimada · <strong id="cd-target-dest">Europa</strong></span>
            <span class="countdown-strip-timer"><i class="ph ph-clock" aria-hidden="true"></i> <span id="compact-cd-val">Calculando...</span></span>
          </div>
          <details class="saved-note" id="source-status" hidden>
            <summary>Estado de las fuentes</summary>
            <div id="source-status-content"></div>
          </details>
        </aside>
        <div class="feed-toolbar">
          <div>
            <span class="feed-eyebrow">TU RADAR, DE UN VISTAZO</span>
            <h1>Más cerca de despegar.</h1>
          </div>
          <div class="feed-filters" role="group" aria-label="Mostrar vuelos">
            <button type="button" data-feed-filter="all" aria-pressed="true">Todos</button>
            <button type="button" data-feed-filter="saved" aria-pressed="false"><i class="ph ph-bookmark-simple" aria-hidden="true"></i> Guardados</button>
          </div>
        </div>
        <p class="saved-note" id="saved-note" hidden>Conservamos tu precio guardado y seguimos combinaciones que coincidan con tus radares activos.</p>
        <!-- Feed Principal Columna Derecha (Desktop: ancho consistente; Mobile: debajo de sidebar) -->
        <section class="dashboard-feed" id="destinations-grid">
           <!-- Renderizado por JS: Card destacada + Destinos -->
        </section>

      </div>
      
      <!-- EMPTY STATE (Sin Alerta) -->
      <div id="empty-state" style="display: none; text-align: center; margin: 4rem 0;">
        <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--text-secondary);"><i class="ph ph-broadcast"></i></div>
        <h2>Todavía no tenés una búsqueda</h2>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">Elegí destino, fechas y presupuesto. Te mostramos las opciones que encontramos.</p>
        <a href="/alertas" class="btn btn-primary">Configurar mi búsqueda</a>
      </div>

    </main>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container" role="status" aria-live="polite" aria-atomic="false"></div>

    <!-- Pasar datos del servidor al cliente -->
    <script is:inline define:vars={{ allDeals, approvedDeals, pendingDeals, routeInsights }}>
      window.__SERVER_DATA__ = { allDeals, approvedDeals, pendingDeals, routeInsights };
    </script>

    <script>
      import { supabase } from '../lib/supabase';
      import { renderCompactFlight, escapeHtml, usd, matchesRadar } from '../utils/compactFlights';
      import { mountRadarPicker, preferredRadarId, loadRadarPreference } from '../utils/radarPicker';
      import { nextSearchAt } from '../utils/searchSchedule';
      import { monitoredSavedDeal, meaningfulDrop } from '../utils/monitoringView';
      import { latestQuotes, feedCandidate } from '../utils/latestQuotes';

      const formatPrice = (deal: any) => {
        const price = deal.precio_original || deal.precio_total_usd;
        const currency = deal.moneda_original || 'USD';
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
      };

      const formatDate = (dateStr: string) => {
        if (!dateStr) return '';
        const [y, m, d] = dateStr.split('-');
        const date = new Date(Number(y), Number(m) - 1, Number(d));
        return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
      };

      // Mapeo básico de países a códigos IATA para filtrar los vuelos del servidor
      const countryCodes: Record<string, string[]> = {
        "España": ["MAD", "BCN", "AGP", "VLC"],
        "Francia": ["CDG", "ORY", "NCE", "MRS"],
        "Italia": ["FCO", "MXP", "LIN", "NAP"],
        "Reino Unido": ["LHR", "LGW", "MAN", "EDI"],
        "Alemania": ["FRA", "MUC", "BER", "DUS"],
        "Portugal": ["LIS", "OPO"],
        "Países Bajos": ["AMS"],
        "Suiza": ["ZRH", "GVA"],
        "Grecia": ["ATH", "JMK"],
        "París": ["CDG", "ORY"],
        "Estados Unidos": ["JFK", "MIA", "LAX", "ORD", "SFO"],
        "Canadá": ["YYZ", "YVR", "YUL"],
        "México": ["MEX", "CUN", "GDL"],
        "Miami": ["MIA", "FLL"],
        "Nueva York": ["JFK", "LGA", "EWR"],
        "Brasil": ["GRU", "GIG", "BSB", "REC"],
        "Chile": ["SCL"],
        "Colombia": ["BOG", "MDE", "CTG"],
        "Perú": ["LIM", "CUZ"],
        "Uruguay": ["MVD"],
        "Río de Janeiro": ["GIG", "SDU"],
        "República Dominicana": ["PUJ", "SDQ"],
        "Cancún": ["CUN"],
        "Cuba": ["HAV"],
        "Costa Rica": ["SJO"],
        "Puerto Rico": ["SJU"],
        "Japón": ["NRT", "HND", "KIX"],
        "Tokio": ["NRT", "HND"],
        "Tailandia": ["BKK", "HKT"],
        "Corea del Sur": ["ICN"],
        "Emiratos Árabes": ["DXB"],
        "Australia": ["SYD", "MEL", "BNE"],
        "Nueva Zelanda": ["AKL"],
      };

      const countryIsoCodes: Record<string, string> = {
        "España": "ES",
        "Francia": "FR",
        "Italia": "IT",
        "Reino Unido": "GB",
        "Alemania": "DE",
        "Portugal": "PT",
        "Países Bajos": "NL",
        "Suiza": "CH",
        "Grecia": "GR",
        "París": "FR",
        "Estados Unidos": "US",
        "Canadá": "CA",
        "México": "MX",
        "Miami": "US",
        "Nueva York": "US",
        "Brasil": "BR",
        "Chile": "CL",
        "Colombia": "CO",
        "Perú": "PE",
        "Uruguay": "UY",
        "Río de Janeiro": "BR",
        "República Dominicana": "DO",
        "Cancún": "MX",
        "Cuba": "CU",
        "Costa Rica": "CR",
        "Puerto Rico": "PR",
        "Japón": "JP",
        "Tokio": "JP",
        "Tailandia": "TH",
        "Corea del Sur": "KR",
        "Emiratos Árabes": "AE",
        "Australia": "AU",
        "Nueva Zelanda": "NZ"
      };

      // @ts-ignore
      let allDeals = window.__SERVER_DATA__.approvedDeals || [];
      let cdInterval: any;
      
      const renderDashboard = (alert: any) => {
        const dash = document.getElementById('dynamic-dashboard');
        if (dash) {
          dash.style.display = '';
          dash.classList.add('is-active');
        }
        
        
        const mainHero = document.getElementById('main-hero');
        if (mainHero) {
          mainHero.style.display = '';
          const title = mainHero.querySelector('h1');
          const subtitle = mainHero.querySelector('#hero-subtitle');
          if (title) title.innerHTML = `${escapeHtml(alert.nombre || alert.destino || 'Tu próximo viaje')}, <span>allá vamos.</span>`;
          if (subtitle) subtitle.textContent = `${Number(alert.pasajeros) || 2} adulto${Number(alert.pasajeros) === 1 ? '' : 's'} · ${Array.isArray(alert.paises) && alert.paises.length ? `${alert.paises.length} países posibles` : 'fechas flexibles'} · hasta ${usd(alert.presupuesto_max)}`;
        }

        const origRaw = alert.origen || "EZE";
        const orig = origRaw.split(',').map((s: string) => s.trim()).join(', ');
        const dest = alert.destino || "Europa";
        const fechasCompactas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
          ? `${formatDate(alert.fecha_ida_min)} - ${formatDate(alert.fecha_vuelta_max)}`
          : "";

        const exclCompactas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
          ? `sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
          : "";


        const summaryTextEl = document.getElementById('radar-summary-text');
        if (summaryTextEl) {
          summaryTextEl.innerHTML = `<strong>${escapeHtml(orig)} → ${escapeHtml(dest)}</strong><small>${escapeHtml(fechasCompactas || 'Fechas flexibles')} · Hasta ${usd(alert.presupuesto_max)}</small>`;
        }
        const configLink = document.getElementById('radar-config-link') as HTMLAnchorElement;
        if (configLink) configLink.href = `/alertas?radar=${encodeURIComponent(alert.id)}`;
        // Full preferences are available on demand, on every screen size.
        const desktopDetailsEl = document.getElementById('desktop-radar-details');
        if (desktopDetailsEl) {
          const fechasLargas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
            ? `${formatDate(alert.fecha_ida_min)} al ${formatDate(alert.fecha_vuelta_max)}`
            : "Fechas flexibles";
          const escalasLargas = alert.escalas_max === 0 ? "Vuelo directo" : `Hasta ${alert.escalas_max} escala${alert.escalas_max > 1 ? 's' : ''}`;
          const exclLargas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
            ? `Sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
            : "Todas las aerolíneas";
          const presupLargo = `Hasta ${usd(alert.presupuesto_max)}`;
          const pax = Number(alert.pasajeros) || 2;
          const paxText = pax === 1 ? "1 pasajero" : `${pax} pasajeros`;

          desktopDetailsEl.innerHTML = `
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-airplane-takeoff"></i> Ruta</div>
              <div class="radar-detail-value">${orig} → ${dest}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-calendar-blank"></i> Fechas</div>
              <div class="radar-detail-value">${fechasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-tag"></i> Presupuesto máx.</div>
              <div class="radar-detail-value highlight-price">${presupLargo}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-git-branch"></i> Escalas</div>
              <div class="radar-detail-value">${escalasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-prohibit"></i> Restricciones</div>
              <div class="radar-detail-value">${exclLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-users"></i> Pasajeros</div>
              <div class="radar-detail-value">${paxText}</div>
            </div>
          `;
        }

        // 3. Countdown logic para actualización del scraper
        if(cdInterval) clearInterval(cdInterval);
        
        const updateCountdown = () => {
          const now = new Date();
          const target = nextSearchAt(now);
          const distance = target.getTime() - now.getTime();
          
          const timerVal = document.getElementById('compact-cd-val');
          if (!timerVal) return;
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

          
          timerVal.innerText = `${hours.toString().padStart(2, '0')}h ${mins.toString().padStart(2, '0')}m`;
        };
        cdInterval = setInterval(updateCountdown, 1000);

        // 4. Feed de Vuelos y Destinos
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        
        let html = '';

        const cdDest = document.getElementById('cd-target-dest');
        if (cdDest) cdDest.innerText = alert.destino;

        // Filtramos TODOS los vuelos para que solo queden los que cumplen con el presupuesto y escalas
        const affordableDeals = allDeals.filter((d: any) => matchesRadar(d, alert));
        
        // Helper para renderizar la sección completa de Anomalías Pendientes
        const renderAnomaliesHTML = (currentAlert: any) => {
          // @ts-ignore
          const pending = (window.__SERVER_DATA__.pendingDeals || []).filter((d: any) => d.estado_aprobacion === 'pendiente');
          if (!pending || pending.length === 0) return '';

          let sectionHtml = `
            <details class="anomalies-section" id="anomalies-section">
              <summary class="compact-review-summary"><i class="ph ph-warning-circle" aria-hidden="true"></i> Para revisar <span id="anomalies-count">${pending.length}</span><i class="ph ph-caret-down" aria-hidden="true"></i></summary>
              <div class="anomalies-list">
          `;

          pending.forEach((pDeal: any) => {
            // Analizar regla rota
            let brokenRule = 'Desvío de parámetros estándar del radar';
            const maxStops = Number(currentAlert?.escalas_max ?? 1);
            const budgetMax = Number(currentAlert?.presupuesto_max ?? 2400);

            if (pDeal.cantidad_escalas > maxStops) {
              brokenRule = `${pDeal.cantidad_escalas} escalas (tu radar permite hasta ${maxStops} escala${maxStops === 1 ? '' : 's'})`;
            } else if (pDeal.precio_total_usd > budgetMax) {
              brokenRule = `Supera el presupuesto configurado de US$ ${budgetMax} (total: US$ ${pDeal.precio_total_usd})`;
            } else if (pDeal.ida_fecha && currentAlert?.fecha_ida_min && pDeal.ida_fecha < currentAlert.fecha_ida_min) {
              brokenRule = `Sale antes de tu fecha mínima programada (${formatDate(pDeal.ida_fecha)})`;
            } else if (pDeal.vuelta_fecha && currentAlert?.fecha_vuelta_max && pDeal.vuelta_fecha > currentAlert.fecha_vuelta_max) {
              brokenRule = `Regresa posterior a tu fecha máxima programada (${formatDate(pDeal.vuelta_fecha)})`;
            }

            // Criterio IA (por qué la marcó como interesante)
            let agentReason = `Oferta marcada para revisión por el radar. Verificá las condiciones antes de aprobarla.`;

            // Enlace de reserva / inspección
            const routeParts = (pDeal.ida_origen_destino || 'EZE-BCN').split('-');
            const origin = (routeParts[0] || 'EZE').trim().toUpperCase();
            const dest = (routeParts[1] || 'BCN').trim().toUpperCase();
            const passengers = Number(currentAlert?.pasajeros) || 2;
            const paxText = passengers === 1 ? '1 adult' : `${passengers} adults`;
            const inspectUrl = pDeal.link_reserva || `https://www.google.com/travel/flights?q=Flights%20to%20${dest}%20from%20${origin}%20on%20${pDeal.ida_fecha}%20through%20${pDeal.vuelta_fecha}%20for%20${encodeURIComponent(paxText)}&curr=USD&hl=es`;

            sectionHtml += `
              <div class="anomaly-card" id="anomaly-card-${pDeal.id}">
                <div class="anomaly-top-row">
                  <span class="anomaly-tag">
                    <i class="ph-fill ph-warning"></i>
                    <span>Anomalía en Radar</span>
                  </span>
                  <div class="anomaly-price-block">
                    <div class="anomaly-price-value">${formatPrice(pDeal)}</div>
                    <div class="anomaly-price-caption">Total para ${passengers} pasajero${passengers > 1 ? 's' : ''}</div>
                  </div>
                </div>

                <div class="anomaly-flight-info">
                  <div class="anomaly-route-title">
                    <span>${pDeal.ida_origen_destino}</span>
                    <i class="ph ph-airplane-tilt" style="opacity: 0.5; font-size: 1.1rem;"></i>
                    <span>${pDeal.vuelta_origen_destino || ''}</span>
                  </div>
                  <div class="anomaly-details-row">
                    <span><i class="ph ph-calendar-blank"></i> ${formatDate(pDeal.ida_fecha)} al ${formatDate(pDeal.vuelta_fecha)}</span>
                    <span><i class="ph ph-airplane"></i> ${pDeal.aerolinea || 'Aerolínea'}</span>
                    <span style="color: #f59e0b; font-weight: 600;"><i class="ph ph-git-branch"></i> ${pDeal.cantidad_escalas} escala${pDeal.cantidad_escalas === 1 ? '' : 's'}</span>
                  </div>
                </div>

                <div class="anomaly-insights-box">
                  <div class="insight-item">
                    <span class="insight-label broken"><i class="ph-fill ph-x-circle"></i> Regla que rompió:</span>
                    <span class="insight-text">${brokenRule}</span>
                  </div>
                  <div class="insight-item">
                    <span class="insight-label agent"><i class="ph-fill ph-sparkle"></i> Criterio de la IA:</span>
                    <span class="insight-text">${agentReason}</span>
                  </div>
                </div>

                <div class="anomaly-actions">
                  <a href="${inspectUrl}" target="_blank" rel="noopener noreferrer" class="btn-anomaly-inspect" title="Ver detalles y verificar fechas/escalas en vivo">
                    <i class="ph ph-arrow-square-out"></i> Inspeccionar
                  </a>
                  <div class="anomaly-actions-right">
                    <button type="button" class="btn-anomaly-discard" onclick="window.handleAnomalyAction('${pDeal.id}', 'rechazar', this)">
                      <i class="ph ph-trash"></i> Descartar
                    </button>
                    <button type="button" class="btn-anomaly-approve" onclick="window.handleAnomalyAction('${pDeal.id}', 'aprobar', this)">
                      <i class="ph-fill ph-check-circle"></i> Aprobar Oferta
                    </button>
                  </div>
                </div>
              </div>
            `;
          });

          sectionHtml += `
              </div>
            </details>
          `;

          return sectionHtml;
        };

        // 1. Sección de Anomalías Pendientes
        html += renderAnomaliesHTML(alert);

        const renderFlightCard = (deal: any, currentAlert: any, isMain = false, countryName = '') => {
          // @ts-ignore
          const insights = window.__SERVER_DATA__?.routeInsights || [];
          const matchingInsight = insights.find((r: any) => r.ruta === deal.ida_origen_destino);
          return renderCompactFlight(deal, currentAlert, isMain, countryName, savedFlights.has(String(deal.id)), matchingInsight);
        };

        // Destinos de la zona del radar actual
        const zoneCountriesMap: Record<string, string[]> = {
          "Europa": ["España", "Reino Unido", "Francia", "Alemania", "Italia", "Portugal", "Países Bajos", "Suiza", "Grecia"],
          "Norteamérica": ["Estados Unidos", "Canadá", "México", "Miami", "Nueva York"],
          "Latinoamérica": ["Brasil", "Chile", "Colombia", "Perú", "Uruguay", "Río de Janeiro"],
          "Caribe": ["República Dominicana", "Cancún", "Cuba", "Costa Rica", "Puerto Rico"],
          "Asia": ["Japón", "Tokio", "Tailandia", "Corea del Sur", "Emiratos Árabes"],
          "Oceanía": ["Australia", "Nueva Zelanda"]
        };

        const targetZone = alert.destino || "Europa";
        const zoneFallback = zoneCountriesMap[targetZone] || zoneCountriesMap["Europa"];

        // Priorizamos los países que el usuario eligió explícitamente o los de su zona
        const hasExplicitCountries = Boolean(alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera'));
        let explicitCountries = hasExplicitCountries 
            ? [...alert.paises] 
            : zoneFallback;
            
        let countriesToRender = [...explicitCountries];

        // Vuelos que pertenecen específicamente a este radar
        const radarMatchingDeals = affordableDeals.filter((d: any) =>
          /^[A-Z]{3}$/.test(targetZone) ? d.ida_origen_destino.split('-')[1] === targetZone :
          countriesToRender.some((c: string) => countryCodes[c]?.includes(d.ida_origen_destino.split('-')[1]))
        );

        // 1. Tarjeta Principal (Mejor vuelo del radar activo)
        const mainDeal = radarMatchingDeals.length > 0 ? radarMatchingDeals[0] : null;
        let mainDealCountry = '';
        if (mainDeal) {
          for (const [cName, codes] of Object.entries(countryCodes)) {
            if (codes.some(code => mainDeal.ida_origen_destino.includes(code))) {
              mainDealCountry = cName;
              break;
            }
          }
          html += renderFlightCard(mainDeal, alert, true, mainDealCountry);
        } else {
          html += `
            <div class="card main-deal" style="text-align: left; padding: 1.25rem;">
              <p style="color: var(--text-secondary); margin: 0; font-size: 1rem;">Todavía no hay cotizaciones recientes para ${Number(alert.pasajeros)} personas dentro de tus fechas y presupuesto de ${usd(alert.presupuesto_max)}.</p>
            </div>
          `;
        }

        // Otros destinos: separar los que tienen oferta de los que siguen buscando
        let countriesWithDeals: any[] = [];
        let countriesSearching: any[] = [];

        countriesToRender.forEach((country: string) => {
          let destDeal = null;
          if (countryCodes[country]) {
            destDeal = affordableDeals.find((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
          }

          const isDuplicateOfMain = mainDeal && destDeal && (
            destDeal.id === mainDeal.id || 
            (destDeal.ida_origen_destino === mainDeal.ida_origen_destino && destDeal.ida_fecha === mainDeal.ida_fecha && destDeal.precio_total_usd === mainDeal.precio_total_usd)
          );

          if (isDuplicateOfMain) {
            return;
          }

          if (destDeal && !countriesWithDeals.some(item => item.deal.id === destDeal.id)) {
            countriesWithDeals.push({ country, deal: destDeal });
          } else if (!destDeal && hasExplicitCountries) {
            countriesSearching.push({ country });
          }
        });

        countriesWithDeals.sort((a, b) => a.deal.precio_total_usd - b.deal.precio_total_usd);

        // Países con ofertas encontradas (renderizados con el nuevo layout completo)
        if (countriesWithDeals.length > 0) {
          countriesWithDeals.forEach(({ country, deal }) => {
            html += renderFlightCard(deal, alert, false, country);
          });
        }

        // More than one flight may be useful for the same destination: preserve carrier/date choices.
        const visibleQuotes = [mainDeal, ...countriesWithDeals.map(item => item.deal)].filter(Boolean);
        const itineraryKey = (d: any) => [d.ida_origen_destino, d.ida_fecha, d.vuelta_fecha, d.pasajeros, d.aerolinea, d.cantidad_escalas].join('|');
        const shownItineraries = new Set(visibleQuotes.map(itineraryKey));
        const extraQuotes = radarMatchingDeals.filter((d: any) => {
          const key = itineraryKey(d);
          if (shownItineraries.has(key)) return false;
          shownItineraries.add(key);
          return true;
        });
        const availableSlots = Math.max(0, 8 - visibleQuotes.length);
        const extras = extraQuotes.slice(0, availableSlots);
        const arQuote = extraQuotes.find((d: any) => /aerol[ií]neas argentinas/i.test(d.aerolinea || ''));
        if (arQuote && availableSlots && !extras.includes(arQuote)) extras.splice(availableSlots - 1, 1, arQuote);
        for (const deal of extras) html += renderFlightCard(deal, alert);

        if (countriesSearching.length > 0) {
          html += countriesSearching.map(({ country }) => `<article class="destination-waiting">
            <span class="waiting-icon"><i class="ph ph-globe-hemisphere-west" aria-hidden="true"></i></span>
            <div><h2>${escapeHtml(country)}</h2><p>Sin cotizaciones recientes en tus filtros</p></div>
            <a href="/alertas?radar=${encodeURIComponent(alert.id)}" aria-label="Ajustar búsqueda para ${escapeHtml(country)}"><i class="ph ph-sliders-horizontal" aria-hidden="true"></i></a>
            <span class="waiting-next"><i class="ph ph-clock" aria-hidden="true"></i> Se revisa por turnos, según cobertura</span>
          </article>`).join('');
        }
        grid.innerHTML = html;
        applySavedFilter();
        renderSourceStatus(alert.id);
        updateCountdown();
      };

      const initDashboard = async () => {
        // Handle OAuth Redirect processing if needed
        if (window.location.hash.includes('access_token')) {
          supabase.auth.onAuthStateChange(async (event) => {
            if (event === 'SIGNED_IN') {
              window.location.hash = ''; // Limpiar la URL visualmente
              await loadUserData();
            }
          });
        } else {
          await loadUserData();
        }
        await refreshLiveData(true);
      };

      const loadUserData = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        const loader = document.getElementById('auth-loader');
        if (loader) loader.style.display = 'none';

        if (session) {
          radarPreferenceUserId = session.user.id;
          await loadRadarPreference(radarPreferenceUserId);
          savedStorageKey = `fh_saved_flights_v1:${session.user.id}`;
          try {
            const stored = JSON.parse(localStorage.getItem(savedStorageKey) || '[]');
            savedFlights = new Set(Array.isArray(stored) ? stored.filter((id: unknown) => typeof id === 'string').slice(-500) : []);
          } catch { savedFlights = new Set(); }

          // Cargar guardados permanentes de Supabase
          try {
            const { data: dbSaved } = await supabase
              .from('saved_deals')
              .select('*')
              .eq('user_id', session.user.id)
              .order('guardado_el', { ascending: false });
            if (dbSaved && dbSaved.length > 0) {
              persistedSavedDeals = dbSaved;
              dbSaved.forEach((s: any) => {
                if (s.flight_deal_id) savedFlights.add(String(s.flight_deal_id));
                savedFlights.add(String(s.id));
              });
            }
          } catch (e) {
            console.warn('Error leyendo saved_deals de Supabase:', e);
          }

          // Actualizar UI para usuario logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if (loginBtn) loginBtn.style.display = 'none';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if (profileDropdown) profileDropdown.style.display = 'inline-block';
          
          const emailDisplay = document.getElementById('user-email-display');
          const username = session.user.email?.split('@')[0] || 'Usuario';
          if (emailDisplay) emailDisplay.innerText = username;

          const avatarBadge = document.getElementById('user-avatar-badge');
          if (avatarBadge && session.user) {
            const metadata = session.user.user_metadata || {};
            const avatarUrl = metadata.avatar_url || metadata.picture;
            
            if (avatarUrl) {
              avatarBadge.innerText = ''; // Quitar inicial
              avatarBadge.style.backgroundImage = `url('${avatarUrl}')`;
              avatarBadge.style.backgroundSize = 'cover';
              avatarBadge.style.backgroundPosition = 'center';
              avatarBadge.style.color = 'transparent'; // Por si acaso
              avatarBadge.style.border = '1px solid rgba(255,255,255,0.2)';
            } else if (session.user.email) {
              avatarBadge.innerText = session.user.email.charAt(0).toUpperCase();
            }
          }

          const dropdownUserInfo = document.getElementById('dropdown-user-info');
          if (dropdownUserInfo && session.user.email) {
            dropdownUserInfo.innerText = session.user.email;
          }

          // Escuchar logout
          const logoutBtn = document.getElementById('btn-logout');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              await supabase.auth.signOut();
              window.location.reload();
            });
          }

          // Lógica del Dropdown para Mobile (click toggle)
          const profileBtn = profileDropdown?.querySelector('.profile-btn');
          if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              profileDropdown.classList.toggle('active');
            });
            document.addEventListener('click', (e) => {
              if (!profileDropdown.contains(e.target)) {
                profileDropdown.classList.remove('active');
              }
            });
          }

          // Traemos todas las alertas configuradas del usuario
          const { data: alertsList } = await supabase
            .from('search_alerts')
            .select('*')
            .eq('user_id', session.user.id)
            .order('creado_en', { ascending: false });
            
          if (alertsList && alertsList.length > 0) {
            userAlerts = alertsList;
            const requestedId = new URLSearchParams(window.location.search).get('radar');
            const requestedIndex = userAlerts.findIndex(a => a.id === requestedId);
            activeAlertIndex = requestedIndex >= 0 ? requestedIndex : Math.max(0, userAlerts.findIndex(a => a.id === preferredRadarId(radarPreferenceUserId)));
            // @ts-ignore
            window.currentActiveAlert = userAlerts[activeAlertIndex];
            renderRadarTabs(userAlerts);
            renderDashboard(userAlerts[activeAlertIndex]);
          } else {
            // Logueado pero sin alertas
            const empty = document.getElementById('empty-state');
            if(empty) empty.style.display = 'block';
          }
        } else {
          // No logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if(loginBtn) loginBtn.style.display = 'inline-block';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if(profileDropdown) profileDropdown.style.display = 'none';
          
          const empty = document.getElementById('empty-state');
          if(empty) empty.style.display = 'block';
        }
      };

      // Toast Notifications Helper
      const showToast = (message: string, type = 'success') => {
        let container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        const icon = type === 'success' ? '<i class="ph ph-check"></i>' : '<i class="ph ph-x"></i>';
        toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
        container.appendChild(toast);
        void toast.offsetWidth;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 350);
        }, 4000);
      };

      // Bookmarks are synced to the signed-in user in Supabase and cached locally.
      let savedFlights = new Set<string>();
      let persistedSavedDeals: any[] = [];
      let savedStorageKey = '';
      let radarPreferenceUserId = '';
      let feedFilter = 'all';
      let latestChecks = new Map<string, any>();
      let sourceStatuses: any[] = [];
      let sourceStatusesLoaded = false;
      let sourceStatusesFailed = false;
      let refreshInFlight = false;
      let lastRefresh = 0;
      let bookmarkRevision = 0;

      const renderSourceStatus = (radarId: string) => {
        const container = document.getElementById('source-status');
        const content = document.getElementById('source-status-content');
        if (!container || !content) return;
        const rows = sourceStatuses.filter(row => row.radar_id === radarId);
        container.hidden = false;
        if (!sourceStatusesLoaded || sourceStatusesFailed) {
          content.textContent = sourceStatusesFailed ? 'No pudimos leer el estado de las fuentes. No podemos confirmar si el radar ya buscó.' : 'Consultando el estado de las fuentes…';
          return;
        }
        const labels: Record<string, string> = { ok: 'Consultada', empty: 'Sin resultados en la combinación consultada',
          unverified: 'No se pudo verificar', blocked: 'En pausa por bloqueo', error: 'Error de consulta', deferred: 'Pendiente por cuota o turno' };
        content.innerHTML = ['google_flights', 'despegar'].map(provider => {
          const name = provider === 'despegar' ? 'Despegar' : 'Google Flights';
          const row = rows.find(row => row.provider === provider);
          if (!row) return `<p><strong>${name}</strong> · Todavía no hay una consulta registrada para este radar. No significa que no existan vuelos.</p>`;
          const when = new Date(row.checked_at);
          const old = Date.now() - when.getTime() >= 86400000;
          const date = Number.isFinite(when.getTime()) ? new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(when) : 'Sin fecha';
          return `<p><strong>${row.provider === 'despegar' ? 'Despegar' : 'Google Flights'}</strong> · ${escapeHtml(labels[row.outcome] || 'Pendiente')} · ${escapeHtml(date)}<br>${old ? 'Estado sin actualizar.' : `${Number(row.checked_combinations)} de ${Number(row.total_combinations)} combinaciones verificadas en las 24 h anteriores a esa consulta.`}</p>`;
        }).join('');
      };

      // Refresh database snapshots only. Opening/focusing the app never starts a provider search.
      const refreshLiveData = async (force = false) => {
        const userId = radarPreferenceUserId;
        if (!userId || refreshInFlight || document.hidden || (!force && Date.now() - lastRefresh < 60000)) return;
        if (document.querySelector('[data-save-id][disabled]')) return;
        refreshInFlight = true;
        const revision = bookmarkRevision;
        lastRefresh = Date.now();
        try {
          let flights = await supabase.from('flight_deals').select('*').gte('created_at', new Date(Date.now() - 86400000).toISOString()).order('created_at', { ascending: false }).limit(500);
          if (!flights.error && (!flights.data || flights.data.length === 0)) {
            flights = await supabase.from('flight_deals').select('*').gte('created_at', new Date(Date.now() - 7 * 86400000).toISOString()).order('created_at', { ascending: false }).limit(500);
          }
          const [bookmarks, checks, statuses, freshInsights] = await Promise.all([
            supabase.from('saved_deals').select('*').eq('user_id', userId).order('guardado_el', { ascending: false }),
            supabase.from('saved_deal_latest').select('*'),
            supabase.from('radar_scan_status').select('*'),
            supabase.from('route_insights').select('*'),
          ]);
          if (!freshInsights.error && freshInsights.data) {
            // @ts-ignore
            window.__SERVER_DATA__.routeInsights = freshInsights.data;
          }
          if (radarPreferenceUserId !== userId || revision !== bookmarkRevision || document.querySelector('[data-save-id][disabled]')) return;
          if (!flights.error && flights.data) {
            const latest = latestQuotes(flights.data);
            allDeals = latest.filter(feedCandidate);
            // @ts-ignore
            window.__SERVER_DATA__.allDeals = latest;
            // @ts-ignore
            window.__SERVER_DATA__.approvedDeals = allDeals;
            // @ts-ignore
            window.__SERVER_DATA__.pendingDeals = latest.filter(d => d.estado_aprobacion === 'pendiente');
          }
          if (!bookmarks.error && bookmarks.data) {
            persistedSavedDeals = bookmarks.data;
            savedFlights = new Set(bookmarks.data.flatMap(d => [String(d.id), ...(d.flight_deal_id ? [String(d.flight_deal_id)] : [])]));
            try { localStorage.setItem(savedStorageKey, JSON.stringify([...savedFlights])); } catch {}
          }
          if (!checks.error && checks.data) latestChecks = new Map(checks.data.map(c => [c.saved_deal_id, c]));
          sourceStatusesLoaded = true;
          sourceStatusesFailed = !!statuses.error;
          if (!statuses.error && statuses.data) sourceStatuses = statuses.data;
          const grid = document.getElementById('destinations-grid');
          const openId = grid?.querySelector('.flight-disclosure[open]')?.closest<HTMLElement>('[data-flight-id]')?.dataset.flightId;
          const focused = document.activeElement as HTMLElement;
          const focusId = focused?.closest<HTMLElement>('[data-flight-id]')?.dataset.flightId;
          const focusSave = focused?.matches('[data-save-id]');
          // @ts-ignore
          if (window.currentActiveAlert) renderDashboard(window.currentActiveAlert);
          if (openId) grid?.querySelector<HTMLDetailsElement>(`[data-flight-id="${CSS.escape(openId)}"] .flight-disclosure`)?.setAttribute('open', '');
          if (focusId) grid?.querySelector<HTMLElement>(`[data-flight-id="${CSS.escape(focusId)}"] ${focusSave ? '.flight-save' : '.flight-summary'}`)?.focus({ preventScroll: true });
          for (const saved of persistedSavedDeals) {
            const check = latestChecks.get(saved.id);
            if (!meaningfulDrop(saved, check)) continue;
            const amount = Number((check.last_quote || check.quote).precio_total_usd);
            const key = `fh_drop_seen:${userId}:${saved.id}`;
            try {
              const previous = Number(localStorage.getItem(key)) || Number(saved.precio_total_usd);
              if (previous - amount < Math.max(50, previous * .05)) continue;
              localStorage.setItem(key, String(amount));
              showToast(`Bajó un guardado a ${usd(amount)}. Revisalo en Guardados.`);
              break; // One unobtrusive notice per refresh; the rest remain in the saved view.
            } catch { /* No repeating notification if its acknowledgement cannot be stored. */ }
          }
        } catch { /* Preserve the last readable snapshot on network failure. */ }
        finally { refreshInFlight = false; }
      };
      const refreshTimer = window.setInterval(() => { void refreshLiveData(); }, 120000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) void refreshLiveData(); });
      window.addEventListener('focus', () => { void refreshLiveData(); });
      window.addEventListener('pagehide', event => { if (!event.persisted) window.clearInterval(refreshTimer); });

      const applySavedFilter = () => {
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        grid.querySelector('.saved-empty')?.remove();
        grid.querySelectorAll('.extra-saved-card').forEach(card => card.remove());
        let visible = 0;

        grid.querySelectorAll<HTMLElement>('.flight-item:not(.extra-saved-card)').forEach(card => {
          const isSaved = savedFlights.has(card.dataset.flightId || '');
          card.hidden = feedFilter === 'saved' && !isSaved;
          if (feedFilter === 'saved') {
            if (isSaved) visible++;
          } else {
            if (!card.hidden) visible++;
          }
        });

        grid.querySelectorAll<HTMLElement>(':scope > :not(.flight-item)').forEach(el => { el.hidden = feedFilter === 'saved'; });

        // Si el filtro es 'saved', renderizar también los vuelos guardados que ya no están en el feed de las últimas 24h
        if (feedFilter === 'saved') {
          // Account bookmarks are stable cards, regardless of changing flight_deal ids/prices.
          if (radarPreferenceUserId) {
            grid.querySelectorAll<HTMLElement>('.flight-item').forEach(card => { card.hidden = true; });
            visible = 0;
            for (const sDeal of persistedSavedDeals) {
              const temp = document.createElement('div');
              // @ts-ignore
              temp.innerHTML = renderCompactFlight(monitoredSavedDeal(sDeal, latestChecks.get(sDeal.id)), window.currentActiveAlert, false, sDeal.destino, true);
              const card = temp.firstElementChild as HTMLElement;
              card.classList.add('extra-saved-card');
              grid.appendChild(card);
              visible++;
            }
          } else {
          const renderedIds = new Set<string>();
          grid.querySelectorAll<HTMLElement>('.flight-item').forEach(card => {
            if (card.dataset.flightId) renderedIds.add(card.dataset.flightId);
          });

          persistedSavedDeals.forEach(sDeal => {
            const sid = String(sDeal.flight_deal_id || sDeal.id);
            if (!renderedIds.has(sid) && !renderedIds.has(String(sDeal.id))) {
              const temp = document.createElement('div');
              // @ts-ignore
              temp.innerHTML = renderCompactFlight(sDeal, window.currentActiveAlert, false, sDeal.destino, true);
              const card = temp.firstElementChild as HTMLElement;
              if (card) {
                card.classList.add('extra-saved-card');
                grid.appendChild(card);
                renderedIds.add(sid);
                renderedIds.add(String(sDeal.id));
                visible++;
              }
            }
          });
          }
        }

        if (feedFilter === 'saved' && !visible) {
          const empty = document.createElement('p');
          empty.className = 'feed-empty saved-empty';
          empty.textContent = 'No tenés vuelos guardados. Tocá el marcador de una oferta para tenerla a mano siempre.';
          grid.append(empty);
        }
        const note = document.getElementById('saved-note');
        if (note) note.hidden = feedFilter !== 'saved';
        document.querySelectorAll<HTMLButtonElement>('[data-feed-filter]').forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.feedFilter === feedFilter));
        });
      };

      document.querySelectorAll<HTMLButtonElement>('[data-feed-filter]').forEach(btn => {
        btn.addEventListener('click', () => { feedFilter = btn.dataset.feedFilter || 'all'; applySavedFilter(); });
      });

      document.getElementById('destinations-grid')?.addEventListener('click', async event => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-save-id]');
        if (!button) return;
        const id = button.dataset.saveId!;
        if (button.disabled) return;
        bookmarkRevision++;
        button.disabled = true;
        const previousSaved = new Set(savedFlights);
        const next = new Set(savedFlights);
        const saving = !next.has(id);
        if (saving) next.add(id); else next.delete(id);

        if (savedStorageKey) {
          try {
            localStorage.setItem(savedStorageKey, JSON.stringify([...next].slice(-500)));
          } catch {}
        }
        savedFlights = next;
        button.setAttribute('aria-pressed', String(saving));
        button.setAttribute('aria-label', saving ? 'Quitar de guardados' : 'Guardar vuelo');
        button.title = saving ? 'Quitar de guardados' : 'Guardar en tu cuenta';
        const icon = button.querySelector('i');
        if (icon) icon.className = saving ? 'ph-fill ph-bookmark-simple' : 'ph ph-bookmark-simple';

        // Sincronizar en Supabase si el usuario tiene sesión activa
        if (radarPreferenceUserId) {
          try {
            if (saving) {
              // @ts-ignore
              const allKnown = [...(window.__SERVER_DATA__.approvedDeals || []), ...(window.__SERVER_DATA__.allDeals || []), ...persistedSavedDeals];
              const target = allKnown.find((d: any) => String(d.id) === id || String(d.flight_deal_id) === id);
              if (!target) throw new Error('No se encontró la cotización a guardar');
              if (target) {
                const rawOD = String(target.ida_origen_destino || `${target.origen || 'EZE'}-${target.destino || 'Vuelo'}`);
                const [orig = 'EZE', dest = 'Vuelo'] = rawOD.split('-').map((s: string) => s.trim());
                // @ts-ignore
                const pax = Math.max(1, Number(target.pasajeros || window.currentActiveAlert?.pasajeros) || 1);
                const total = Number(target.precio_total_usd || 0);
                const unit = Number(target.precio_por_pasajero_usd) || Math.round(total / pax);

                const { data: savedDb, error: saveError } = await supabase.from('saved_deals').upsert({
                  user_id: radarPreferenceUserId,
                  flight_deal_id: target.flight_deal_id || target.id,
                  origen: orig,
                  destino: dest,
                  ida_fecha: target.ida_fecha,
                  vuelta_fecha: target.vuelta_fecha,
                  pasajeros: pax,
                  precio_total_usd: total,
                  precio_por_pasajero_usd: unit,
                  aerolinea: target.aerolinea || 'Aerolínea',
                  cantidad_escalas: Number(target.cantidad_escalas || 0),
                  fuente: target.fuente || 'google_flights',
                  link_reserva: target.link_reserva || '',
                  detalle_cotizacion: target.detalle_cotizacion || null,
                  guardado_el: new Date().toISOString()
                }, { onConflict: 'user_id,origen,destino,ida_fecha,vuelta_fecha,pasajeros,aerolinea' }).select().single();
                if (saveError) throw saveError;

                if (savedDb) {
                  persistedSavedDeals.unshift(savedDb);
                  savedFlights.add(String(savedDb.id));
                }
              }
            } else {
              const { error: deleteError } = await supabase.from('saved_deals').delete()
                .eq('user_id', radarPreferenceUserId)
                .or(`flight_deal_id.eq.${id},id.eq.${id}`);
              if (deleteError) throw deleteError;
              persistedSavedDeals = persistedSavedDeals.filter(s => String(s.id) !== id && String(s.flight_deal_id) !== id);
            }
          } catch (dbErr) {
            console.warn('Error sincronizando con Supabase saved_deals:', dbErr);
            savedFlights = previousSaved;
            if (savedStorageKey) {
              try { localStorage.setItem(savedStorageKey, JSON.stringify([...savedFlights].slice(-500))); } catch {}
            }
            button.disabled = false;
            button.setAttribute('aria-pressed', String(!saving));
            button.setAttribute('aria-label', !saving ? 'Quitar de guardados' : 'Guardar vuelo');
            button.title = !saving ? 'Quitar de guardados' : 'Guardar en tu cuenta';
            if (icon) icon.className = !saving ? 'ph-fill ph-bookmark-simple' : 'ph ph-bookmark-simple';
            applySavedFilter();
            showToast('No se pudo sincronizar el vuelo con tu cuenta. Intentá de nuevo.');
            return;
          }
        }

        button.disabled = false;
        showToast(saving ? (radarPreferenceUserId ? 'Vuelo guardado permanentemente en tu cuenta.' : 'Vuelo guardado en este navegador.') : 'Vuelo quitado de guardados.');
        applySavedFilter();
        if (feedFilter === 'saved' && !saving) document.querySelector<HTMLButtonElement>('[data-feed-filter="saved"]')?.focus();
      });
      document.getElementById('destinations-grid')?.addEventListener('toggle', event => {
        const opened = event.target;
        if (!(opened instanceof HTMLDetailsElement) || !opened.classList.contains('flight-disclosure') || !opened.open) return;
        document.querySelectorAll<HTMLDetailsElement>('.flight-disclosure[open]').forEach(item => {
          if (item !== opened) item.open = false;
        });
      }, true);

      // Cards react like a physical ticket on precise pointers. Touch keeps a short press response.
      const flightGrid = document.getElementById('destinations-grid');
      flightGrid?.addEventListener('pointermove', event => {
        if (event.pointerType !== 'mouse' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const card = (event.target as HTMLElement).closest<HTMLElement>('.flight-item');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        card.style.setProperty('--card-rx', `${(0.5 - y) * 4}deg`);
        card.style.setProperty('--card-ry', `${(x - 0.5) * 4}deg`);
        card.style.setProperty('--card-x', `${x * 100}%`);
        card.style.setProperty('--card-y', `${y * 100}%`);
      });
      flightGrid?.addEventListener('pointerout', event => {
        const card = (event.target as HTMLElement).closest<HTMLElement>('.flight-item');
        const next = event.relatedTarget instanceof Element ? event.relatedTarget.closest('.flight-item') : null;
        if (!card || next === card) return;
        card.style.removeProperty('--card-rx');
        card.style.removeProperty('--card-ry');
        card.style.removeProperty('--card-x');
        card.style.removeProperty('--card-y');
      });

      // Multi-Alerts Tabs Navigator
      let userAlerts: any[] = [];
      let activeAlertIndex = 0;

      const renderRadarTabs = (alerts: any[]) => {
        const tabsNav = document.getElementById('radar-tabs-nav');
        if (!tabsNav) return;

        if (!alerts || alerts.length === 0) {
          tabsNav.style.display = 'none';
          return;
        }

        tabsNav.style.display = 'flex';
        
        tabsNav.innerHTML = `<div class="home-radar-picker"></div><a class="radar-manage" href="/alertas"><i class="ph ph-sliders-horizontal" aria-hidden="true"></i> Mis radares</a>`;
        mountRadarPicker(tabsNav.querySelector<HTMLElement>('.home-radar-picker')!, alerts,
          alerts[activeAlertIndex].id, radarPreferenceUserId, id => {
            activeAlertIndex = userAlerts.findIndex(a => a.id === id);
            // @ts-ignore
            window.currentActiveAlert = userAlerts[activeAlertIndex];
            renderDashboard(userAlerts[activeAlertIndex]);
          }, (id, newName) => {
            const target = userAlerts.find(a => a.id === id);
            if (target) target.nombre = newName;
            if (userAlerts[activeAlertIndex]?.id === id) {
              renderDashboard(userAlerts[activeAlertIndex]);
            }
            showToast(`Radar renombrado a "${newName}"`);
          });
      };

      // Manejador de acciones para Anomalías (Aprobar / Descartar)
      // @ts-ignore
      window.handleAnomalyAction = async (dealId: string, action: 'aprobar' | 'rechazar', btn: HTMLElement) => {
        const card = document.getElementById(`anomaly-card-${dealId}`);
        const originalHtml = btn.innerHTML;
        btn.setAttribute('disabled', 'true');
        btn.innerHTML = `<i class="ph ph-spinner-gap" style="animation: spin 1s linear infinite;"></i> Procesando...`;

        try {
          const { data: { session } } = await supabase.auth.getSession();
          const headers: Record<string, string> = { 'Content-Type': 'application/json' };
          if (session?.access_token) {
            headers['Authorization'] = `Bearer ${session.access_token}`;
          }

          const res = await fetch('/api/anomaly-action', {
            method: 'POST',
            headers,
            body: JSON.stringify({ deal_id: dealId, action })
          });
          const result = await res.json();

          if (result.success) {
            showToast(result.message, 'success');
            if (card) {
              card.classList.add('anomaly-dismissing');
              setTimeout(() => {
                card.remove();
                const countEl = document.getElementById('anomalies-count');
                const sectionEl = document.getElementById('anomalies-section');
                const remaining = document.querySelectorAll('.anomaly-card');
                if (countEl) countEl.innerText = `${remaining.length}`;
                if (remaining.length === 0 && sectionEl) {
                  sectionEl.style.display = 'none';
                }
              }, 450);
            }

            // Actualizar el estado de deals en memoria sin recargar la página
            // @ts-ignore
            const pendingList = window.__SERVER_DATA__.pendingDeals || [];
            const idx = pendingList.findIndex((d: any) => d.id === dealId);
            if (idx !== -1) {
              const deal = pendingList.splice(idx, 1)[0];
              if (action === 'aprobar') {
                deal.estado_aprobacion = 'aprobado';
                // @ts-ignore
                if (!window.__SERVER_DATA__.approvedDeals) window.__SERVER_DATA__.approvedDeals = [];
                // @ts-ignore
                window.__SERVER_DATA__.approvedDeals.push(deal);
                // Re-render feed con el deal recién aprobado para el usuario
                // @ts-ignore
                if (window.currentActiveAlert) {
                  // @ts-ignore
                  setTimeout(() => renderDashboard(window.currentActiveAlert), 500);
                }
              }
            }
          } else {
            showToast('Error: ' + (result.error || 'No se pudo procesar'), 'error');
            btn.removeAttribute('disabled');
            btn.innerHTML = originalHtml;
          }
        } catch (err: any) {
          showToast('Error de comunicación con el servidor', 'error');
          btn.removeAttribute('disabled');
          btn.innerHTML = originalHtml;
        }
      };

      // Iniciar cuando el DOM esté listo
      window.addEventListener('DOMContentLoaded', initDashboard);
    </script>
  </body>
</html>
