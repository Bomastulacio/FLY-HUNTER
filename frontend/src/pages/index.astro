---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);

const { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .gte('created_at', yesterday.toISOString())
  .order('precio_total_usd', { ascending: true });

const { data: insightsData } = await supabase.from('route_insights').select('*');
const routeInsights = insightsData || [];

// Procesar datos para el grid
const allDeals = deals || [];
const approvedDeals = allDeals.filter(d => d.estado_aprobacion === 'aprobado' || d.es_oportunidad_oro);
const pendingAnomalies = allDeals.filter(d => d.estado_aprobacion === 'pendiente');

const mainDeal = approvedDeals.length > 0 ? approvedDeals[0] : null;

// Encontrar mejores por destino (soporta múltiples aeropuertos por país)
const getBestForDest = (dests: string[]) => approvedDeals.find(d => dests.some(dest => d.ida_origen_destino.includes(dest)));
const spainDeal = getBestForDest(['MAD', 'BCN']);
const franceDeal = getBestForDest(['CDG', 'ORY']);
const ukDeal = getBestForDest(['LHR', 'LGW']);
const germanyDeal = getBestForDest(['BER', 'FRA', 'MUC']);
const lufthansaDeal = approvedDeals.find(d => d.aerolinea.toLowerCase().includes('lufthansa'));

// Asia
const asiaDeals = approvedDeals.filter(d => d.ida_origen_destino.includes('NRT') || d.ida_origen_destino.includes('KIX'));

// Formateador de moneda
const formatPrice = (deal: any) => {
  const price = deal.precio_original || deal.precio_total_usd;
  const currency = deal.moneda_original || 'USD';
  return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
};

// Formateador de fechas (ej: "2027-04-19" -> "19 abr")
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const [y, m, d] = dateStr.split('-');
  const date = new Date(Number(y), Number(m) - 1, Number(d));
  return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
};
