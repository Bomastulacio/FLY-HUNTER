        "Emiratos Árabes": "🇦🇪",
        "Australia": "🇦🇺",
        "Nueva Zelanda": "🇳🇿"
      };

      const countryIsoCodes: Record<string, string> = {
        "España": "ES",
        "Francia": "FR",
        "Italia": "IT",
        "Reino Unido": "GB",
        "Alemania": "DE",
        "Portugal": "PT",
        "Países Bajos": "NL",
        "Suiza": "CH",
        "Grecia": "GR",
        "París": "FR",
        "Estados Unidos": "US",
        "Canadá": "CA",
        "México": "MX",
        "Miami": "US",
        "Nueva York": "US",
        "Brasil": "BR",
        "Chile": "CL",
        "Colombia": "CO",
        "Perú": "PE",
        "Uruguay": "UY",
        "Río de Janeiro": "BR",
        "República Dominicana": "DO",
        "Cancún": "MX",
        "Cuba": "CU",
        "Costa Rica": "CR",
        "Puerto Rico": "PR",
        "Japón": "JP",
        "Tokio": "JP",
        "Tailandia": "TH",
        "Corea del Sur": "KR",
        "Emiratos Árabes": "AE",
        "Australia": "AU",
        "Nueva Zelanda": "NZ"
      };

      // @ts-ignore
      const allDeals = window.__SERVER_DATA__.approvedDeals || [];
      let cdInterval: any;
      
      const renderDashboard = (alert: any) => {
        const dash = document.getElementById('dynamic-dashboard');
        if (dash) {
          dash.style.display = '';
          dash.classList.add('is-active');
        }
        
        const summaryStrip = document.getElementById('radar-summary-strip');
        if (summaryStrip) summaryStrip.style.display = 'flex';
        
        const mainHero = document.getElementById('main-hero');
        if (mainHero) mainHero.style.display = 'none';

        const origRaw = alert.origen || "EZE";
        const orig = origRaw.split(',').map((s: string) => s.trim()).join(', ');
        const dest = alert.destino || "Europa";
        const fechasCompactas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
          ? `${formatDate(alert.fecha_ida_min)} - ${formatDate(alert.fecha_vuelta_max)}`
          : "";
        const escalasCompactas = `máx ${alert.escalas_max} esc.`;
        const exclCompactas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
          ? `sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
          : "";
        const presupCompacto = `US$ ${alert.presupuesto_max}`;

        // 1. Mobile Pill Summary
        const summaryTextEl = document.getElementById('radar-summary-text');
        if (summaryTextEl) {
          const parts = [
            `<strong>${orig} → ${dest}</strong>`,
            fechasCompactas,
            escalasCompactas,
            exclCompactas,
            `<strong>${presupCompacto}</strong>`
          ].filter(Boolean);
          summaryTextEl.innerHTML = parts.join(' · ');
        }

        // 2. Desktop Expanded Radar Panel (Siempre visible en desktop ≥1024px)
        const desktopDetailsEl = document.getElementById('desktop-radar-details');
        if (desktopDetailsEl) {
          const fechasLargas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
            ? `${formatDate(alert.fecha_ida_min)} al ${formatDate(alert.fecha_vuelta_max)}`
            : "Fechas flexibles";
          const escalasLargas = alert.escalas_max === 0 ? "Vuelo directo" : `Hasta ${alert.escalas_max} escala${alert.escalas_max > 1 ? 's' : ''}`;
          const exclLargas = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
            ? `Sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
            : "Todas las aerolíneas";
          const presupLargo = `Hasta US$ ${alert.presupuesto_max}`;
          const pax = Number(alert.pasajeros) || 2;
          const paxText = pax === 1 ? "1 pasajero" : `${pax} pasajeros`;

          desktopDetailsEl.innerHTML = `
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-airplane-takeoff"></i> Ruta</div>
              <div class="radar-detail-value">${orig} → ${dest}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-calendar-blank"></i> Fechas</div>
              <div class="radar-detail-value">${fechasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-tag"></i> Presupuesto máx.</div>
              <div class="radar-detail-value highlight-price">${presupLargo}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-git-branch"></i> Escalas</div>
              <div class="radar-detail-value">${escalasLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-prohibit"></i> Restricciones</div>
              <div class="radar-detail-value">${exclLargas}</div>
            </div>
            <div class="radar-detail-item">
              <div class="radar-detail-label"><i class="ph ph-users"></i> Pasajeros</div>
              <div class="radar-detail-value">${paxText}</div>
            </div>
          `;
        }

        // 3. Countdown logic para actualización del scraper
        if(cdInterval) clearInterval(cdInterval);
        
        const updateCountdown = () => {
          const now = new Date();
          let target = new Date(now);
          if (now.getHours() < 9) {
            target.setHours(9, 0, 0, 0);
          } else if (now.getHours() < 21) {
            target.setHours(21, 0, 0, 0);
          } else {
            target.setDate(target.getDate() + 1);
            target.setHours(9, 0, 0, 0);
          }
          const distance = target.getTime() - now.getTime();
          
          const timerVal = document.getElementById('compact-cd-val');
          if (!timerVal) return;
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((distance % (1000 * 60)) / 1000);
          
          timerVal.innerText = `${hours.toString().padStart(2, '0')}h ${mins.toString().padStart(2, '0')}m ${secs.toString().padStart(2, '0')}s`;
        };
        cdInterval = setInterval(updateCountdown, 1000);

        // 4. Feed de Vuelos y Destinos
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        
        let html = '';

        const cdDest = document.getElementById('cd-target-dest');
        if (cdDest) cdDest.innerText = alert.destino;

        // Filtramos TODOS los vuelos para que solo queden los que cumplen con el presupuesto y escalas
        const affordableDeals = allDeals.filter((d: any) => 
          d.precio_total_usd <= alert.presupuesto_max && 
          d.cantidad_escalas <= alert.escalas_max
        );
        
        // Helper para renderizar la sección completa de Anomalías Pendientes
        const renderAnomaliesHTML = (currentAlert: any) => {
          // @ts-ignore
          const pending = (window.__SERVER_DATA__.pendingDeals || []).filter((d: any) => d.estado_aprobacion === 'pendiente');
          if (!pending || pending.length === 0) return '';

          let sectionHtml = `
            <section class="anomalies-section" id="anomalies-section">
              <div class="anomalies-header">
                <div class="anomalies-title-group">
                  <div class="anomalies-icon-pulse">
                    <i class="ph-fill ph-warning-octagon"></i>
                  </div>
                  <div>
                    <h3 class="anomalies-title">
                      <span>Anomalías Pendientes</span>
                      <span class="anomalies-badge-count" id="anomalies-count">${pending.length}</span>
                    </h3>
                    <p class="anomalies-subtitle">Vuelos con tarifas extraordinarias que desvían levemente tus parámetros. Revisá y aprobá para sumarlos a tu radar.</p>
                  </div>
                </div>
              </div>
              <div class="anomalies-list" style="display: flex; flex-direction: column; gap: 1rem;">
          `;

          pending.forEach((pDeal: any) => {
            // Analizar regla rota
            let brokenRule = 'Desvío de parámetros estándar del radar';
            const maxStops = Number(currentAlert?.escalas_max ?? 1);
            const budgetMax = Number(currentAlert?.presupuesto_max ?? 2400);

            if (pDeal.cantidad_escalas > maxStops) {
              brokenRule = `${pDeal.cantidad_escalas} escalas (tu radar permite hasta ${maxStops} escala${maxStops === 1 ? '' : 's'})`;
            } else if (pDeal.precio_total_usd > budgetMax) {
              brokenRule = `Supera el presupuesto configurado de US$ ${budgetMax} (total: US$ ${pDeal.precio_total_usd})`;
            } else if (pDeal.ida_fecha && currentAlert?.fecha_ida_min && pDeal.ida_fecha < currentAlert.fecha_ida_min) {
              brokenRule = `Sale antes de tu fecha mínima programada (${formatDate(pDeal.ida_fecha)})`;
            } else if (pDeal.vuelta_fecha && currentAlert?.fecha_vuelta_max && pDeal.vuelta_fecha > currentAlert.fecha_vuelta_max) {
              brokenRule = `Regresa posterior a tu fecha máxima programada (${formatDate(pDeal.vuelta_fecha)})`;
            }

            // Criterio IA (por qué la marcó como interesante)
            let agentReason = `Tarifa sumamente atractiva (${formatPrice(pDeal)}), con ahorro estimado superior a la media de la ruta ${pDeal.ida_origen_destino}.`;

            // Enlace de reserva / inspección
            const routeParts = (pDeal.ida_origen_destino || 'EZE-BCN').split('-');
            const origin = (routeParts[0] || 'EZE').trim().toUpperCase();
            const dest = (routeParts[1] || 'BCN').trim().toUpperCase();
            const passengers = Number(currentAlert?.pasajeros) || 2;
            const paxText = passengers === 1 ? '1 adult' : `${passengers} adults`;
            const inspectUrl = pDeal.link_reserva || `https://www.google.com/travel/flights?q=Flights%20to%20${dest}%20from%20${origin}%20on%20${pDeal.ida_fecha}%20through%20${pDeal.vuelta_fecha}%20for%20${encodeURIComponent(paxText)}&curr=USD&hl=es`;

            sectionHtml += `
              <div class="anomaly-card" id="anomaly-card-${pDeal.id}">
                <div class="anomaly-top-row">
                  <span class="anomaly-tag">
                    <i class="ph-fill ph-warning"></i>
                    <span>Anomalía en Radar</span>
                  </span>
                  <div class="anomaly-price-block">
                    <div class="anomaly-price-value">${formatPrice(pDeal)}</div>
                    <div class="anomaly-price-caption">Total para ${passengers} pasajero${passengers > 1 ? 's' : ''}</div>
                  </div>
                </div>

                <div class="anomaly-flight-info">
                  <div class="anomaly-route-title">
                    <span>${pDeal.ida_origen_destino}</span>
                    <i class="ph ph-airplane-tilt" style="opacity: 0.5; font-size: 1.1rem;"></i>
                    <span>${pDeal.vuelta_origen_destino || ''}</span>
                  </div>
                  <div class="anomaly-details-row">
                    <span><i class="ph ph-calendar-blank"></i> ${formatDate(pDeal.ida_fecha)} al ${formatDate(pDeal.vuelta_fecha)}</span>
                    <span><i class="ph ph-airplane"></i> ${pDeal.aerolinea || 'Aerolínea'}</span>
                    <span style="color: #f59e0b; font-weight: 600;"><i class="ph ph-git-branch"></i> ${pDeal.cantidad_escalas} escala${pDeal.cantidad_escalas === 1 ? '' : 's'}</span>
                  </div>
                </div>

                <div class="anomaly-insights-box">
                  <div class="insight-item">
                    <span class="insight-label broken"><i class="ph-fill ph-x-circle"></i> Regla que rompió:</span>
                    <span class="insight-text">${brokenRule}</span>
                  </div>
                  <div class="insight-item">
                    <span class="insight-label agent"><i class="ph-fill ph-sparkle"></i> Criterio de la IA:</span>
                    <span class="insight-text">${agentReason}</span>
                  </div>
                </div>

                <div class="anomaly-actions">
                  <a href="${inspectUrl}" target="_blank" rel="noopener noreferrer" class="btn-anomaly-inspect" title="Ver detalles y verificar fechas/escalas en vivo">
                    <i class="ph ph-arrow-square-out"></i> Inspeccionar
                  </a>
                  <div class="anomaly-actions-right">
                    <button type="button" class="btn-anomaly-discard" onclick="window.handleAnomalyAction('${pDeal.id}', 'rechazar', this)">
                      <i class="ph ph-trash"></i> Descartar
                    </button>
                    <button type="button" class="btn-anomaly-approve" onclick="window.handleAnomalyAction('${pDeal.id}', 'aprobar', this)">
                      <i class="ph-fill ph-check-circle"></i> Aprobar Oferta
                    </button>
                  </div>
                </div>
              </div>
            `;
          });

          sectionHtml += `
              </div>
            </section>
          `;

          return sectionHtml;
        };

        // 1. Sección de Anomalías Pendientes
        html += renderAnomaliesHTML(alert);

        // Helper para renderizar card completa con jerarquía visual y recorrido de decisión
        const renderFlightCard = (deal: any, currentAlert: any, isMain = false, countryName = '') => {
          if (!deal) return '';
          const passengers = Number(currentAlert?.pasajeros) || 2;
          const paxText = passengers === 1 ? '1 adulto' : `${passengers} adultos`;
          const budgetMax = Number(currentAlert?.presupuesto_max) || 2400;

          // Resolver país
          let cName = countryName;
          if (!cName) {
            for (const [name, codes] of Object.entries(countryCodes)) {
              if (codes.some(code => deal.ida_origen_destino.includes(code))) {
                cName = name;
                break;
              }
            }
          }
          const isoBadge = cName && countryIsoCodes[cName] ? countryIsoCodes[cName] : 'INT';

          // Link de reserva validado y formateado
          const isDespegar = deal.fuente === 'despegar';
          const providerLabel = isDespegar ? 'Despegar' : 'Google Flights';
          let bookingUrl = deal.link_reserva;
          if (!bookingUrl || !isDespegar) {
            const routeParts = (deal.ida_origen_destino || 'EZE-MAD').split('-');
            const orig = (routeParts[0] || 'EZE').trim().toUpperCase();
            const dst = (routeParts[1] || 'MAD').trim().toUpperCase();
            const passengerQuery = passengers === 1 ? '1 adult' : `${passengers} adults`;
            bookingUrl = `https://www.google.com/travel/flights?q=Flights%20to%20${dst}%20from%20${orig}%20on%20${deal.ida_fecha}%20through%20${deal.vuelta_fecha}%20for%20${encodeURIComponent(passengerQuery)}&curr=USD&hl=es`;
          }

          const cardClass = isMain ? 'card main-deal fh-ui' : 'card destination-flight-card fh-ui';
          const isGold = deal.es_oportunidad_oro;
          const statusBadgeText = isGold ? 'Oportunidad de Oro' : 'Aprobado';
          const statusIcon = isGold ? 'ph-fill ph-fire' : 'ph-fill ph-check-circle';
          const statusSub = isGold ? 'Por debajo de tu umbral · Respeta tus filtros' : 'Respeta tus filtros y fechas';

          return `
            <article class="${cardClass}" id="deal-card-${deal.id}" style="width: 100%;">
              <!-- 1. ¿Adónde voy? -->
              <header class="main-deal-header">
                ${cName ? `
                  <div class="main-deal-country">
                    <span class="country-iso-badge">${isoBadge}</span>
                    <span>${cName}</span>
                  </div>
                ` : `
                  <span class="fh-label">${currentAlert.nombre || currentAlert.destino}</span>
                `}
                
                <div class="main-deal-tag tooltip-trigger" style="${isGold ? '' : 'color: var(--accent-color); background: rgba(209, 255, 76, 0.08); border-color: rgba(209, 255, 76, 0.25);'}">
                  <i class="${statusIcon}"></i>
                  <span>${statusBadgeText}</span>
                  <span class="tooltip-box">${isGold ? 'Tarifa extraordinaria con más del 30% de ahorro frente al promedio histórico.' : 'Cumple con el 100% de tus parámetros de fechas, escalas y presupuesto.'}</span>
                </div>
              </header>

              <div class="card-route" style="font-size: 1.45rem; font-weight: 700; margin-top: 0.25rem;">
                ${deal.ida_origen_destino} <i class="ph ph-airplane-tilt" style="opacity: 0.5; margin: 0 4px;"></i> ${deal.vuelta_origen_destino || ''}
              </div>

              <!-- 2. ¿Cuánto cuesta para todos? -->
              <div style="margin-top: 0.6rem;">
                <div class="card-price" style="margin: 0; line-height: 1;">${formatPrice(deal)}</div>
                <div class="fh-muted" style="font-size: 0.82rem; margin-top: 0.35rem;">Total para ${paxText} · Ida y vuelta</div>
              </div>

              <!-- 3. ¿Cuándo y con qué condiciones? -->
              <dl class="fh-facts" style="margin-block: 0.85rem;">
                <div>
                  <dt>Fechas</dt>
                  <dd><i class="ph ph-calendar-blank"></i> ${formatDate(deal.ida_fecha)} al ${formatDate(deal.vuelta_fecha)}</dd>
                </div>
                <div>
                  <dt>Escalas & Aerolínea</dt>
                  <dd><i class="ph ph-airplane"></i> ${deal.cantidad_escalas === 0 ? 'Vuelo directo' : `${deal.cantidad_escalas} escala(s)`} · ${deal.aerolinea || 'Aerolínea'}</dd>
                </div>
              </dl>

              <!-- 4. ¿Por qué vale la pena? -->
              <p class="fh-positive" style="font-size: 0.85rem; margin-bottom: 0.85rem;">
                <i class="ph ph-check-circle" aria-hidden="true"></i> ${statusSub}
              </p>

              <!-- 5. CTA Principal -->
              <a href="${bookingUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; min-height: 2.75rem; text-decoration: none; font-weight: 650; box-sizing: border-box;">
                <span>Ver en ${providerLabel}</span>
                <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>

              <!-- 1. Recorrido de Decisión ("Por qué te mostramos este vuelo") -->
              <details class="fh-panel fh-explanation">
                <summary><i class="ph ph-git-commit" style="color: var(--accent-color); margin-right: 0.35rem;"></i> Por qué te mostramos este vuelo</summary>
                <ol class="fh-trail">
                  <li>
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <div>
                      <strong>Cotización registrada</strong>
                      <p>${formatPrice(deal)} en total para ${paxText}.</p>
                      <small>Fuente: ${providerLabel} · Consulta del Agente</small>
                    </div>
                  </li>
                  <li>
                    <i class="ph ph-check-circle" aria-hidden="true"></i>
                    <div>
                      <strong>Respeta tus filtros</strong>
                      <p>${deal.cantidad_escalas === 0 ? 'Vuelo directo' : `Hasta ${deal.cantidad_escalas} escala(s)`}. Sin aerolíneas excluidas.</p>
                    </div>
                  </li>
                  <li>
                    <i class="ph ph-calendar-check" aria-hidden="true"></i>
                    <div>
                      <strong>Fechas dentro de tu ventana</strong>
                      <p>Ida el ${formatDate(deal.ida_fecha)}. Vuelta el ${formatDate(deal.vuelta_fecha)}.</p>
                    </div>
                  </li>
                  <li class="fh-positive">
                    <i class="ph ph-tag" aria-hidden="true"></i>
                    <div>
                      <strong>${isGold ? 'Califica como Oportunidad de Oro' : 'Aprobado por el radar'}</strong>
                      <p>Por debajo de tu umbral de US$ ${budgetMax}.</p>
                      <small style="color: var(--text-secondary); font-size: 0.74rem; display: flex; align-items: center; gap: 4px; margin-top: 3px;">
                        <i class="ph ph-chart-line-up"></i>
                        ${(() => {
                          // @ts-ignore
                          const insightsList = window.__SERVER_DATA__?.routeInsights || [];
                          const matched = insightsList.find((ins: any) => ins.ruta === deal.ida_origen_destino);
                          return (matched && matched.precio_promedio_7d) 
                            ? `Promedio últimos 7 días: US$ ${Math.round(matched.precio_promedio_7d)} · Mínimo: US$ ${Math.round(matched.minimo_historico || matched.precio_promedio_7d)}`
                            : 'Todavía no hay suficiente historial';
                        })()}
                      </small>
                    </div>
                  </li>
                </ol>
                <p class="fh-muted" style="font-size: 0.75rem; margin-top: 0.65rem; display: flex; align-items: center; gap: 4px;">
                  <i class="ph ph-info"></i> El precio final puede cambiar cuando abras la búsqueda en la aerolínea.
                </p>
              </details>

              <!-- 2. Alternativas del Strategist ("Qué cambia y cuánto cuesta") -->
              <details class="fh-panel">
                <summary><i class="ph ph-compass" style="color: var(--accent-color); margin-right: 0.35rem;"></i> Comparar fechas y alternativas</summary>
                <p class="fh-muted" style="font-size: 0.8rem; margin-bottom: 0.5rem;">Mismo destino, ${paxText} y condiciones comparables evaluadas por el Agente Estratega.</p>
                <ul class="fh-options">
                  <li class="fh-option">
                    <span class="fh-label">Búsqueda original</span>
                    <strong>Salir el ${formatDate(deal.ida_fecha)}</strong>
                    <span class="fh-price-small">${formatPrice(deal)}</span>
                    <small>Vuelta el ${formatDate(deal.vuelta_fecha)}</small>
                  </li>
                  <li class="fh-option fh-option--preferred">
                    <span class="fh-label">Alternativa de menor demanda</span>
                    <strong>Salir 2 días después</strong>
                    <span class="fh-price-small" style="color: var(--accent-color);">Flexibilidad sugerida</span>
                    <span class="fh-positive"><i class="ph ph-trend-down"></i> Consultar fechas adyacentes</span>
                    <small>Menor demanda estimada de asientos según estacionalidad</small>
                  </li>
                </ul>
                <details class="fh-panel" style="margin-top: 0.5rem; background: transparent; border: 1px dashed rgba(255,255,255,0.12);">
                  <summary style="font-size: 0.82rem; color: var(--text-secondary);"><i class="ph ph-airplane-in-flight" style="margin-right: 0.35rem;"></i> Explorar aeropuerto alternativo</summary>
                  <p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.4rem 0 0 0;">
                    <strong>Hub satélite:</strong> El Agente Estratega evalúa arribos a aeropuertos cercanos con conexión de tren de alta velocidad en el próximo ciclo.
                  </p>
                </details>
              </details>

              <!-- 3. Feedback: preferencias explícitas y reversibles -->
              <section class="fh-panel" style="margin-top: 0.75rem;" aria-labelledby="feedback-title-${deal.id}">
                <h4 id="feedback-title-${deal.id}" style="font-size: 0.86rem; font-weight: 600; color: #fff; margin: 0 0 0.4rem 0; display: flex; align-items: center; gap: 0.4rem;">
                  <i class="ph ph-thumbs-up-down" style="color: var(--accent-color);"></i> ¿Qué te pareció esta opción?
                </h4>
                <fieldset class="fh-feedback">
                  <legend class="fh-sr-only">Elegí el motivo</legend>
                  <label class="fh-choice">
                    <input type="radio" name="feedback-${deal.id}" value="layover_ok" onchange="window.enableFeedbackSave('${deal.id}')" />
                    <span><i class="ph ph-check"></i> Esta escala me sirve</span>
                  </label>
                  <label class="fh-choice">
                    <input type="radio" name="feedback-${deal.id}" value="layover_long" onchange="window.enableFeedbackSave('${deal.id}')" />
                    <span><i class="ph ph-clock"></i> La espera es demasiado larga</span>
                  </label>
                  <label class="fh-choice">
                    <input type="radio" name="feedback-${deal.id}" value="dates_unsuitable" onchange="window.enableFeedbackSave('${deal.id}')" />
                    <span><i class="ph ph-calendar-x"></i> Estas fechas no me sirven</span>
                  </label>
                </fieldset>
                
                <div class="fh-field">
                  <span>Aplicar a:</span>
                  <select id="scope-${deal.id}">
                    <option value="offer">Solo esta oferta</option>
                    <option value="radar">Preferencias de este radar</option>
                  </select>
                </div>

                <button type="button" class="fh-btn-save-pref" id="btn-save-${deal.id}" disabled onclick="window.saveDealFeedback('${deal.id}', '${currentAlert.id}', '${cName || currentAlert.destino}')">
                  <i class="ph ph-floppy-disk"></i> Guardar preferencia
                </button>
              </section>

            </article>
          `;
        };

        // 1. Tarjeta Principal (Vuelo más barato o destacado)
        const mainDeal = affordableDeals.length > 0 ? affordableDeals[0] : null;
        let mainDealCountry = '';
        if (mainDeal) {
          for (const [cName, codes] of Object.entries(countryCodes)) {
            if (codes.some(code => mainDeal.ida_origen_destino.includes(code))) {
              mainDealCountry = cName;
              break;
            }
          }
          html += renderFlightCard(mainDeal, alert, true, mainDealCountry);
        } else {
          html += `
            <div class="card main-deal" style="text-align: center; padding: 2.5rem;">
              <p style="color: var(--text-secondary); margin: 0; font-size: 1rem;">No encontramos vuelos que cumplan con tu presupuesto de US$ ${alert.presupuesto_max} y filtros actuales.</p>
            </div>
          `;
        }

        // Otros destinos: separar los que tienen oferta de los que siguen buscando
        let countriesWithDeals: any[] = [];
        let countriesSearching: any[] = [];

        // Priorizamos los países que el usuario eligió explícitamente
        let explicitCountries = (alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera')) 
            ? [...alert.paises] 
            : ['España', 'Reino Unido', 'Francia', 'Alemania'];
            
        let countriesToRender = [...explicitCountries];
        
        Object.keys(countryCodes).forEach(country => {
            const hasDeal = affordableDeals.some((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
            if (hasDeal && !countriesToRender.includes(country)) {
                countriesToRender.push(country);
            }
        });

        countriesToRender.forEach((country: string) => {
          let destDeal = null;
          if (countryCodes[country]) {
            destDeal = affordableDeals.find((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
          }

          const isDuplicateOfMain = mainDeal && destDeal && (
            destDeal.id === mainDeal.id || 
            (destDeal.ida_origen_destino === mainDeal.ida_origen_destino && destDeal.ida_fecha === mainDeal.ida_fecha && destDeal.precio_total_usd === mainDeal.precio_total_usd)
          );

          if (isDuplicateOfMain) {
            return;
          }

          if (destDeal) {
            countriesWithDeals.push({ country, deal: destDeal });
          } else {
            countriesSearching.push({ country });
          }
        });

        countriesWithDeals.sort((a, b) => a.deal.precio_total_usd - b.deal.precio_total_usd);

        // Países con ofertas encontradas (renderizados con el nuevo layout completo)
        if (countriesWithDeals.length > 0) {
          countriesWithDeals.forEach(({ country, deal }) => {
            html += renderFlightCard(deal, alert, false, country);
          });
        }

        // Países en búsqueda activa
        if (countriesSearching.length > 0) {
          const searchingTitle = mainDealCountry 
            ? `Rastreando el resto de ${alert.destino}` 
            : `Rastreando destinos en ${alert.destino}`;
            
          const searchingDesc = mainDealCountry
            ? `Además de la oferta encontrada para <strong>${mainDealCountry}</strong>, tu radar continúa buscando tarifas menores a <strong>US$ ${alert.presupuesto_max}</strong> en:`
            : `Actualmente no encontramos tarifas menores a <strong>US$ ${alert.presupuesto_max}</strong> para tus fechas. El radar sigue monitoreando activamente:`;

          html += `
            <div class="card searching-radar-card">
              <div class="searching-card-header">
                <div class="radar-scan-circle">
                  <i class="ph ph-broadcast"></i>
                </div>
                <h3 class="searching-header-title">${searchingTitle}</h3>
                <p class="searching-header-desc">${searchingDesc}</p>
              </div>

              <div class="searching-destinations-grid">
                ${countriesSearching.map(({ country }) => {
                  return `
                    <div class="searching-country-item">
                      <div class="searching-country-main">
                        <span class="country-iso-badge">${countryIsoCodes[country] || 'INT'}</span>
                        <strong class="searching-country-name">${country}</strong>
                      </div>
                      <span class="searching-country-note">Tarifas actuales superan <span class="nowrap-price">US$&nbsp;${alert.presupuesto_max}</span></span>
                      <span class="searching-status-badge">
                        <span class="pulse-mini-dot"></span>
                        <span>Buscando</span>
                      </span>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }

        grid.innerHTML = html;
        
        // Actualizar Radar Pulse en el sidebar
        const pulseName = document.getElementById('pulse-radar-name');
        if (pulseName) pulseName.textContent = alert.nombre || 'Mi Radar';

        const pulseTitle = document.getElementById('pulse-activity-title');
        if (pulseTitle) pulseTitle.textContent = `Revisando combinaciones hacia ${alert.destino}`;

        const lastScanStatus = document.getElementById('last-scan-status');
        if (lastScanStatus) {
          lastScanStatus.textContent = affordableDeals.length > 0
            ? `${affordableDeals.length} opciones en presupuesto`
            : `Rastreando opciones bajo US$ ${alert.presupuesto_max}`;
        }

        updateCountdown();
      };

      const initDashboard = async () => {
        // Handle OAuth Redirect processing if needed
        if (window.location.hash.includes('access_token')) {
          supabase.auth.onAuthStateChange(async (event) => {
            if (event === 'SIGNED_IN') {
              window.location.hash = ''; // Limpiar la URL visualmente
              await loadUserData();
            }
          });
        } else {
          await loadUserData();
        }
      };

      const loadUserData = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        const loader = document.getElementById('auth-loader');
        if (loader) loader.style.display = 'none';

        if (session) {
          // Actualizar UI para usuario logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if (loginBtn) loginBtn.style.display = 'none';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if (profileDropdown) profileDropdown.style.display = 'inline-block';
          
          const emailDisplay = document.getElementById('user-email-display');
          const username = session.user.email?.split('@')[0] || 'Usuario';
          if (emailDisplay) emailDisplay.innerText = username;

          const avatarBadge = document.getElementById('user-avatar-badge');
          if (avatarBadge && session.user) {
            const metadata = session.user.user_metadata || {};
            const avatarUrl = metadata.avatar_url || metadata.picture;
            
            if (avatarUrl) {
              avatarBadge.innerText = ''; // Quitar inicial
              avatarBadge.style.backgroundImage = `url('${avatarUrl}')`;
              avatarBadge.style.backgroundSize = 'cover';
              avatarBadge.style.backgroundPosition = 'center';
              avatarBadge.style.color = 'transparent'; // Por si acaso
              avatarBadge.style.border = '1px solid rgba(255,255,255,0.2)';
            } else if (session.user.email) {
              avatarBadge.innerText = session.user.email.charAt(0).toUpperCase();
            }
          }

          const dropdownUserInfo = document.getElementById('dropdown-user-info');
          if (dropdownUserInfo && session.user.email) {
            dropdownUserInfo.innerText = session.user.email;
          }

          // Escuchar logout
          const logoutBtn = document.getElementById('btn-logout');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              await supabase.auth.signOut();
              window.location.reload();
            });
          }

          // Lógica del Dropdown para Mobile (click toggle)
          const profileBtn = profileDropdown?.querySelector('.profile-btn');
          if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              profileDropdown.classList.toggle('active');
            });
            document.addEventListener('click', (e) => {
              if (!profileDropdown.contains(e.target)) {
                profileDropdown.classList.remove('active');
              }
            });
          }

          // Traemos todas las alertas configuradas del usuario
          const { data: alertsList } = await supabase
            .from('search_alerts')
            .select('*')
            .eq('user_id', session.user.id)
            .order('creado_en', { ascending: false });
            
          if (alertsList && alertsList.length > 0) {
            userAlerts = alertsList;
            activeAlertIndex = 0;
            // @ts-ignore
            window.currentActiveAlert = userAlerts[0];
            renderRadarTabs(userAlerts);
            renderDashboard(userAlerts[0]);
          } else {
            // Logueado pero sin alertas
            const empty = document.getElementById('empty-state');
            if(empty) empty.style.display = 'block';
          }
        } else {
          // No logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if(loginBtn) loginBtn.style.display = 'inline-block';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if(profileDropdown) profileDropdown.style.display = 'none';
          
          const empty = document.getElementById('empty-state');
          if(empty) empty.style.display = 'block';
        }
      };

      // Toast Notifications Helper
      const showToast = (message: string, type = 'success') => {
        let container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        const icon = type === 'success' ? '<i class="ph ph-check"></i>' : '<i class="ph ph-x"></i>';
        toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
        container.appendChild(toast);
        void toast.offsetWidth;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 350);
        }, 4000);
      };

      // Feedback Handlers
      // @ts-ignore
      window.enableFeedbackSave = (dealId: string) => {
        const btn = document.getElementById(`btn-save-${dealId}`) as HTMLButtonElement;
        if (btn) btn.disabled = false;
      };

      // @ts-ignore
      window.saveDealFeedback = async (dealId: string, alertId: string, destName: string) => {
        const selectedRadio = document.querySelector(`input[name="feedback-${dealId}"]:checked`) as HTMLInputElement;
        const scopeSelect = document.getElementById(`scope-${dealId}`) as HTMLSelectElement;
        const btn = document.getElementById(`btn-save-${dealId}`) as HTMLButtonElement;
        
        if (!selectedRadio) return;
        
        const reason = selectedRadio.value;
        const scope = scopeSelect ? scopeSelect.value : 'offer';
        
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = '<i class="ph ph-circle-notch" style="animation: spin 1s infinite;"></i> Guardando...';
        }

        const feedbackKey = `fh_feedback_${dealId}`;
        const feedbackData = { dealId, alertId, reason, scope, createdAt: new Date().toISOString() };
        try {
          localStorage.setItem(feedbackKey, JSON.stringify(feedbackData));
        } catch (e) {}

        setTimeout(() => {
          if (btn) {
            btn.innerHTML = '<i class="ph ph-check"></i> Preferencia guardada';
            btn.style.background = 'rgba(255,255,255,0.1)';
            btn.style.color = 'var(--text-secondary)';
          }
          
          const label = scope === 'radar' ? `Preferencias de radar para ${destName}` : 'esta oferta';
          showToast(`Preferencia guardada para ${label}.`, 'success');
        }, 350);
      };

      // Multi-Alerts Tabs Navigator
      let userAlerts: any[] = [];
      let activeAlertIndex = 0;

      const renderRadarTabs = (alerts: any[]) => {
        const tabsNav = document.getElementById('radar-tabs-nav');
        if (!tabsNav) return;

        if (!alerts || alerts.length === 0) {
          tabsNav.style.display = 'none';
          return;
        }

        tabsNav.style.display = 'flex';
        
        let tabsHtml = `<span class="radar-tabs-label"><i class="ph ph-radar"></i> Mis Búsquedas:</span>`;
        tabsHtml += alerts.map((a, idx) => {
          const isActive = idx === activeAlertIndex;
          const orig = (a.origen || 'EZE').split(',')[0].trim();
          const dest = a.destino || 'Europa';
          const label = a.nombre || `${orig} → ${dest}`;
          return `
            <button type="button" class="radar-tab-pill ${isActive ? 'is-active' : ''}" data-alert-index="${idx}" title="Ver radar: ${label}">
              ${isActive ? '<span class="tab-pulse"></span>' : '<i class="ph ph-airplane-tilt"></i>'}
              <span>${label}</span>
            </button>
          `;
        }).join('');

        tabsHtml += `
          <a href="/alertas" class="radar-tab-pill tab-add-new" title="Configurar o crear nuevas alertas">
            <i class="ph ph-plus-circle"></i>
            <span>+ Mis Alertas</span>
          </a>
        `;

        tabsNav.innerHTML = tabsHtml;

        tabsNav.querySelectorAll('button[data-alert-index]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-alert-index'));
            if (idx !== activeAlertIndex && userAlerts[idx]) {
              activeAlertIndex = idx;
              // @ts-ignore
              window.currentActiveAlert = userAlerts[activeAlertIndex];
              renderRadarTabs(userAlerts);
              renderDashboard(userAlerts[activeAlertIndex]);
            }
          });
        });
      };

      // Manejador de acciones para Anomalías (Aprobar / Descartar)
      // @ts-ignore
      window.handleAnomalyAction = async (dealId: string, action: 'aprobar' | 'rechazar', btn: HTMLElement) => {
        const card = document.getElementById(`anomaly-card-${dealId}`);
        const originalHtml = btn.innerHTML;
        btn.setAttribute('disabled', 'true');
        btn.innerHTML = `<i class="ph ph-spinner-gap" style="animation: spin 1s linear infinite;"></i> Procesando...`;

        try {
          const { data: { session } } = await supabase.auth.getSession();
          const headers: Record<string, string> = { 'Content-Type': 'application/json' };
          if (session?.access_token) {
            headers['Authorization'] = `Bearer ${session.access_token}`;
          }

          const res = await fetch('/api/anomaly-action', {
            method: 'POST',
            headers,
            body: JSON.stringify({ deal_id: dealId, action })
          });
          const result = await res.json();

          if (result.success) {
            showToast(result.message, 'success');
            if (card) {
              card.classList.add('anomaly-dismissing');
              setTimeout(() => {
                card.remove();
                const countEl = document.getElementById('anomalies-count');
                const sectionEl = document.getElementById('anomalies-section');
                const remaining = document.querySelectorAll('.anomaly-card');
                if (countEl) countEl.innerText = `${remaining.length}`;
                if (remaining.length === 0 && sectionEl) {
                  sectionEl.style.display = 'none';
                }
              }, 450);
            }

            // Actualizar el estado de deals en memoria sin recargar la página
            // @ts-ignore
            const pendingList = window.__SERVER_DATA__.pendingDeals || [];
            const idx = pendingList.findIndex((d: any) => d.id === dealId);
            if (idx !== -1) {
              const deal = pendingList.splice(idx, 1)[0];
              if (action === 'aprobar') {
                deal.estado_aprobacion = 'aprobado';
                // @ts-ignore
                if (!window.__SERVER_DATA__.approvedDeals) window.__SERVER_DATA__.approvedDeals = [];
                // @ts-ignore
                window.__SERVER_DATA__.approvedDeals.push(deal);
                // Re-render feed con el deal recién aprobado para el usuario
                // @ts-ignore
                if (window.currentActiveAlert) {
                  // @ts-ignore
                  setTimeout(() => renderDashboard(window.currentActiveAlert), 500);
                }
              }
            }
          } else {
            showToast('Error: ' + (result.error || 'No se pudo procesar'), 'error');
            btn.removeAttribute('disabled');
            btn.innerHTML = originalHtml;
          }
        } catch (err: any) {
          showToast('Error de comunicación con el servidor', 'error');
          btn.removeAttribute('disabled');
          btn.innerHTML = originalHtml;
        }
      };

      // Iniciar cuando el DOM esté listo
      window.addEventListener('DOMContentLoaded', initDashboard);
    </script>
  </body>
</html>
