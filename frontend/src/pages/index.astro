          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div class="card-header">🇫🇷 Francia</div>
            {franceDeal ? (
              <>
                <div class="card-route">{franceDeal.ida_origen_destino}</div>
                <div class="card-date">🗓 {formatDate(franceDeal.ida_fecha)} al {formatDate(franceDeal.vuelta_fecha)}</div>
                <div class="card-price" style="font-size: clamp(1.4rem, 4vw, 1.8rem); margin-top: auto; margin-bottom: 0.5rem;">{formatPrice(franceDeal)}</div>
