        </div>
      </header>

      <!-- Countdown de Vacaciones -->
      <div class="card countdown-card" style="margin-bottom: 1rem; background: linear-gradient(135deg, rgba(20, 20, 25, 0.9) 0%, rgba(30, 35, 45, 0.9) 100%); border-color: var(--accent-color); text-align: center;">
        <h2 style="margin-bottom: 0.5rem; color: var(--accent-color);">🌴 Vacaciones a Europa</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1rem;">16 de Abril al 1 de Mayo, 2027</p>
        <div id="countdown" style="display: flex; justify-content: center; gap: 1.5rem; font-size: 1.5rem; font-weight: bold;">
