      )}

      <div class="bento-grid">
        <!-- Deal Principal -->
        <div class="card main-deal">
          <div class="card-header">🔥 Vuelo Más Barato Absoluto</div>
          {mainDeal ? (
            <>
              <div class="card-route">{mainDeal.ida_origen_destino} <span style="opacity: 0.5; margin: 0 4px;">✈</span> {mainDeal.vuelta_origen_destino}</div>
