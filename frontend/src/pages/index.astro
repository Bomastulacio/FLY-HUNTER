---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// Habilitar SSR (Server-Side Rendering) en Vercel
export const prerender = false;

const yesterday = new Date();
yesterday.setDate(yesterday.getDate() - 1);

const { data: deals, error } = await supabase
  .from('flight_deals')
  .select('*')
  .gte('created_at', yesterday.toISOString())
  .order('precio_total_usd', { ascending: true });

const { data: insightsData } = await supabase.from('route_insights').select('*');
const routeInsights = insightsData || [];

// Procesar datos para enviarlos completos al cliente
const allDeals = deals || [];
const approvedDeals = allDeals.filter(d => d.estado_aprobacion === 'aprobado' || d.es_oportunidad_oro);
const pendingDeals = allDeals.filter(d => d.estado_aprobacion === 'pendiente' && d.es_anomalia);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Flight Hunter - Mi Radar</title>
    
    <!-- PWA Config -->
    <meta name="theme-color" content="#141419" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FlyHunter" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body>
    <!-- Auth Guard Loader -->
    <div id="auth-loader" style="position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem; animation: pulse 1.5s infinite;"><i class="ph ph-airplane-tilt"></i></div>
      <h3 style="color: var(--text-secondary); font-weight: normal;">Conectando al radar...</h3>
    </div>

    <!-- 3D Animated Background -->
    <div class="bg-3d-scene">
      <div class="radar-circles">
        <div class="circle c1"></div>
        <div class="circle c2"></div>
        <div class="circle c3"></div>
        <div class="circle c4"></div>
      </div>
      <div class="horizon-line"></div>
    </div>
    
    <main>
      <!-- Top Navigation -->
      <nav class="top-nav">
        <a href="/" class="top-nav-logo">
          <img src="/favicon.svg" alt="Fly Hunter Logo" width="32" height="32" style="border-radius: 8px;" />
          <span class="nav-logo-text">Flight Hunter</span>
        </a>
        <div class="top-nav-actions" id="desktop-user-actions">
          <a href="/alertas" class="btn btn-outline nav-alertas-btn desktop-only" title="Mis Alertas" aria-label="Mis Alertas">
            <i class="ph ph-sliders"></i>
            <span class="nav-alertas-text">Mis Alertas</span>
          </a>
          <a href="/login" id="nav-login-btn" class="btn btn-outline" style="display: none; padding: 0.4rem 1rem; margin-top: 0;"><i class="ph ph-key" style="margin-right: 0.5rem;"></i> Ingresar</a>
          
          <div id="user-profile-dropdown" class="profile-dropdown" style="display: none;">
            <button class="profile-btn" aria-label="Cuenta de usuario">
              <span class="avatar-badge" id="user-avatar-badge">U</span>
              <span class="user-email-label" id="user-email-display">usuario</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-content">
              <div id="dropdown-user-info" class="dropdown-user-header">usuario</div>
              <a href="/alertas"><i class="ph ph-sliders" style="margin-right: 0.5rem;"></i> Mis Alertas</a>
              <div class="dropdown-divider"></div>
              <a href="#" id="btn-logout" class="danger"><i class="ph ph-sign-out" style="margin-right: 0.5rem;"></i> Cerrar Sesión</a>
            </div>
          </div>
        </div>
      </nav>

      <!-- Hero -->
      <header id="main-hero">
        <h1>Encontramos las mejores tarifas desde Buenos Aires.</h1>
        <p id="hero-subtitle">Configura tu radar para empezar a recibir alertas.</p>
      </header>

      <!-- Radar Config Pill (Single tap target to edit preferences) -->
      <a href="/alertas" id="radar-summary-strip" class="radar-summary-pill" style="display: none;" title="Toca para editar preferencias de radar" aria-label="Editar preferencias de radar">
        <div class="summary-info">
          <i class="ph ph-sliders-horizontal summary-icon"></i>
          <span id="radar-summary-text" class="summary-text">Cargando radar...</span>
        </div>
        <span class="edit-pill-indicator">
          <i class="ph ph-pencil-simple"></i>
        </span>
      </a>

      <!-- CONTENEDOR DINÁMICO DEL RADAR -->
      <div id="dynamic-dashboard" style="display: none;">
        <!-- Status bar del próximo rastreo (delgada, fuera del bento-grid) -->
        <div id="countdown-strip-container" class="countdown-strip">
          <div class="countdown-strip-left">
            <span class="live-dot"></span>
            <span class="countdown-strip-label">Próximo rastreo para <strong id="cd-target-dest">Europa</strong>:</span>
          </div>
          <div class="countdown-strip-timer">
            <i class="ph ph-clock"></i>
            <span id="compact-cd-val">Calculando...</span>
          </div>
        </div>

        <div class="bento-grid" id="destinations-grid">
           <!-- Renderizado por JS -->
        </div>
      </div>
      
      <!-- EMPTY STATE (Sin Alerta) -->
      <div id="empty-state" style="display: none; text-align: center; margin: 4rem 0;">
        <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--text-secondary);"><i class="ph ph-broadcast"></i></div>
        <h2>Aún no tienes un radar activo</h2>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">Configura tus preferencias para que nuestra IA busque los mejores vuelos por vos.</p>
      </div>

    </main>



    <!-- Pasar datos del servidor al cliente -->
    <script is:inline define:vars={{ approvedDeals, pendingDeals }}>
      window.__SERVER_DATA__ = { approvedDeals, pendingDeals };
    </script>

    <script>
      import { supabase } from '../lib/supabase';

      const formatPrice = (deal: any) => {
        const price = deal.precio_original || deal.precio_total_usd;
        const currency = deal.moneda_original || 'USD';
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: currency, maximumFractionDigits: 0 }).format(price);
      };

      const formatDate = (dateStr: string) => {
        if (!dateStr) return '';
        const [y, m, d] = dateStr.split('-');
        const date = new Date(Number(y), Number(m) - 1, Number(d));
        return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short' }).format(date);
      };

      // Mapeo básico de países a códigos IATA para filtrar los vuelos del servidor
      const countryCodes: Record<string, string[]> = {
        "España": ["MAD", "BCN", "AGP", "VLC"],
        "Francia": ["CDG", "ORY", "NCE", "MRS"],
        "Italia": ["FCO", "MXP", "LIN", "NAP"],
        "Reino Unido": ["LHR", "LGW", "MAN", "EDI"],
        "Alemania": ["FRA", "MUC", "BER", "DUS"],
        "Portugal": ["LIS", "OPO"],
        "Países Bajos": ["AMS"],
        "Suiza": ["ZRH", "GVA"],
        "Grecia": ["ATH", "JMK"],
        "París": ["CDG", "ORY"],
        "Estados Unidos": ["JFK", "MIA", "LAX", "ORD", "SFO"],
        "Canadá": ["YYZ", "YVR", "YUL"],
        "México": ["MEX", "CUN", "GDL"],
        "Miami": ["MIA", "FLL"],
        "Nueva York": ["JFK", "LGA", "EWR"],
        "Brasil": ["GRU", "GIG", "BSB", "REC"],
        "Chile": ["SCL"],
        "Colombia": ["BOG", "MDE", "CTG"],
        "Perú": ["LIM", "CUZ"],
        "Uruguay": ["MVD"],
        "Río de Janeiro": ["GIG", "SDU"],
        "República Dominicana": ["PUJ", "SDQ"],
        "Cancún": ["CUN"],
        "Cuba": ["HAV"],
        "Costa Rica": ["SJO"],
        "Puerto Rico": ["SJU"],
        "Japón": ["NRT", "HND", "KIX"],
        "Tokio": ["NRT", "HND"],
        "Tailandia": ["BKK", "HKT"],
        "Corea del Sur": ["ICN"],
        "Emiratos Árabes": ["DXB"],
        "Australia": ["SYD", "MEL", "BNE"],
        "Nueva Zelanda": ["AKL"],
      };

      const countryFlags: Record<string, string> = {
        "España": "🇪🇸",
        "Francia": "🇫🇷",
        "Italia": "🇮🇹",
        "Reino Unido": "🇬🇧",
        "Alemania": "🇩🇪",
        "Portugal": "🇵🇹",
        "Países Bajos": "🇳🇱",
        "Suiza": "🇨🇭",
        "Grecia": "🇬🇷",
        "París": "🇫🇷",
        "Estados Unidos": "🇺🇸",
        "Canadá": "🇨🇦",
        "México": "🇲🇽",
        "Miami": "🇺🇸",
        "Nueva York": "🇺🇸",
        "Brasil": "🇧🇷",
        "Chile": "🇨🇱",
        "Colombia": "🇨🇴",
        "Perú": "🇵🇪",
        "Uruguay": "🇺🇾",
        "Río de Janeiro": "🇧🇷",
        "República Dominicana": "🇩🇴",
        "Cancún": "🇲🇽",
        "Cuba": "🇨🇺",
        "Costa Rica": "🇨🇷",
        "Puerto Rico": "🇵🇷",
        "Japón": "🇯🇵",
        "Tokio": "🇯🇵",
        "Tailandia": "🇹🇭",
        "Corea del Sur": "🇰🇷",
        "Emiratos Árabes": "🇦🇪",
        "Australia": "🇦🇺",
        "Nueva Zelanda": "🇳🇿"
      };

      // @ts-ignore
      const allDeals = window.__SERVER_DATA__.approvedDeals || [];
      let cdInterval: any;
      
      const renderDashboard = (alert: any) => {
        const dash = document.getElementById('dynamic-dashboard');
        if(dash) dash.style.display = 'block';
        
        const summaryStrip = document.getElementById('radar-summary-strip');
        if (summaryStrip) summaryStrip.style.display = 'flex';
        
        const mainHero = document.getElementById('main-hero');
        if (mainHero) mainHero.style.display = 'none';

        const summaryTextEl = document.getElementById('radar-summary-text');
        if (summaryTextEl) {
          const orig = "EZE";
          const dest = alert.destino || "Europa";
          const fechas = (alert.fecha_ida_min && alert.fecha_vuelta_max)
            ? `${formatDate(alert.fecha_ida_min)} - ${formatDate(alert.fecha_vuelta_max)}`
            : "";
          const escalas = `máx ${alert.escalas_max} esc.`;
          const excl = (alert.aerolineas_excluidas && alert.aerolineas_excluidas.length > 0 && alert.aerolineas_excluidas !== "Ninguna")
            ? `sin ${Array.isArray(alert.aerolineas_excluidas) ? alert.aerolineas_excluidas.join(', ') : alert.aerolineas_excluidas}`
            : "";
          const presup = `US$ ${alert.presupuesto_max}`;
          
          const parts = [
            `<strong>${orig} → ${dest}</strong>`,
            fechas,
            escalas,
            excl,
            `<strong>${presup}</strong>`
          ].filter(Boolean);
          
          summaryTextEl.innerHTML = parts.join(' · ');
        }

        // 2. Countdown logic para actualización del scraper
        if(cdInterval) clearInterval(cdInterval);
        
        const updateCountdown = () => {
          const now = new Date();
          let target = new Date(now);
          if (now.getHours() < 9) {
            target.setHours(9, 0, 0, 0);
          } else if (now.getHours() < 21) {
            target.setHours(21, 0, 0, 0);
          } else {
            target.setDate(target.getDate() + 1);
            target.setHours(9, 0, 0, 0);
          }
          const distance = target.getTime() - now.getTime();
          
          const timerVal = document.getElementById('compact-cd-val');
          if (!timerVal) return;
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((distance % (1000 * 60)) / 1000);
          
          timerVal.innerText = `${hours.toString().padStart(2, '0')}h ${mins.toString().padStart(2, '0')}m ${secs.toString().padStart(2, '0')}s`;
        };
        cdInterval = setInterval(updateCountdown, 1000);

        // 3. Destinations Grid
        const grid = document.getElementById('destinations-grid');
        if (!grid) return;
        
        let html = '';

        const cdDest = document.getElementById('cd-target-dest');
        if (cdDest) cdDest.innerText = alert.destino;

        // Filtramos TODOS los vuelos para que solo queden los que cumplen con el presupuesto y escalas
        const affordableDeals = allDeals.filter((d: any) => 
          d.precio_total_usd <= alert.presupuesto_max && 
          d.cantidad_escalas <= alert.escalas_max
        );
        
        // Tarjeta de Atención (Vuelo Anómalo)
        const pendingDeals = window.__SERVER_DATA__.pendingDeals || [];
        if (pendingDeals && pendingDeals.length > 0) {
          const pDeal = pendingDeals[0];
          html += `
            <div class="card" style="grid-column: 1 / -1; border: 1px solid var(--accent-color); background: rgba(159, 219, 22, 0.05); padding: 1.5rem;">
              <div class="card-header" style="font-size: 1.2rem;"><i class="ph-fill ph-warning" style="color: var(--accent-color); margin-right: 6px;"></i> Atención: Vuelo Anómalo Extremadamente Barato</div>
              <p style="margin: 0.5rem 0 1.5rem 0; color: var(--text-secondary); font-size: 1rem;">
                Encontramos una ganga por <strong>${formatPrice(pDeal)}</strong> que rompe levemente tus reglas. ¿Te sirve?
              </p>
              
              <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
                <div>
                  <div class="card-route" style="font-size: 1.1rem;">${pDeal.ida_origen_destino} <i class="ph ph-airplane-tilt" style="opacity: 0.5; margin: 0 4px;"></i> ${pDeal.vuelta_origen_destino}</div>
                  <div class="card-date" style="margin-bottom:0;"><i class="ph ph-calendar-blank"></i> ${formatDate(pDeal.ida_fecha)} al ${formatDate(pDeal.vuelta_fecha)}</div>
                </div>
                <div style="flex: 1;"></div>
                <div style="display: flex; gap: 0.75rem;">
                  <button class="btn btn-primary" onclick="alert('Se enviará webhook a GitHub para APROBAR.')" style="margin:0; padding: 0.6rem 1.2rem; font-size: 1rem;"><i class="ph ph-check" style="margin-right: 4px;"></i> Aprobar</button>
                  <button class="btn btn-outline" onclick="alert('Vuelo descartado.')" style="margin:0; padding: 0.6rem 1.2rem; font-size: 1rem;"><i class="ph ph-x" style="margin-right: 4px;"></i> No Aprobar</button>
                </div>
              </div>
            </div>
          `;
        }

        // Helper para construir el único botón de reserva hacia la plataforma ganadora
        const getDealButton = (deal: any, isPrimary = true) => {
          if (!deal) return '';
          const passengers = alert?.pasajeros || 2;
          const isDespegar = deal.fuente === 'despegar';
          const label = isDespegar ? 'Ver en Despegar' : 'Ver en Google Flights';

          let url = deal.link_reserva || '';
          if (!isDespegar) {
            // Si el link de Google Flights es genérico, armar query forzando los N pasajeros
            if (!url || url === 'https://google.com/flights' || url === 'https://www.google.com/travel/flights') {
              const routeParts = (deal.ida_origen_destino || 'EZE-BCN').split('-');
              const origin = (routeParts[0] || 'EZE').trim().toUpperCase();
              const dest = (routeParts[1] || 'BCN').trim().toUpperCase();
              if (deal.ida_fecha && deal.vuelta_fecha) {
                url = `https://www.google.com/travel/flights?q=Flights%20to%20${dest}%20from%20${origin}%20on%20${deal.ida_fecha}%20through%20${deal.vuelta_fecha}%20for%20${passengers}%20adults&curr=USD`;
              } else {
                url = 'https://www.google.com/travel/flights?curr=USD';
              }
            }
          }

          const btnClass = isPrimary ? 'btn btn-primary' : 'btn btn-outline';
          return `
            <a href="${url}" target="_blank" class="${btnClass}" style="align-self: flex-start; margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem;" title="${label} (${passengers} personas)">
              <span>${label}</span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
          `;
        };

        // 1. Tarjeta Principal (Vuelo más barato)
        const mainDeal = affordableDeals.length > 0 ? affordableDeals[0] : null;
        let mainDealCountry = '';
        if (mainDeal) {
          for (const [cName, codes] of Object.entries(countryCodes)) {
            if (codes.some(code => mainDeal.ida_origen_destino.includes(code))) {
              mainDealCountry = cName;
              break;
            }
          }
        }
        
        html += `
          <div class="card main-deal">
            <div class="main-deal-header">
              <div class="main-deal-tag">
                <i class="ph-fill ph-fire"></i>
                <span>Vuelo más barato</span>
              </div>
              ${mainDealCountry ? `
                <div class="main-deal-country">
                  <span class="country-flag">${countryFlags[mainDealCountry] || '📍'}</span>
                  <span>${mainDealCountry}</span>
                </div>
              ` : ''}
            </div>
            ${mainDeal ? `
              <div class="card-route">${mainDeal.ida_origen_destino} <i class="ph ph-airplane-tilt" style="opacity: 0.5; margin: 0 4px;"></i> ${mainDeal.vuelta_origen_destino}</div>
              <div class="card-date"><i class="ph ph-calendar-blank"></i> ${formatDate(mainDeal.ida_fecha)} al ${formatDate(mainDeal.vuelta_fecha)}</div>
              <div style="color: var(--text-secondary); margin-top: 0.5rem; font-weight: 500;">${mainDeal.aerolinea} • ${mainDeal.cantidad_escalas} escalas</div>
              <div class="card-price">${formatPrice(mainDeal)}</div>
              ${getDealButton(mainDeal, true)}
            ` : `
              <div style="margin: auto; color: var(--text-secondary); font-weight: 500;">No hay vuelos dentro de tu presupuesto y reglas.</div>
            `}
          </div>
        `;

        // Otros destinos: separar los que tienen oferta de los que siguen buscando
        let countriesWithDeals: any[] = [];
        let countriesSearching: any[] = [];

        // Priorizamos los países que el usuario eligió explícitamente
        let explicitCountries = (alert.paises && alert.paises.length > 0 && !alert.paises.includes('Cualquiera')) 
            ? [...alert.paises] 
            : ['España', 'Reino Unido', 'Francia', 'Alemania'];
            
        let countriesToRender = [...explicitCountries];
        
        Object.keys(countryCodes).forEach(country => {
            const hasDeal = affordableDeals.some((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
            if (hasDeal && !countriesToRender.includes(country)) {
                countriesToRender.push(country);
            }
        });

        countriesToRender.forEach((country: string) => {
          let destDeal = null;
          if (countryCodes[country]) {
            destDeal = affordableDeals.find((d: any) => countryCodes[country].some(code => d.ida_origen_destino.includes(code)));
          }

          const isDuplicateOfMain = mainDeal && destDeal && (
            destDeal.id === mainDeal.id || 
            (destDeal.ida_origen_destino === mainDeal.ida_origen_destino && destDeal.ida_fecha === mainDeal.ida_fecha && destDeal.precio_total_usd === mainDeal.precio_total_usd)
          );

          if (isDuplicateOfMain) {
            return;
          }

          if (destDeal) {
            countriesWithDeals.push({ country, deal: destDeal });
          } else {
            countriesSearching.push({ country });
          }
        });

        countriesWithDeals.sort((a, b) => a.deal.precio_total_usd - b.deal.precio_total_usd);

        // 1. Países con ofertas encontradas (como cards completas anteriores)
        if (countriesWithDeals.length > 0) {
          countriesWithDeals.forEach(({ country, deal }) => {
            const flag = countryFlags[country] || '📍';
            html += `
              <div class="card destination-flight-card">
                <div class="main-deal-header">
                  <div class="main-deal-country">
                    <span class="country-flag">${flag}</span>
                    <span>${country}</span>
                  </div>
                  <div class="main-deal-tag" style="color: var(--accent-color); background: rgba(209, 255, 76, 0.08); border-color: rgba(209, 255, 76, 0.25);">
                    <i class="ph ph-check-circle"></i>
                    <span>Oferta</span>
                  </div>
                </div>
                <div class="card-route">${deal.ida_origen_destino} <i class="ph ph-airplane-tilt" style="opacity: 0.5; margin: 0 4px;"></i> ${deal.vuelta_origen_destino || ''}</div>
                <div class="card-date"><i class="ph ph-calendar-blank"></i> ${formatDate(deal.ida_fecha)} al ${formatDate(deal.vuelta_fecha)}</div>
                <div style="color: var(--text-secondary); margin-top: 0.5rem; font-weight: 500; font-size: 0.9rem;">${deal.aerolinea} • ${deal.cantidad_escalas} escalas</div>
                <div class="card-price">${formatPrice(deal)}</div>
                ${getDealButton(deal, false)}
              </div>
            `;
          });
        }

        // 2. Países en búsqueda activa (explicando claramente que aún no hay vuelos bajo presupuesto)
        if (countriesSearching.length > 0) {
          const searchingTitle = mainDealCountry 
            ? `Rastreando el resto de ${alert.destino}` 
            : `Rastreando destinos en ${alert.destino}`;
            
          const searchingDesc = mainDealCountry
            ? `Además de la oferta encontrada para <strong>${mainDealCountry}</strong>, tu radar continúa buscando tarifas menores a <strong>US$ ${alert.presupuesto_max}</strong> en:`
            : `Actualmente no encontramos tarifas menores a <strong>US$ ${alert.presupuesto_max}</strong> para tus fechas. El radar sigue monitoreando activamente:`;

          html += `
            <div class="card searching-radar-card" style="grid-column: 1 / -1;">
              <div class="searching-card-header">
                <div class="radar-scan-circle">
                  <i class="ph ph-broadcast"></i>
                </div>
                <h3 class="searching-header-title">${searchingTitle}</h3>
                <p class="searching-header-desc">${searchingDesc}</p>
              </div>

              <div class="searching-destinations-grid">
                ${countriesSearching.map(({ country }) => {
                  const flag = countryFlags[country] || '📍';
                  return `
                    <div class="searching-country-item">
                      <div class="searching-country-main">
                        <span class="searching-flag">${flag}</span>
                        <strong class="searching-country-name">${country}</strong>
                      </div>
                      <span class="searching-country-note">Tarifas actuales superan US$ ${alert.presupuesto_max}</span>
                      <span class="searching-status-badge">
                        <span class="pulse-mini-dot"></span>
                        <span>Buscando</span>
                      </span>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }

        grid.innerHTML = html;
        updateCountdown();
      };

      const initDashboard = async () => {
        // Handle OAuth Redirect processing if needed
        if (window.location.hash.includes('access_token')) {
          supabase.auth.onAuthStateChange(async (event) => {
            if (event === 'SIGNED_IN') {
              window.location.hash = ''; // Limpiar la URL visualmente
              await loadUserData();
            }
          });
        } else {
          await loadUserData();
        }
      };

      const loadUserData = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        
        const loader = document.getElementById('auth-loader');
        if (loader) loader.style.display = 'none';

        if (session) {
          // Actualizar UI para usuario logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if (loginBtn) loginBtn.style.display = 'none';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if (profileDropdown) profileDropdown.style.display = 'inline-block';
          
          const emailDisplay = document.getElementById('user-email-display');
          const username = session.user.email?.split('@')[0] || 'Usuario';
          if (emailDisplay) emailDisplay.innerText = username;

          const avatarBadge = document.getElementById('user-avatar-badge');
          if (avatarBadge && session.user) {
            const metadata = session.user.user_metadata || {};
            const avatarUrl = metadata.avatar_url || metadata.picture;
            
            if (avatarUrl) {
              avatarBadge.innerText = ''; // Quitar inicial
              avatarBadge.style.backgroundImage = `url('${avatarUrl}')`;
              avatarBadge.style.backgroundSize = 'cover';
              avatarBadge.style.backgroundPosition = 'center';
              avatarBadge.style.color = 'transparent'; // Por si acaso
              avatarBadge.style.border = '1px solid rgba(255,255,255,0.2)';
            } else if (session.user.email) {
              avatarBadge.innerText = session.user.email.charAt(0).toUpperCase();
            }
          }

          const dropdownUserInfo = document.getElementById('dropdown-user-info');
          if (dropdownUserInfo && session.user.email) {
            dropdownUserInfo.innerText = session.user.email;
          }

          // Escuchar logout
          const logoutBtn = document.getElementById('btn-logout');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              await supabase.auth.signOut();
              window.location.reload();
            });
          }

          // Lógica del Dropdown para Mobile (click toggle)
          const profileBtn = profileDropdown?.querySelector('.profile-btn');
          if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              profileDropdown.classList.toggle('active');
            });
            document.addEventListener('click', (e) => {
              if (!profileDropdown.contains(e.target)) {
                profileDropdown.classList.remove('active');
              }
            });
          }

          // Traemos sus alertas
          const { data: alertData } = await supabase
            .from('search_alerts')
            .select('*')
            .eq('user_id', session.user.id)
            .single();
            
          if (alertData) {
            renderDashboard(alertData);
          } else {
            // Logueado pero sin alertas
            const empty = document.getElementById('empty-state');
            if(empty) empty.style.display = 'block';
          }
        } else {
          // No logueado
          const loginBtn = document.getElementById('nav-login-btn');
          if(loginBtn) loginBtn.style.display = 'inline-block';
          
          const profileDropdown = document.getElementById('user-profile-dropdown');
          if(profileDropdown) profileDropdown.style.display = 'none';
          
          const empty = document.getElementById('empty-state');
          if(empty) empty.style.display = 'block';
        }
      };

      // Iniciar cuando el DOM esté listo
      window.addEventListener('DOMContentLoaded', initDashboard);

    </script>
  </body>
</html>
