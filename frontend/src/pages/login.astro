---
import '../styles/global.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión - Flight Hunter</title>
  </head>
  <body style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
    <div class="bg-3d-scene">
      <div class="radar-circles">
        <div class="circle c1"></div>
        <div class="circle c2"></div>
      </div>
    </div>
    
    <div class="auth-container card">
      <div class="text-center mb-6">
        <div class="icon-container" style="margin: 0 auto 1rem auto; width: 64px; height: 64px;">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Iniciá sesión</h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem;">Accedé a tus alertas y preferencias guardadas.</p>
      </div>

      <form id="login-form" style="display: flex; flex-direction: column; gap: 1rem;">
        <button type="button" class="btn btn-outline" style="width: 100%; padding: 0.9rem; display: flex; gap: 0.5rem; justify-content: center;" onclick="window.loginWithGoogle(this)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2 6.42 2 12c0 5.59 4.39 10 10.1 10 5.9 0 11.1-4.34 11.1-11.53 0-1.3-.22-2.37-.22-2.37z"/></svg>
          Continuar con Google
        </button>
        
        <div style="display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0; opacity: 0.5;">
          <hr style="flex-grow: 1; border-color: rgba(255,255,255,0.1);" />
          <span style="font-size: 0.8rem;">O CON EMAIL</span>
          <hr style="flex-grow: 1; border-color: rgba(255,255,255,0.1);" />
        </div>

        <div class="input-wrapper">
          <input type="email" name="email" placeholder="tucorreo@ejemplo.com" required style="width: 100%;" />
        </div>
        <div class="input-wrapper">
          <input type="password" name="password" placeholder="Tu contraseña" required style="width: 100%;" />
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%; padding: 1rem; margin-top: 0.5rem;">
          Iniciar sesión
        </button>

        <div id="error-msg" style="color: var(--danger-color); font-size: 0.85rem; text-align: center; margin-top: 0.5rem; display: none;"></div>
      </form>

      <div style="text-align: center; margin-top: 2rem; font-size: 0.9rem; color: var(--text-secondary);">
        ¿No tenés cuenta? <a href="/registro" style="color: var(--accent-color); text-decoration: none;">Crear cuenta</a>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';
      
      const form = document.getElementById('login-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorMsg = document.getElementById('error-msg');

      // Expose to window for inline onclick
      (window as any).loginWithGoogle = async (btnElement: HTMLButtonElement) => {
        alert('Botón clickeado. Iniciando redirección a Google...');
        if(btnElement) {
          btnElement.disabled = true;
          btnElement.innerText = 'Redirigiendo...';
        }
        
        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: window.location.origin + '/alertas'
            }
          });
          if (error) {
            alert('Error de Supabase: ' + error.message);
            if (errorMsg) {
              errorMsg.innerText = error.message;
              errorMsg.style.display = 'block';
            }
            if(btnElement) {
              btnElement.disabled = false;
              btnElement.innerText = 'Continuar con Google';
            }
          }
        } catch (err) {
          alert('Excepción capturada: ' + err);
          if(btnElement) {
            btnElement.disabled = false;
            btnElement.innerText = 'Continuar con Google';
          }
        }
      };

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if(btn) {
            btn.disabled = true;
            btn.innerText = 'Cargando...';
          }
          if (errorMsg) errorMsg.style.display = 'none';

          const formData = new FormData(form);
          const email = formData.get('email') as string;
          const password = formData.get('password') as string;

          const { data, error } = await supabase.auth.signInWithPassword({
            email,
            password
          });

          if (error) {
            if (errorMsg) {
              errorMsg.innerText = error.message;
              errorMsg.style.display = 'block';
            }
            if(btn) {
              btn.disabled = false;
              btn.innerText = 'Iniciar sesión';
            }
          } else {
            window.location.href = '/alertas';
          }
        });
      }
    </script>
    
    <style>
      .auth-container {
        width: 100%;
        max-width: 420px;
        padding: 3rem 2rem;
        background: rgba(10, 10, 12, 0.85);
        border: 1px solid rgba(209, 255, 76, 0.2);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(209, 255, 76, 0.05);
        z-index: 10;
      }
      .text-center { text-align: center; }
      .mb-6 { margin-bottom: 2rem; }
      .input-wrapper {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--border-radius-sm);
      }
      .input-wrapper:focus-within {
        border-color: var(--accent-color);
      }
      input {
        background: transparent;
        border: none;
        color: white;
        padding: 1rem;
        font-family: inherit;
        outline: none;
      }
    </style>
  </body>
</html>
